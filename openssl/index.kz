// @koru/openssl — the definitive Koru client-TLS edition (scope v0)
//
// Wraps industry-standard OpenSSL (libssl/libcrypto) and lifts its most
// infamous footguns into Koru's type system:
//
//   1. VERIFIED BY DEFAULT. `connect` ALWAYS verifies the peer certificate
//      AND the hostname. There is no knob to turn verification off. The only
//      way to get an unverified channel is to type a *different, loudly named*
//      event — `connect.insecure` — so a skipped-verification connection can
//      never happen by omission. Decades of CVEs come from SSL_VERIFY_NONE and
//      forgotten SSL_set1_host; here the safe path is the only unmarked path.
//
//   2. HANDSHAKE IS A PHANTOM STATE. `connect` performs the full handshake
//      before it hands you an `open!` connection, so "read before handshake"
//      is unrepresentable. `shutdown` transitions the connection out of the
//      `open` state into `closing`, so "write after shutdown" does not compile.
//
//   3. THE FREE-CHAIN IS ONE PHANTOM OBLIGATION. SSL_free + SSL_CTX_free +
//      closing the socket are the classic OpenSSL leak trio. Here they are a
//      single `open!` obligation discharged by `close`. Forget it and the
//      build fails (KORU030) — you cannot leak an SSL context.
//
//   4. THE ERROR QUEUE IS LIFTED. OpenSSL's ERR_get_error() drain-the-queue
//      model becomes an honest `| err` branch on every fallible event, with
//      the queue drained and the first diagnostic surfaced. Never silent.
//
// Grounded in the koru phantom-type suite: obligation threading follows
// sqlite3's `next`/`col.*` (consume `<!open>`, re-emit `<open!>`); the
// open! -> closing! -> discharge chain follows tests/regression/.../330_051
// (`start-close` transition + `finalize` union `<!opened|closing>`).

~import std/build
~import std/deps

// System dependency: OpenSSL must be installed.
~std/deps:requires.system {
    "name": "openssl",
    "check": "pkg-config --modversion openssl",
    "brew": "openssl@3",
    "apt": "libssl-dev",
    "dnf": "openssl-devel",
    "pacman": "openssl",
    "apk": "openssl-dev"
}

// Build requirements: link against libssl + libcrypto, but only where a system
// OpenSSL can exist on the build host. Gate on the TARGET, not the host: a
// consumer importing this module unconditionally (orisha's pump) cross-compiles
// for x86_64-linux-musl, where Homebrew's macOS archive is "not an ELF file" and
// no musl libssl exists at all. TLS is lazily analyzed, so a program that never
// calls into this package still links clean for those targets; one that does
// fails loudly at the @cImport instead of at the linker with the wrong arch.
// (Verified this session against openssl@3 3.6.2 at /opt/homebrew/opt/openssl@3
// — see README "Proof of life".)
~std/build:requires {
    const res = target.result;
    if (res.os.tag == .macos) {
        // OpenSSL is keg-only on macOS/Homebrew — point the C importer and the
        // linker at the Homebrew prefix explicitly.
        if (res.cpu.arch == .aarch64) {
            exe.addIncludePath(.{ .cwd_relative = "/opt/homebrew/opt/openssl@3/include" });
            exe.addLibraryPath(.{ .cwd_relative = "/opt/homebrew/opt/openssl@3/lib" });
        } else {
            exe.addIncludePath(.{ .cwd_relative = "/usr/local/opt/openssl@3/include" });
            exe.addLibraryPath(.{ .cwd_relative = "/usr/local/opt/openssl@3/lib" });
        }
        exe.linkSystemLibrary("ssl");
        exe.linkSystemLibrary("crypto");
        exe.linkLibC();
    } else if (res.os.tag == .linux and res.abi != .musl) {
        // glibc linux with the dev package installed (std/deps:requires.system
        // asks for libssl-dev) resolves both from default search paths.
        exe.linkSystemLibrary("ssl");
        exe.linkSystemLibrary("crypto");
        exe.linkLibC();
    }
    // musl, freestanding, everything else: no system openssl can be linked —
    // emit nothing so non-TLS consumers still cross-compile.
}

const std = @import("std");
pub const c = @cImport({
    @cInclude("openssl/ssl.h");
    @cInclude("openssl/err.h");
    @cInclude("openssl/x509v3.h");
});

// ============================================================================
// Types
// ============================================================================

// One handle owns the entire free-chain: the SSL object, its SSL_CTX, and the
// underlying TCP socket fd. `close` frees all three; there is no way to free
// them piecemeal, so you cannot half-free an OpenSSL connection.
pub const Tls = struct {
    ssl: ?*c.SSL,
    ctx: ?*c.SSL_CTX,
    owns_ctx: bool,
    fd: c_int,
    allocator: std.mem.Allocator,
};

pub const ServerCtx = struct {
    ctx: ?*c.SSL_CTX,
    allocator: std.mem.Allocator,
};

pub const Error = struct {
    code: c_ulong,
    msg: []const u8,
};

// Drain OpenSSL's thread-local error queue and surface the FIRST diagnostic.
// This is the "error queue lifted" move: we never leave errors sitting in the
// queue to poison the next call, and we never swallow them silently.
fn drainErr(alloc: std.mem.Allocator, fallback: []const u8) Error {
    const code = c.ERR_get_error();
    if (code == 0) {
        return .{ .code = 0, .msg = alloc.dupe(u8, fallback) catch fallback };
    }
    var buf: [256]u8 = undefined;
    c.ERR_error_string_n(code, &buf, buf.len);
    const span = std.mem.sliceTo(&buf, 0);
    const duped = alloc.dupe(u8, span) catch fallback;
    // Drain the rest of the queue so a stale error can't leak into a later op.
    while (c.ERR_get_error() != 0) {}
    return .{ .code = code, .msg = duped };
}

// ============================================================================
// connect — VERIFIED client TLS. The only safe constructor.
// ============================================================================
// Performs: TCP connect, SSL_VERIFY_PEER, system CA trust store, SNI, strict
// hostname verification (SSL_set1_host), full handshake, and a belt-and-braces
// SSL_get_verify_result check. Any failure returns `err` loudly — it never
// hands back an unverified connection.

~[retain]pub tor connect { host: string, port: u16, allocator: ?std.mem.Allocator }
| ok *Tls<open!>
| err Error

~proc connect|zig {
    const alloc = allocator orelse std.heap.page_allocator;

    const host_z = alloc.dupeZ(u8, host) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory duplicating host" } };
    };
    defer alloc.free(host_z);

    // --- TCP ---
    const stream = std.net.tcpConnectToHost(alloc, host, port) catch {
        return .{ .err = .{ .code = 0, .msg = "TCP connection failed" } };
    };
    const fd: c_int = @intCast(stream.handle);
    errdefer std.posix.close(stream.handle);

    // --- SSL_CTX with mandatory verification ---
    const ctx = c.SSL_CTX_new(c.TLS_client_method());
    if (ctx == null) {
        return .{ .err = drainErr(alloc, "SSL_CTX_new failed") };
    }
    errdefer c.SSL_CTX_free(ctx);

    // Verify the peer certificate. This is the setting whose ABSENCE is the
    // classic CVE. It is not optional here.
    c.SSL_CTX_set_verify(ctx, c.SSL_VERIFY_PEER, null);
    if (c.SSL_CTX_set_default_verify_paths(ctx) != 1) {
        return .{ .err = drainErr(alloc, "could not load system CA trust store") };
    }
    _ = c.SSL_CTX_set_min_proto_version(ctx, c.TLS1_2_VERSION);

    // --- SSL object ---
    const ssl = c.SSL_new(ctx);
    if (ssl == null) {
        return .{ .err = drainErr(alloc, "SSL_new failed") };
    }
    errdefer c.SSL_free(ssl);

    _ = c.SSL_set_fd(ssl, fd);

    // SNI — tell the server which host we want (many servers require it).
    _ = c.SSL_set_tlsext_host_name(ssl, host_z.ptr);

    // Strict hostname check: the presented cert MUST match `host`. Forgetting
    // this is the OTHER half of the classic MITM footgun; it is mandatory here.
    if (c.SSL_set1_host(ssl, host_z.ptr) != 1) {
        return .{ .err = drainErr(alloc, "SSL_set1_host failed") };
    }

    // --- handshake (this is where the handshake phantom state is established) ---
    if (c.SSL_connect(ssl) != 1) {
        // Prefer the human-readable X509 verify reason when that is the cause.
        const vr = c.SSL_get_verify_result(ssl);
        if (vr != c.X509_V_OK) {
            const reason = c.X509_verify_cert_error_string(vr);
            return .{ .err = .{
                .code = @intCast(vr),
                .msg = alloc.dupe(u8, std.mem.span(reason)) catch "certificate verification failed",
            } };
        }
        return .{ .err = drainErr(alloc, "TLS handshake failed") };
    }

    // Belt and braces: SSL_set1_host already enforces this, but confirm.
    const vr = c.SSL_get_verify_result(ssl);
    if (vr != c.X509_V_OK) {
        const reason = c.X509_verify_cert_error_string(vr);
        return .{ .err = .{
            .code = @intCast(vr),
            .msg = alloc.dupe(u8, std.mem.span(reason)) catch "certificate verification failed",
        } };
    }

    const conn = alloc.create(Tls) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory allocating connection" } };
    };
    conn.* = .{ .ssl = ssl, .ctx = ctx, .owns_ctx = true, .fd = fd, .allocator = alloc };
    return .{ .ok = conn };
}

// ============================================================================
// connect.insecure — THE EXPLICITLY-NAMED UNSAFE ESCAPE HATCH.
// ============================================================================
// !!! DANGER !!! This skips certificate AND hostname verification. It exists so
// that "no verification" is something you must TYPE, in a name that screams what
// it is — never something that happens because you forgot a flag. Use it only
// for talking to a host with a self-signed cert you already trust out-of-band
// (e.g. local dev). Everything downstream (read/write/shutdown/close) is
// identical, so the ONLY signal of danger is at the call site — which is the
// point.

~[retain]pub tor connect.insecure { host: string, port: u16, allocator: ?std.mem.Allocator }
| ok *Tls<open!>
| err Error

~proc connect.insecure|zig {
    const alloc = allocator orelse std.heap.page_allocator;

    const host_z = alloc.dupeZ(u8, host) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory duplicating host" } };
    };
    defer alloc.free(host_z);

    const stream = std.net.tcpConnectToHost(alloc, host, port) catch {
        return .{ .err = .{ .code = 0, .msg = "TCP connection failed" } };
    };
    const fd: c_int = @intCast(stream.handle);
    errdefer std.posix.close(stream.handle);

    const ctx = c.SSL_CTX_new(c.TLS_client_method());
    if (ctx == null) {
        return .{ .err = drainErr(alloc, "SSL_CTX_new failed") };
    }
    errdefer c.SSL_CTX_free(ctx);

    // Deliberately NO verification. This is the whole (unsafe) point.
    c.SSL_CTX_set_verify(ctx, c.SSL_VERIFY_NONE, null);
    _ = c.SSL_CTX_set_min_proto_version(ctx, c.TLS1_2_VERSION);

    const ssl = c.SSL_new(ctx);
    if (ssl == null) {
        return .{ .err = drainErr(alloc, "SSL_new failed") };
    }
    errdefer c.SSL_free(ssl);

    _ = c.SSL_set_fd(ssl, fd);
    _ = c.SSL_set_tlsext_host_name(ssl, host_z.ptr);

    if (c.SSL_connect(ssl) != 1) {
        return .{ .err = drainErr(alloc, "TLS handshake failed") };
    }

    const conn = alloc.create(Tls) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory allocating connection" } };
    };
    conn.* = .{ .ssl = ssl, .ctx = ctx, .owns_ctx = true, .fd = fd, .allocator = alloc };
    return .{ .ok = conn };
}

// ============================================================================
// Server-side TLS — shared context + per-connection accept.
// ============================================================================

pub const LoadServerResult = union(enum) {
    ok: *ServerCtx,
    err: Error,
};

pub const SslAcceptResult = union(enum) {
    ok: *c.SSL,
    err: Error,
};

pub const SslFillResult = enum { more, idle, gone };

// Traffic secrets captured by the keylog callback, stashed per-SSL in
// ex_data slot 0 so a reactor can hand them to the kernel's TLS ULP —
// OpenSSL 3.0 never configures kTLS on a TLS 1.3 KeyUpdate (tls13_update_key
// calls derive_secret_key_and_iv directly, bypassing change_cipher_state),
// so post-handshake offload has to be installed by hand or not at all.
pub const KtlsSecrets = extern struct {
    have: u8 = 0, // bit0 = client_traffic_secret_0, bit1 = server
    c_len: u8 = 0,
    c_secret: [48]u8 = undefined,
    s_len: u8 = 0,
    s_secret: [48]u8 = undefined,
};

fn hexByte(hi: u8, lo: u8) u8 {
    return (std.fmt.charToDigit(hi, 16) catch return 0) * 16 +
        (std.fmt.charToDigit(lo, 16) catch return 0);
}

fn keylogCb(ssl: ?*const c.SSL, line_z: ?[*:0]const u8) callconv(.c) void {
    const s = ssl orelse return;
    const lz = line_z orelse return;
    const line = std.mem.span(lz);
    const ks_ptr = c.SSL_get_ex_data(@constCast(s), 0) orelse return;
    const ks: *KtlsSecrets = @ptrCast(@alignCast(ks_ptr));
    const is_client = std.mem.startsWith(u8, line, "CLIENT_TRAFFIC_SECRET_0 ");
    const is_server = std.mem.startsWith(u8, line, "SERVER_TRAFFIC_SECRET_0 ");
    if (!is_client and !is_server) return;
    // Last space-separated field is the hex secret.
    const sp = std.mem.lastIndexOfScalar(u8, line, ' ') orelse return;
    const hex = line[sp + 1 ..];
    const dst: *[48]u8 = if (is_client) &ks.c_secret else &ks.s_secret;
    const n = @min(hex.len / 2, 48);
    for (0..n) |i| dst[i] = hexByte(hex[i * 2], hex[i * 2 + 1]);
    if (is_client) {
        ks.c_len = @intCast(n);
        ks.have |= 1;
    } else {
        ks.s_len = @intCast(n);
        ks.have |= 2;
    }
}

pub fn loadServerCtx(alloc: std.mem.Allocator, cert_path: []const u8, key_path: []const u8) LoadServerResult {
    const cert_z = alloc.dupeZ(u8, cert_path) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory duplicating cert_path" } };
    };
    defer alloc.free(cert_z);
    const key_z = alloc.dupeZ(u8, key_path) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory duplicating key_path" } };
    };
    defer alloc.free(key_z);

    const ctx = c.SSL_CTX_new(c.TLS_server_method());
    if (ctx == null) {
        return .{ .err = drainErr(alloc, "SSL_CTX_new failed") };
    }
    errdefer c.SSL_CTX_free(ctx);
    c.SSL_CTX_set_keylog_callback(ctx, keylogCb);

    _ = c.SSL_CTX_set_min_proto_version(ctx, c.TLS1_3_VERSION);

    if (c.SSL_CTX_use_certificate_file(ctx, cert_z.ptr, c.SSL_FILETYPE_PEM) != 1) {
        return .{ .err = drainErr(alloc, "SSL_CTX_use_certificate_file failed") };
    }
    if (c.SSL_CTX_use_PrivateKey_file(ctx, key_z.ptr, c.SSL_FILETYPE_PEM) != 1) {
        return .{ .err = drainErr(alloc, "SSL_CTX_use_PrivateKey_file failed") };
    }
    if (c.SSL_CTX_check_private_key(ctx) != 1) {
        return .{ .err = drainErr(alloc, "certificate and private key do not match") };
    }

    const server = alloc.create(ServerCtx) catch {
        return .{ .err = .{ .code = 0, .msg = "out of memory allocating server context" } };
    };
    server.* = .{ .ctx = ctx, .allocator = alloc };
    return .{ .ok = server };
}

pub fn freeServerCtx(server: *ServerCtx) void {
    if (server.ctx) |ctx| {
        c.SSL_CTX_free(ctx);
        server.ctx = null;
    }
    server.allocator.destroy(server);
}

pub fn acceptServerSsl(server: *ServerCtx, fd: c_int, alloc: std.mem.Allocator) SslAcceptResult {
    const ssl_ptr = c.SSL_new(server.ctx);
    if (ssl_ptr == null) {
        return .{ .err = drainErr(alloc, "SSL_new failed") };
    }
    const ssl = ssl_ptr.?;
    errdefer c.SSL_free(ssl);

    _ = c.SSL_set_fd(ssl, fd);

    if (c.SSL_accept(ssl) != 1) {
        return .{ .err = drainErr(alloc, "SSL_accept failed") };
    }

    return .{ .ok = ssl };
}

// The non-blocking halves of acceptServerSsl, for a server whose handshake
// must not hold an accept loop: `acceptBegin` creates and binds the SSL on a
// descriptor that is about to go non-blocking, and `driveAccept` steps the
// handshake once per readiness event until it reports `ready`. The caller
// owns retry-on-WANT; a `failed` step leaves the error queue drained.
pub const AcceptStep = enum { ready, want_read, want_write, failed };

pub fn acceptBegin(server: *ServerCtx, fd: c_int, alloc: std.mem.Allocator) SslAcceptResult {
    const ssl_ptr = c.SSL_new(server.ctx);
    if (ssl_ptr == null) {
        return .{ .err = drainErr(alloc, "SSL_new failed") };
    }
    const ssl = ssl_ptr.?;
    errdefer c.SSL_free(ssl);

    // A queued-write caller retries a stalled SSL_write with a *moved* slice —
    // the queue may have grown between attempts. ACCEPT_MOVABLE_WRITE_BUFFER
    // makes that retry legal; ENABLE_PARTIAL_WRITE makes a short write a
    // `wrote(n)` instead of an error. SSL_set_mode is a macro over SSL_ctrl,
    // and the SSL_MODE_* spellings are L-suffixed #defines translate-c drops —
    // the values are frozen ABI (openssl/ssl.h).
    const SSL_CTRL_MODE: c_int = 33;
    const SSL_MODE_ENABLE_PARTIAL_WRITE: c_long = 0x00000001;
    const SSL_MODE_ACCEPT_MOVABLE_WRITE_BUFFER: c_long = 0x00000002;
    _ = c.SSL_ctrl(ssl, SSL_CTRL_MODE,
        SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVABLE_WRITE_BUFFER, null);

    _ = c.SSL_set_fd(ssl, fd);

    return .{ .ok = ssl };
}

pub fn driveAccept(ssl: *c.SSL) AcceptStep {
    const rc = c.SSL_accept(ssl);
    if (rc == 1) return .ready;
    return switch (c.SSL_get_error(ssl, rc)) {
        c.SSL_ERROR_WANT_READ => .want_read,
        c.SSL_ERROR_WANT_WRITE => .want_write,
        else => {
            while (c.ERR_get_error() != 0) {}
            return .failed;
        },
    };
}

pub fn releaseServerSsl(ssl: *c.SSL) void {
    freeKeys(ssl);
    _ = c.SSL_shutdown(ssl);
    c.SSL_free(ssl);
}

pub fn sslFill(ssl: *c.SSL, buf: []u8, alloc: std.mem.Allocator) SslFillResult {
    const rc = c.SSL_read(ssl, buf.ptr, @intCast(buf.len));
    if (rc > 0) return .more;
    const err_code = c.SSL_get_error(ssl, rc);
    return switch (err_code) {
        c.SSL_ERROR_WANT_READ, c.SSL_ERROR_WANT_WRITE => .idle,
        c.SSL_ERROR_ZERO_RETURN => .gone,
        else => {
            _ = drainErr(alloc, "SSL_read failed");
            return .gone;
        },
    };
}

pub fn sslWriteAll(ssl: *c.SSL, fd: c_int, data: []const u8, alloc: std.mem.Allocator) bool {
    var offset: usize = 0;
    while (offset < data.len) {
        const rc = c.SSL_write(ssl, data.ptr + offset, @intCast(data.len - offset));
        if (rc > 0) {
            offset += @intCast(rc);
            continue;
        }
        const err_code = c.SSL_get_error(ssl, rc);
        switch (err_code) {
            c.SSL_ERROR_WANT_READ, c.SSL_ERROR_WANT_WRITE => {
                var pfd = [_]std.posix.pollfd{.{ .fd = fd, .events = std.posix.POLL.IN | std.posix.POLL.OUT, .revents = 0 }};
                const ready = std.posix.poll(&pfd, 10_000) catch return false;
                if (ready == 0) return false;
                if (pfd[0].revents & (std.posix.POLL.ERR | std.posix.POLL.HUP | std.posix.POLL.NVAL) != 0) return false;
            },
            else => {
                _ = drainErr(alloc, "SSL_write failed");
                return false;
            },
        }
    }
    return true;
}

// One write attempt against a non-blocking socket — the counterpart of
// sslWriteAll for a reactor that must never wait. `wrote` carries the byte
// count consumed; `want_*` asks the caller to re-arm the matching readiness
// and call again. A `failed` step leaves the error queue drained.
pub const WriteStep = union(enum) {
    wrote: usize,
    want_read,
    want_write,
    failed,
};

pub fn sslWriteSome(ssl: *c.SSL, data: []const u8) WriteStep {
    const rc = c.SSL_write(ssl, data.ptr, @intCast(data.len));
    if (rc > 0) return .{ .wrote = @intCast(rc) };
    return switch (c.SSL_get_error(ssl, rc)) {
        c.SSL_ERROR_WANT_READ => .want_read,
        c.SSL_ERROR_WANT_WRITE => .want_write,
        else => {
            while (c.ERR_get_error() != 0) {}
            return .failed;
        },
    };
}

// ---------------------------------------------------------------------------
// Memory-BIO halves — TLS over a buffer, for reactors that own the wire
// ---------------------------------------------------------------------------
// A socket-fd SSL insists on reading and writing the descriptor itself, which
// a completion pump cannot honour: the ring's recv SQE already pulled the
// ciphertext off the wire. With two memory BIOs the transport is our buffer —
// ciphertext goes in through sslMemFeedIn, comes out through sslMemDrainOut —
// and the existing step functions work unchanged: driveAccept, sslWriteSome,
// and SSL_read's WANT_READ/WANT_WRITE now mean "feed rbio" / "drain wbio".
pub fn sslMemBegin(server: *ServerCtx, alloc: std.mem.Allocator) SslAcceptResult {
    const ssl_ptr = c.SSL_new(server.ctx);
    if (ssl_ptr == null) {
        return .{ .err = drainErr(alloc, "SSL_new failed") };
    }
    const ssl = ssl_ptr.?;
    errdefer c.SSL_free(ssl);

    const SSL_CTRL_MODE: c_int = 33;
    const SSL_MODE_ENABLE_PARTIAL_WRITE: c_long = 0x00000001;
    const SSL_MODE_ACCEPT_MOVABLE_WRITE_BUFFER: c_long = 0x00000002;
    _ = c.SSL_ctrl(ssl, SSL_CTRL_MODE,
        SSL_MODE_ENABLE_PARTIAL_WRITE | SSL_MODE_ACCEPT_MOVABLE_WRITE_BUFFER, null);

    const rbio = c.BIO_new(c.BIO_s_mem());
    const wbio = c.BIO_new(c.BIO_s_mem());
    if (rbio == null or wbio == null) {
        if (rbio != null) _ = c.BIO_free(rbio);
        if (wbio != null) _ = c.BIO_free(wbio);
        return .{ .err = drainErr(alloc, "BIO_new failed") };
    }
    // SSL_set_bio transfers ownership — SSL_free releases both.
    c.SSL_set_bio(ssl, rbio, wbio);
    // The ktls secrets slot: the keylog callback fills it during the
    // handshake; sslKtlsInstall reads it to hand the kernel the session.
    if (std.heap.c_allocator.create(KtlsSecrets) catch null) |ks| {
        ks.* = .{};
        _ = c.SSL_set_ex_data(ssl, 0, ks);
    }
    return .{ .ok = ssl };
}
pub fn sslMemFeedIn(ssl: *c.SSL, ciphertext: []const u8) void {
    if (ciphertext.len == 0) return;
    _ = c.BIO_write(c.SSL_get_rbio(ssl), ciphertext.ptr, @intCast(ciphertext.len));
}

// Ciphertext waiting in the write BIO — bytes owed to the wire through the
// caller's send path. BIO_ctrl_pending is a macro; BIO_CTRL_PENDING itself
// is a frozen numeric ABI (openssl/bio.h).
pub fn sslMemOutPending(ssl: *c.SSL) usize {
    const BIO_CTRL_PENDING: c_int = 10;
    const n = c.BIO_ctrl(c.SSL_get_wbio(ssl), BIO_CTRL_PENDING, 0, null);
    return if (n > 0) @intCast(n) else 0;
}

// Ciphertext out — drains the write BIO into dst, returns bytes moved.
pub fn sslMemDrainOut(ssl: *c.SSL, dst: []u8) usize {
    if (dst.len == 0) return 0;
    const n = c.BIO_read(c.SSL_get_wbio(ssl), dst.ptr, @intCast(dst.len));
    return if (n > 0) @intCast(n) else 0;
}

// Plaintext the cipher already decrypted and is holding internally — pull it
// without waiting for more ciphertext to arrive.
pub fn sslMemPendingIn(ssl: *c.SSL) usize {
    const n = c.SSL_pending(ssl);
    return if (n > 0) @intCast(n) else 0;
}

pub const MemReadStep = union(enum) { read: usize, want_read, gone, failed };

// Plaintext out — SSL_read over the memory rbio, with the byte count kept
// (sslFill's `more` drops it). `gone` is a clean peer close (ZERO_RETURN).
pub fn sslMemRead(ssl: *c.SSL, buf: []u8) MemReadStep {
    const rc = c.SSL_read(ssl, buf.ptr, @intCast(buf.len));
    if (rc > 0) return .{ .read = @intCast(rc) };
    return switch (c.SSL_get_error(ssl, rc)) {
        c.SSL_ERROR_WANT_READ, c.SSL_ERROR_WANT_WRITE => .want_read,
        c.SSL_ERROR_ZERO_RETURN => .gone,
        else => {
            while (c.ERR_get_error() != 0) {}
            return .failed;
        },
    };
}

// Emits close_notify into the write BIO — the caller drains and sends it.
pub fn sslMemShutdown(ssl: *c.SSL) void {
    _ = c.SSL_shutdown(ssl);
}

// ---------------------------------------------------------------------------
// Manual kTLS — handing a live TLS 1.3 session to the kernel's record layer
// ---------------------------------------------------------------------------
// OpenSSL 3.0 only configures SOL_TLS inside change_cipher_state, and TLS 1.3
// key rotation never reaches it (tls13_update_key derives the new key into
// the existing cipher context). The only moments ktls_configure_crypto runs
// are the handshake's cipher installs, which demand a socket BIO — and a
// socket-BIO handshake eats app data bundled with the client Finished. So the
// win is installed by hand instead: the SSL keeps its memory BIO pair, the
// keylog callback captured both traffic secrets, the pump counted the
// app-epoch records each direction already moved, and sslKtlsInstall hands
// the kernel the real cipher state. On success the SSL is freed without a
// shutdown and the conn is a plaintext ring conn — the kernel does AEAD.
//
// linux/tls.h is absent on macOS, so the uapi constants are written out —
// they are frozen ABI on Linux.
const SOL_TLS: c_int = 282;
const TCP_ULP: u32 = 31;
const KTLS_TX: u32 = 1;
const KTLS_RX: u32 = 2;
const TLS_1_3_KVER: u16 = 0x0304;
const CT_AES_GCM_128: u16 = 51;
const CT_AES_GCM_256: u16 = 52;
const CT_CHACHA20_POLY1305: u16 = 54;

// HKDF-Expand-Label (RFC 8446): out = HMAC(secret, len|label|ctx|0x01)[0..len]
// for out.len <= hashlen — always true here (32-byte keys, 12-byte ivs).
fn hkdfExpandLabel(comptime Hmac: type, secret: []const u8, label: []const u8, out: []u8) void {
    var info: [2 + 1 + 6 + 8 + 1]u8 = undefined;
    var n: usize = 0;
    std.mem.writeInt(u16, info[n..][0..2], @intCast(out.len), .big);
    n += 2;
    info[n] = @intCast(6 + label.len);
    n += 1;
    @memcpy(info[n .. n + 6], "tls13 ");
    n += 6;
    @memcpy(info[n .. n + label.len], label);
    n += label.len;
    info[n] = 0;
    n += 1;
    var mac = Hmac.init(secret);
    mac.update(info[0..n]);
    mac.update(&.{1});
    var t: [64]u8 = undefined;
    mac.final(t[0..Hmac.mac_length]);
    @memcpy(out, t[0..out.len]);
}

fn ktlsDeriveKeyIv(sha384: bool, secret: []const u8, key: []u8, iv: *[12]u8) void {
    const H256 = std.crypto.auth.hmac.sha2.HmacSha256;
    const H384 = std.crypto.auth.hmac.sha2.HmacSha384;
    if (sha384) {
        hkdfExpandLabel(H384, secret, "key", key);
        hkdfExpandLabel(H384, secret, "iv", iv);
    } else {
        hkdfExpandLabel(H256, secret, "key", key);
        hkdfExpandLabel(H256, secret, "iv", iv);
    }
}

// One direction's crypto state for the kernel: info header, then for GCM
// salt|iv|key|rec_seq matching tls12_crypto_info_aes_gcm_{128,256}, for
// chacha20-poly1305 iv[12]|key|rec_seq. rec_seq is big-endian — the count of
// records already moved in this epoch, so the kernel's nonce continues where
// userspace's stopped. Fields are laid out as the uapi struct, in buffer.
fn ktlsSetDir(fd: c_int, dir: u32, cipher: u16, key: []const u8, static_iv: *const [12]u8, seq: u64) bool {
    var buf: [64]u8 = std.mem.zeroes([64]u8);
    var len: usize = 4;
    switch (cipher) {
        CT_AES_GCM_128, CT_AES_GCM_256 => {
            @memcpy(buf[4..12], static_iv[4..12]);
            @memcpy(buf[12 .. 12 + key.len], key);
            const salt_off = 12 + key.len;
            @memcpy(buf[salt_off .. salt_off + 4], static_iv[0..4]);
            std.mem.writeInt(u64, buf[salt_off + 4 ..][0..8], seq, .big);
            len = salt_off + 12;
        },
        CT_CHACHA20_POLY1305 => {
            @memcpy(buf[4..16], static_iv);
            @memcpy(buf[16..48], key);
            std.mem.writeInt(u64, buf[48..56], seq, .big);
            len = 56;
        },
        else => return false,
    }
    std.mem.writeInt(u16, buf[0..2], TLS_1_3_KVER, .little);
    std.mem.writeInt(u16, buf[2..4], cipher, .little);
    return std.os.linux.setsockopt(fd, SOL_TLS, dir, &buf, @intCast(len)) == 0;
}

pub const KtlsInstall = enum { ok, pending, unsupported, fatal };

// Attach the TLS ULP and hand the kernel both directions' crypto. Ordering
// matters: a bare TCP_ULP attach leaves the socket byte-identical, and TLS_RX
// alone only changes what recv yields — so any failure before TLS_TX leaves
// the conn valid on its mem BIOs (caller keeps the software path); a failure
// AT TLS_TX is fatal to the conn — kernel-owned RX plus ciphertext writes
// would be two record layers on one socket.
pub fn sslKtlsInstall(ssl: *c.SSL, fd: c_int, rx_seq: u64, tx_seq: u64) KtlsInstall {
    if (c.SSL_version(ssl) != c.TLS1_3_VERSION) return .unsupported;
    const ks_ptr = c.SSL_get_ex_data(ssl, 0) orelse return .pending;
    const ks: *KtlsSecrets = @ptrCast(@alignCast(ks_ptr));
    if (ks.have != 3) return .pending;
    // A peer KeyUpdate already in flight rotates the keys these secrets
    // describe — installing them would hand the kernel a dead epoch. .pending
    // keeps the conn on its mem BIOs rather than guessing.
    if (c.SSL_get_key_update_type(ssl) != c.SSL_KEY_UPDATE_NONE) return .pending;
    const sess = c.SSL_get_session(ssl) orelse return .pending;
    const ciph = c.SSL_SESSION_get0_cipher(sess) orelse return .pending;
    const cipher: u16 = switch (c.SSL_CIPHER_get_cipher_nid(ciph)) {
        895 => CT_AES_GCM_128,       // NID_aes_128_gcm
        901 => CT_AES_GCM_256,       // NID_aes_256_gcm
        1018 => CT_CHACHA20_POLY1305, // NID_chacha20_poly1305
        else => return .unsupported,
    };
    const md = c.SSL_CIPHER_get_handshake_digest(ciph);
    const sha384 = md != null and c.EVP_MD_get_type(md) == 673; // NID_sha384
    const klen: usize = if (cipher == CT_AES_GCM_128) 16 else 32;
    var ckey: [32]u8 = undefined;
    var civ: [12]u8 = undefined;
    var skey: [32]u8 = undefined;
    var siv: [12]u8 = undefined;
    ktlsDeriveKeyIv(sha384, ks.c_secret[0..ks.c_len], ckey[0..klen], &civ);
    ktlsDeriveKeyIv(sha384, ks.s_secret[0..ks.s_len], skey[0..klen], &siv);

    if (std.os.linux.setsockopt(fd, std.os.linux.IPPROTO.TCP, TCP_ULP, "tls", 4) != 0)
        return .unsupported;
    if (!ktlsSetDir(fd, KTLS_RX, cipher, ckey[0..klen], &civ, rx_seq)) {
        // RX refused — no crypto was installed, the socket is still
        // ciphertext both ways and the mem-BIO conn carries on untouched.
        return .unsupported;
    }
    if (!ktlsSetDir(fd, KTLS_TX, cipher, skey[0..klen], &siv, tx_seq))
        return .fatal;
    return .ok;
}

// close_notify on a kernel-offloaded socket: a TLS_SET_RECORD_TYPE cmsg asks
// the kernel to wrap the alert in a real record under its own keys, so the
// peer sees a clean shutdown rather than a truncated session. cmsghdr is not
// in this Zig's linux std, so the uapi layout is written out: len:usize |
// level:i32 | type:i32 = 16 bytes, data aligned to usize.
pub fn sslKtlsCloseNotify(fd: c_int) void {
    const payload = [2]u8{ 1, 0 }; // warning, close_notify
    var iov = std.posix.iovec_const{ .base = &payload, .len = payload.len };
    // cmsghdr: len:usize | level:i32 | type:i32 — 16 bytes, already aligned.
    var cbuf: [24]u8 = std.mem.zeroes([24]u8);
    std.mem.writeInt(usize, cbuf[0..8], 17, .little);
    std.mem.writeInt(i32, cbuf[8..12], SOL_TLS, .little);
    std.mem.writeInt(i32, cbuf[12..16], 1, .little); // TLS_SET_RECORD_TYPE
    cbuf[16] = 21; // record type: alert
    const msg = std.posix.msghdr_const{
        .name = null,
        .namelen = 0,
        .iov = @ptrCast(&iov),
        .iovlen = 1,
        .control = &cbuf,
        .controllen = 17,
        .flags = 0,
    };
    _ = std.posix.sendmsg(fd, &msg, std.posix.MSG.NOSIGNAL) catch {};
}

// Per-direction kernel state after a SOL_TLS query:
//   set         — the kernel owns this direction
//   pending     — ULP attached but crypto not installed yet (EBUSY/TLS_BASE)
//   unsupported — the kernel has no TLS ULP at all (EOPNOTSUPP/ENOPROTOOPT)
pub const KtlsDirState = enum { set, pending, unsupported };

fn ktlsDir(fd: c_int, optname: c_int) KtlsDirState {
    var info: [64]u8 = undefined;
    var len: std.posix.socklen_t = @sizeOf(@TypeOf(info));
    const rc = std.os.linux.getsockopt(fd, SOL_TLS, optname, &info, &len);
    if (rc == 0) return .set;
    return switch (std.os.linux.E.init(rc)) {
        .BUSY, .NODEV => .pending,
        else => .unsupported,
    };
}

// Verification probe — the install only counts when the kernel owns BOTH
// directions: a half-installed session would put unencrypted records on the
// wire one way and ciphertext the ring thinks is plaintext the other.
pub const KtlsState = enum { offloaded, pending, unsupported };

pub fn sslKtlsState(fd: c_int) KtlsState {
    const tx = ktlsDir(fd, KTLS_TX);
    if (tx == .unsupported) return .unsupported;
    const rx = ktlsDir(fd, KTLS_RX);
    if (tx == .set and rx == .set) return .offloaded;
    return .pending;
}

// Free the SSL without SSL_shutdown — the caller that reached this point
// handed the record layer to the kernel (or is walking away from it), so an
// emitted close_notify would be a phantom alert mid-stream or dead weight on
// a conn about to close.
pub fn sslFreeNoShutdown(ssl: *c.SSL) void {
    freeKeys(ssl);
    c.SSL_free(ssl);
}

// The per-SSL KtlsSecrets slot. Freed with the SSL it rode on.
fn freeKeys(ssl: *c.SSL) void {
    if (c.SSL_get_ex_data(ssl, 0)) |p| {
        std.heap.c_allocator.destroy(@as(*KtlsSecrets, @ptrCast(@alignCast(p))));
        _ = c.SSL_set_ex_data(ssl, 0, null);
    }
}

// Records the cipher pulled off rbio but has not yet surfaced — buffered
// inside the record layer, invisible to SSL_pending, and unrecoverable the
// moment the kernel owns the socket (their sequence numbers belong to the
// kernel's count). Zero is a precondition for offload.
pub fn sslHasUnprocessed(ssl: *c.SSL) bool {
    return c.SSL_has_pending(ssl) != 0;
}

// Ciphertext queued inside the read BIO — must be zero before the kernel
// takes RX, because those bytes were already pulled off the wire.
pub fn sslRbioPending(ssl: *c.SSL) usize {
    const BIO_CTRL_PENDING: c_int = 10;
    const n = c.BIO_ctrl(c.SSL_get_rbio(ssl), BIO_CTRL_PENDING, 0, null);
    return if (n > 0) @intCast(n) else 0;
}

~[retain]pub tor server.load { cert_path: string, key_path: string, allocator: ?std.mem.Allocator }
| ok *ServerCtx<ready!>
| err Error

~proc server.load|zig {
    const alloc = allocator orelse std.heap.page_allocator;
    return loadServerCtx(alloc, cert_path, key_path);
}

~[retain]pub tor server.accept { server: *ServerCtx<!ready>, fd: c_int, allocator: ?std.mem.Allocator }
| ok *Tls<open!>
| err Error

~proc server.accept|zig {
    const alloc = allocator orelse std.heap.page_allocator;
    const accepted = acceptServerSsl(server, fd, alloc);
    switch (accepted) {
        .ok => |ssl| {
            const conn = alloc.create(Tls) catch {
                releaseServerSsl(ssl);
                return .{ .err = .{ .code = 0, .msg = "out of memory allocating connection" } };
            };
            conn.* = .{
                .ssl = ssl,
                .ctx = server.ctx,
                .owns_ctx = false,
                .fd = fd,
                .allocator = alloc,
            };
            return .{ .ok = conn };
        },
        .err => |e| return .{ .err = e },
    }
}

~[retain]pub tor server.close { server: *ServerCtx<!ready> }

~proc server.close|zig {
    freeServerCtx(server);
}

// ============================================================================
// write — requires `open`, so it cannot run before connect or after shutdown.
// ============================================================================

~[retain]pub tor write { conn: *Tls<!open>, data: string }
| ok { conn: *Tls<open!>, n: usize }
| err { conn: *Tls<open!>, code: c_ulong, msg: string }

~proc write|zig {
    if (data.len == 0) {
        return .{ .ok = .{ .conn = conn, .n = 0 } };
    }
    const rc = c.SSL_write(conn.ssl, data.ptr, @intCast(data.len));
    if (rc <= 0) {
        const e = drainErr(conn.allocator, "SSL_write failed");
        return .{ .err = .{ .conn = conn, .code = e.code, .msg = e.msg } };
    }
    return .{ .ok = .{ .conn = conn, .n = @intCast(rc) } };
}

// ============================================================================
// read — fills a caller-owned buffer (zero-copy). Requires `open`.
// ============================================================================
// `bytes` is a slice INTO the caller's `buf`, so there is nothing extra to free.

~[retain]pub tor read { conn: *Tls<!open>, buf: []u8 }
| data { conn: *Tls<open!>, bytes: []u8 }
| eof *Tls<open!>
| err { conn: *Tls<open!>, code: c_ulong, msg: string }

~proc read|zig {
    const rc = c.SSL_read(conn.ssl, buf.ptr, @intCast(buf.len));
    if (rc > 0) {
        return .{ .data = .{ .conn = conn, .bytes = buf[0..@intCast(rc)] } };
    }
    // rc <= 0: distinguish a clean peer close from a real error.
    const err_code = c.SSL_get_error(conn.ssl, rc);
    if (err_code == c.SSL_ERROR_ZERO_RETURN) {
        return .{ .eof = conn };
    }
    const e = drainErr(conn.allocator, "SSL_read failed");
    return .{ .err = .{ .conn = conn, .code = e.code, .msg = e.msg } };
}

// ============================================================================
// shutdown — clean TLS close_notify. Transitions `open` -> `closing`.
// ============================================================================
// After shutdown the connection is no longer `open`, so read/write no longer
// type-check against it. The free obligation rides along as `closing!` — you
// still MUST call `close`.

~[retain]pub tor shutdown { conn: *Tls<!open> }
| ok *Tls<closing!>
| err { conn: *Tls<closing!>, code: c_ulong, msg: string }

~proc shutdown|zig {
    const rc = c.SSL_shutdown(conn.ssl);
    if (rc < 0) {
        const e = drainErr(conn.allocator, "SSL_shutdown failed");
        return .{ .err = .{ .conn = conn, .code = e.code, .msg = e.msg } };
    }
    return .{ .ok = conn };
}

// ============================================================================
// close — discharges the free obligation. Frees SSL + SSL_CTX + socket.
// ============================================================================
// Accepts EITHER `open` (close without an explicit shutdown) OR `closing`
// (close after shutdown). Union input is grounded in 330_051's `finalize`.

~[retain]pub tor close { conn: *Tls<!open|closing> }

~proc close|zig {
    if (conn.ssl) |s| {
        // If the caller never called shutdown, send close_notify now so the
        // peer sees a clean teardown rather than a truncated connection.
        _ = c.SSL_shutdown(s);
        c.SSL_free(s);
    }
    if (conn.owns_ctx) {
        if (conn.ctx) |x| {
            c.SSL_CTX_free(x);
        }
    }
    if (conn.fd >= 0) {
        std.posix.close(@intCast(conn.fd));
    }
    conn.allocator.destroy(conn);
}
