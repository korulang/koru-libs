// @korulang/metal — a Metal window for Koru (v0: open + clear + close)
//
// Tracer for the native-app assimilation path: can Koru drive an
// Objective-C-flavored API with no shim? Everything below goes through
// objc_msgSend typed casts — no .m file, no wrapper library, just the
// ObjC runtime's C surface plus the few genuinely-C entry points
// (MTLCreateSystemDefaultDevice, CFStringCreateWithCString).
//
// The C footguns this compiles away, same bet as raylib/index.kz:
//
//   1. A window you open and never render is leaked Cocoa state — here it is
//      a KORU030 outright: `frames` is the only route to <active!>, and
//      <active!> is the only state window.close accepts.
//   2. Rendering without a drawable/descriptor bracket is a silent no-op —
//      here every draw call borrows a *Frame<frame> that only exists inside
//      the `! frame` effect-branch body: the pass descriptor lives between
//      the engine's bracket, so drawing outside a frame is not expressible.
//   3. Forgetting to end/present a command buffer hangs the swap — the
//      engine owns that bracket: endEncoding + presentDrawable + commit are
//      emitted around the frame body, so the user cannot omit them.
//
// House style follows raylib/index.kz and sqlite3/index.kz: `<state!>` grants
// an obligation, `<!state>` consumes it, bare `<state>` borrows.

~import std/build

~std/build:requires {
    exe.linkLibC();
    exe.linkFramework("Cocoa");
    exe.linkFramework("QuartzCore");
    exe.linkFramework("Metal");
    exe.linkFramework("CoreFoundation");
}

const std = @import("std");

const objc = @cImport({
    @cInclude("objc/runtime.h");
    @cInclude("objc/message.h");
    @cInclude("objc/objc.h");
});

const cf = @cImport({
    @cInclude("CoreFoundation/CoreFoundation.h");
});

const Id = ?*anyopaque;
const SEL = objc.SEL;

extern fn MTLCreateSystemDefaultDevice() callconv(.c) Id;
extern fn objc_autoreleasePoolPush() callconv(.c) *anyopaque;
extern fn objc_autoreleasePoolPop(*anyopaque) callconv(.c) void;
extern fn CGImageGetWidth(image: Id) callconv(.c) usize;
extern fn CGImageGetHeight(image: Id) callconv(.c) usize;
extern fn CGColorSpaceCreateDeviceRGB() callconv(.c) Id;
extern fn CGBitmapContextCreate(data: ?*anyopaque, width: usize, height: usize, bitsPerComponent: usize, bytesPerRow: usize, space: Id, bitmapInfo: u32) callconv(.c) Id;
extern fn CGBitmapContextGetData(c: Id) callconv(.c) ?*anyopaque;
extern fn CGContextDrawImage(c: Id, rect: NSRect, image: Id) callconv(.c) void;
extern var NSDefaultRunLoopMode: Id;
extern var NSWindowDidResizeNotification: Id;
extern var NSWindowWillStartLiveResizeNotification: Id;
extern var NSWindowDidEndLiveResizeNotification: Id;

const NSPoint = extern struct { x: f64, y: f64 };
const NSSize = extern struct { width: f64, height: f64 };
const NSRect = extern struct { origin: NSPoint, size: NSSize };
const MTLClearColor = extern struct { red: f64, green: f64, blue: f64, alpha: f64 };
const MTLOrigin = extern struct { x: u64, y: u64, z: u64 };
const MTLSize = extern struct { width: u64, height: u64, depth: u64 };
const MTLRegion = extern struct { origin: MTLOrigin, size: MTLSize };

// Vertex positions come from [[vertex_id]] — no vertex buffers needed for a
// static triangle. Compiled at runtime through newLibraryWithSource:.
// The rect pair takes per-draw RectParams through [[buffer(0)]] —
// setVertexBytes — and converts pixel-space origin+size to NDC against the
// drawable viewport carried on the Frame.
const msl_src: [:0]const u8 =
    \\#include <metal_stdlib>
    \\using namespace metal;
    \\vertex float4 vertex_main(uint vid [[vertex_id]]) {
    \\    float2 pos[3] = { float2(0.0, 0.7), float2(-0.7, -0.5), float2(0.7, -0.5) };
    \\    return float4(pos[vid], 0.0, 1.0);
    \\}
    \\fragment float4 fragment_main() {
    \\    return float4(1.0, 0.45, 0.1, 1.0);
    \\}
    \\struct RectParams {
    \\    float4 color;
    \\    float2 origin;
    \\    float2 size;
    \\    float2 viewport;
    \\};
    \\struct RectOut {
    \\    float4 pos [[position]];
    \\    float4 color;
    \\};
    \\vertex RectOut rect_vertex(uint vid [[vertex_id]], constant RectParams& p [[buffer(0)]]) {
    \\    float2 corners[4] = { float2(0.0,0.0), float2(1.0,0.0), float2(0.0,1.0), float2(1.0,1.0) };
    \\    float2 pix = p.origin + corners[vid] * p.size;
    \\    RectOut o;
    \\    o.pos = float4(pix.x / p.viewport.x * 2.0 - 1.0, 1.0 - pix.y / p.viewport.y * 2.0, 0.0, 1.0);
    \\    o.color = p.color;
    \\    return o;
    \\}
    \\fragment float4 rect_fragment(RectOut in [[stage_in]]) {
    \\    return in.color;
    \\}
    \\struct TexOut {
    \\    float4 pos [[position]];
    \\    float2 uv;
    \\};
    \\vertex TexOut tex_vertex(uint vid [[vertex_id]], constant RectParams& p [[buffer(0)]]) {
    \\    float2 corners[4] = { float2(0.0,0.0), float2(1.0,0.0), float2(0.0,1.0), float2(1.0,1.0) };
    \\    float2 pix = p.origin + corners[vid] * p.size;
    \\    TexOut o;
    \\    o.pos = float4(pix.x / p.viewport.x * 2.0 - 1.0, 1.0 - pix.y / p.viewport.y * 2.0, 0.0, 1.0);
    \\    o.uv = corners[vid];
    \\    return o;
    \\}
    \\fragment float4 tex_fragment(TexOut in [[stage_in]],
    \\                            texture2d<float> tex [[texture(0)]],
    \\                            sampler smp [[sampler(0)]]) {
    \\    return tex.sample(smp, in.uv);
    \\}
    \\// Instanced quads — ported from nanoui's shader.metal (MIT,
    \\// github.com/justrach/nanoui). One instance = one rounded rectangle
    \\// with optional border (kind 0) or a Gaussian-blurred shadow box
    \\// (kind 2); kinds 1 (atlas glyph) and 3 (atlas image) are reserved for
    \\// the text/image atlas work — unbound until it lands. Each instance
    \\// clips to its clip rect; clip corners may be rounded.
    \\struct Inst {
    \\    float4 rect;          // x, y, w, h in points
    \\    float4 color;         // straight alpha
    \\    float4 border_color;
    \\    float4 uv;            // atlas u0,v0,u1,v1 — reserved, unused today
    \\    float4 clip;          // x0, y0, x1, y1 — huge when unclipped
    \\    float radius;
    \\    float border_width;   // blur sigma for kind 2
    \\    float kind;
    \\    float clip_round;     // corners * 4096 + radius, 0 = square clip
    \\};
    \\struct InstOut {
    \\    float4 pos [[position]];
    \\    float2 local;
    \\    float2 world;
    \\    float2 uv;
    \\    uint inst [[flat]];
    \\};
    \\vertex InstOut inst_vertex(uint vid [[vertex_id]], uint iid [[instance_id]],
    \\                          constant Inst *insts [[buffer(0)]],
    \\                          constant float2 &vp [[buffer(1)]]) {
    \\    Inst i = insts[iid];
    \\    float2 corner = float2(vid & 1, vid >> 1);
    \\    // Shadows reach three standard deviations past their box.
    \\    float grow = i.kind == 2 ? i.border_width * 3.0 : 0.0;
    \\    float2 p = i.rect.xy - grow + corner * (i.rect.zw + 2.0 * grow);
    \\    InstOut o;
    \\    o.pos = float4(p.x / vp.x * 2.0 - 1.0, 1.0 - p.y / vp.y * 2.0, 0.0, 1.0);
    \\    o.local = p - i.rect.xy;
    \\    o.world = p;
    \\    o.uv = mix(i.uv.xy, i.uv.zw, corner);
    \\    o.inst = iid;
    \\    return o;
    \\}
    \\// Shadow coverage after Evan Wallace's fast rounded-rectangle shadows:
    \\// the box's coverage blurred by a Gaussian, exact along x with erf,
    \\// sampled four times along y.
    \\static float inst_gaussian(float x, float sigma) {
    \\    return exp(-(x * x) / (2.0 * sigma * sigma)) / (sqrt(2.0 * M_PI_F) * sigma);
    \\}
    \\static float2 inst_erf2(float2 x) {
    \\    float2 s = sign(x), a = abs(x);
    \\    x = 1.0 + (0.278393 + (0.230389 + 0.078108 * (a * a)) * a) * a;
    \\    x *= x;
    \\    return s - s / (x * x);
    \\}
    \\static float inst_blur_along_x(float x, float y, float sigma, float corner, float2 half_size) {
    \\    float delta = min(half_size.y - corner - abs(y), 0.0);
    \\    float curved = half_size.x - corner + sqrt(max(0.0, corner * corner - delta * delta));
    \\    float2 integral = 0.5 + 0.5 * inst_erf2((x + float2(-curved, curved)) * (sqrt(0.5) / sigma));
    \\    return integral.y - integral.x;
    \\}
    \\static float inst_shadow_alpha(float2 p, float2 half_size, float corner, float sigma) {
    \\    float low = p.y - half_size.y;
    \\    float high = p.y + half_size.y;
    \\    float start = clamp(-3.0 * sigma, low, high);
    \\    float end = clamp(3.0 * sigma, low, high);
    \\    float step = (end - start) / 4.0;
    \\    float y = start + step * 0.5;
    \\    float alpha = 0.0;
    \\    for (int k = 0; k < 4; k++) {
    \\        alpha += inst_blur_along_x(p.x, p.y - y, sigma, corner, half_size) * inst_gaussian(y, sigma) * step;
    \\        y += step;
    \\    }
    \\    return alpha;
    \\}
    \\static float inst_rounded_box(float2 p, float2 half_size, float r) {
    \\    float2 q = abs(p) - half_size + r;
    \\    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
    \\}
    \\fragment float4 inst_fragment(InstOut in [[stage_in]],
    \\                             constant Inst *insts [[buffer(0)]]) {
    \\    Inst i = insts[in.inst];
    \\    if (in.world.x < i.clip.x || in.world.y < i.clip.y || in.world.x > i.clip.z || in.world.y > i.clip.w)
    \\        discard_fragment();
    \\    float clip_cover = 1.0;
    \\    if (i.clip_round > 0.0) {
    \\        float corners = floor(i.clip_round / 4096.0);
    \\        float rad = i.clip_round - corners * 4096.0;
    \\        float2 ch = (i.clip.zw - i.clip.xy) * 0.5;
    \\        float2 q = in.world - i.clip.xy - ch;
    \\        float cd = inst_rounded_box(q, ch, min(rad, min(ch.x, ch.y)));
    \\        float caa = max(fwidth(cd), 0.0001) * 0.5;
    \\        uint bit = q.y < 0.0 ? (q.x < 0.0 ? 1u : 2u) : (q.x < 0.0 ? 8u : 4u);
    \\        if ((uint(corners) & bit) != 0u) clip_cover = 1.0 - smoothstep(-caa, caa, cd);
    \\        if (clip_cover <= 0.0) discard_fragment();
    \\    }
    \\    float2 half_size = i.rect.zw * 0.5;
    \\    float2 p = in.local - half_size;
    \\    float r = min(i.radius, min(half_size.x, half_size.y));
    \\    float d = inst_rounded_box(p, half_size, r);
    \\    if (i.kind == 2.0) {
    \\        float sigma = max(i.border_width, 0.25);
    \\        float a = inst_shadow_alpha(p, half_size, r, sigma) * i.color.a;
    \\        return float4(i.color.rgb, a) * clip_cover;
    \\    }
    \\    float aa = max(fwidth(d), 0.0001) * 0.5;
    \\    float coverage = 1.0 - smoothstep(-aa, aa, d);
    \\    float4 c = i.color;
    \\    if (i.border_width > 0.0 && i.border_color.a > 0.0) {
    \\        float inner = smoothstep(-i.border_width - aa, -i.border_width + aa, d);
    \\        c = mix(c, i.border_color, inner);
    \\    }
    \\    float a = c.a * coverage;
    \\    // Straight alpha out — the pipeline blends SourceAlpha/1-SourceAlpha.
    \\    return float4(c.rgb, a) * clip_cover;
    \\}
;

// Host twin of the MSL RectParams — float4 first so every float2 still
// lands on an 8-byte boundary (MSL constant-address-space layout rules).
const RectParams = extern struct {
    r: f32, g: f32, b: f32, a: f32,
    ox: f32, oy: f32, sw: f32, sh: f32,
    vw: f32, vh: f32,
};

// ============================================================================
// Instanced quads — ported from nanoui's gpu.zig + metal.zig (MIT,
// github.com/justrach/nanoui). Draw tors APPEND GpuInstances to the frame's
// list instead of drawing; the frame flushes once per run of instanced work
// (before any non-instanced draw, and at frame end) as a single instanced
// triangle-strip draw. Ordering against textured-quad draws is preserved by
// flushing first — image draws interleave exactly where they were called.
//
// The buffer is a fresh shared-storage MTLBuffer per flush, autoreleased:
// the encoder retains bound resources until the command buffer completes,
// so transient per-frame buffers are correct without a ring (nanoui's
// offscreen path does the same).
// ============================================================================

// Host twin of the MSL Inst — [4]f32 fields are 16-byte members either way,
// so offsets match the constant-address-space layout.
const GpuInstance = extern struct {
    rect: [4]f32,
    color: [4]f32,
    border_color: [4]f32,
    uv: [4]f32,
    clip: [4]f32,
    radius: f32,
    border_width: f32,
    kind: f32,
    clip_round: f32,
};

const inst_quad: f32 = 0;
const inst_shadow: f32 = 2;

// A clip rect as the shader reads it: x0,y0,x1,y1. An empty stack means the
// huge unclipped rect — cheap in the fragment (four compares).
const no_clip: [4]f32 = .{ -1e6, -1e6, 1e6, 1e6 };

fn curClip(f: *const Frame) [4]f32 {
    if (f.clip_depth == 0) return no_clip;
    return f.clip_stack[f.clip_depth - 1];
}

fn instPush(f: *Frame, inst: GpuInstance) void {
    f.insts.append(std.heap.page_allocator, inst) catch return;
}

// Records any pending instances through the instanced pipeline. Called by
// the frame's own end bracket and by any draw that is NOT an instance —
// so ordering against textured quads survives the split path.
fn instFlush(f: *Frame) void {
    if (f.insts.items.len == 0) return;
    const n = f.insts.items.len;
    const device = send(Id, f.layer, sel("device"));
    const buf = send3(
        Id, ?*const anyopaque, u64, u64,
        device, sel("newBufferWithBytes:length:options:"),
        f.insts.items.ptr, n * @sizeOf(GpuInstance), 0, // MTLStorageModeShared
    );
    if (buf == null) {
        f.insts.clearRetainingCapacity();
        return;
    }
    send(void, buf, sel("autorelease"));
    send1(void, Id, f.encoder, sel("setRenderPipelineState:"), f.pso_inst);
    send3(void, Id, u64, u64, f.encoder, sel("setVertexBuffer:offset:atIndex:"), buf, 0, 0);
    const vp: [2]f32 = .{ f.vp_w, f.vp_h };
    send3(void, *const [2]f32, u64, u64, f.encoder, sel("setVertexBytes:length:atIndex:"), &vp, 8, 1);
    send3(void, Id, u64, u64, f.encoder, sel("setFragmentBuffer:offset:atIndex:"), buf, 0, 0);
    send4(void, u64, u64, u64, u64, f.encoder, sel("drawPrimitives:vertexStart:vertexCount:instanceCount:"), 4, 0, 4, n);
    f.insts.clearRetainingCapacity();
}

fn sel(comptime name: [:0]const u8) SEL {
    return objc.sel_registerName(name);
}

fn cls(comptime name: [:0]const u8) Id {
    return @ptrCast(objc.objc_getClass(name));
}

// msgSend, arity-indexed. objc_msgSend is an unprototyped forwarder; the
// call's real signature is asserted per use by the fn-pointer cast.
fn send(comptime R: type, recv: Id, selector: SEL) R {
    return @as(*const fn (Id, SEL) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector);
}

fn send1(comptime R: type, comptime A1: type, recv: Id, selector: SEL, a1: A1) R {
    return @as(*const fn (Id, SEL, A1) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1);
}

fn send2(comptime R: type, comptime A1: type, comptime A2: type, recv: Id, selector: SEL, a1: A1, a2: A2) R {
    return @as(*const fn (Id, SEL, A1, A2) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2);
}

fn send3(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3) R {
    return @as(*const fn (Id, SEL, A1, A2, A3) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3);
}

fn send4(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, comptime A4: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3, a4: A4) R {
    return @as(*const fn (Id, SEL, A1, A2, A3, A4) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3, a4);
}

fn cstr(title: []const u8, buf: []u8) [*:0]const u8 {
    const n = @min(title.len, buf.len - 1);
    @memcpy(buf[0..n], title[0..n]);
    buf[n] = 0;
    return @ptrCast(buf.ptr);
}

// ============================================================================
// Event mailbox — the ObjC ↔ Koru boundary. ObjC IMPs are plain C functions:
// they cannot call Koru effect arms, so they PUSH events into this ring, and
// the `frames` proc — the splice site where arms are callable — drains it and
// dispatches. Mirror of vaxis's watcher-thread + wake-pipe decoupling.
// ============================================================================

pub const KeyData = struct {
    code: u16,
};

pub const MouseData = struct {
    x: f64,
    y: f64,
};

const Event = union(enum) {
    key_down: KeyData,
    mouse_down: MouseData,
};

var ev_buf: [64]Event = undefined;
var ev_head: usize = 0;
var ev_tail: usize = 0;

fn pushEvent(e: Event) void {
    const next = (ev_tail + 1) % ev_buf.len;
    if (next != ev_head) {
        ev_buf[ev_tail] = e;
        ev_tail = next;
    }
}

fn popEvent() ?Event {
    if (ev_head == ev_tail) return null;
    const e = ev_buf[ev_head];
    ev_head = (ev_head + 1) % ev_buf.len;
    return e;
}

var should_quit: bool = false;

// ============================================================================
// Automation verbs — synthesized input and framebuffer capture. First-class
// package surface, not test scaffolding: an agent driving a shared workspace
// injects through the SAME mailbox the ObjC IMPs write, and a snapshot reads
// the SAME drawable the encoder just presented. What automation sees and does
// is what a user's hands see and do — that equivalence is the point.
// ============================================================================

var snap_pending: bool = false;
var snap_path: [512]u8 = undefined;
var snap_len: usize = 0;

// Uncompressed 32-bit BMP — BGRA byte order, bottom-up rows. Zero deps; the
// caller converts to PNG with `sips` when it needs a portable artifact.
fn writeBmp(path: []const u8, px: []const u8, w: u32, h: u32) void {
    const row_bytes = w * 4;
    const img_bytes = row_bytes * h;
    const file_bytes = 14 + 40 + img_bytes;
    var f = std.fs.cwd().createFile(path, .{}) catch return;
    defer f.close();
    var hdr: [54]u8 = std.mem.zeroes([54]u8);
    hdr[0] = 'B';
    hdr[1] = 'M';
    std.mem.writeInt(u32, hdr[2..6], file_bytes, .little);
    std.mem.writeInt(u32, hdr[10..14], 54, .little);
    std.mem.writeInt(u32, hdr[14..18], 40, .little);
    std.mem.writeInt(u32, hdr[18..22], w, .little);
    std.mem.writeInt(u32, hdr[22..26], h, .little);
    std.mem.writeInt(u16, hdr[26..28], 1, .little);
    std.mem.writeInt(u16, hdr[28..30], 32, .little);
    std.mem.writeInt(u32, hdr[34..38], img_bytes, .little);
    f.writeAll(&hdr) catch return;
    var row: usize = h;
    while (row > 0) : (row -= 1) {
        const off = (row - 1) * row_bytes;
        f.writeAll(px[off .. off + row_bytes]) catch return;
    }
}

fn dumpDrawable(drawable: Id, win: *Window) void {
    const tex = send(Id, drawable, sel("texture"));
    const tw: u64 = send(u64, tex, sel("width"));
    const th: u64 = send(u64, tex, sel("height"));
    const len: usize = @intCast(tw * th * 4);

    // Drawable textures are storageModePrivate — CPU getBytes crashes in the
    // driver. Readback is a blit copy into a shared-mode MTLBuffer, synced.
    const device = send(Id, win.layer, sel("device"));
    const mtlbuf = send2(Id, usize, u64, device, sel("newBufferWithLength:options:"), len, 0);
    const cmd = send(Id, win.queue, sel("commandBuffer"));
    const blit = send(Id, cmd, sel("blitCommandEncoder"));
    const Blit = *const fn (Id, SEL, Id, u64, u64, MTLOrigin, MTLSize, Id, u64, u64, u64) callconv(.c) void;
    const copy: Blit = @ptrCast(&objc.objc_msgSend);
    copy(
        blit,
        sel("copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toBuffer:destinationOffset:destinationBytesPerRow:destinationBytesPerImage:"),
        tex, 0, 0,
        .{ .x = 0, .y = 0, .z = 0 },
        .{ .width = tw, .height = th, .depth = 1 },
        mtlbuf, 0, tw * 4, len,
    );
    send(void, blit, sel("endEncoding"));
    send(void, cmd, sel("commit"));
    send(void, cmd, sel("waitUntilCompleted"));

    const contents: [*]u8 = @ptrCast(send(?*anyopaque, mtlbuf, sel("contents")));
    writeBmp(snap_path[0..snap_len], contents[0..len], @intCast(tw), @intCast(th));
    send(void, mtlbuf, sel("release"));
}

~pub tor input.key { code: i64 }

~proc input.key|zig {
    pushEvent(.{ .key_down = .{ .code = @intCast(code) } });
}

~pub tor input.mouse { x: f64, y: f64 }

~proc input.mouse|zig {
    pushEvent(.{ .mouse_down = .{ .x = x, .y = y } });
}

// Live content size in points — locationInWindow's space. vp_w/vp_h are
// pinned at open for the shader viewport; hit-testing and layout-on-resize
// need the size NOW, not the size at open.
pub const Size = struct {
    w: f64,
    h: f64,
};

~pub tor window.size { win: *Window<opened|active> } -> koru/metal:Size

~proc window.size|zig {
    const cv = send(Id, win.win, sel("contentView"));
    const b = send(NSRect, cv, sel("bounds"));
    return .{ .w = @floatCast(b.size.width), .h = @floatCast(b.size.height) };
}

~pub tor window.snap { path: string }

~proc window.snap|zig {
    const n = @min(path.len, snap_path.len - 1);
    @memcpy(snap_path[0..n], path[0..n]);
    snap_len = n;
    snap_pending = true;
}

// ============================================================================
// Subclassing-as-a-library: KoruMetalView, an NSView subclass minted at
// runtime. IMPs are module fns that write the mailbox — they carry no Koru
// knowledge, just C ABI and a queue.
// ============================================================================

var view_class: ?objc.Class = null;

fn impKeyDown(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    const kc = send(u16, ev, sel("keyCode"));
    pushEvent(.{ .key_down = .{ .code = kc } });
}

fn impMouseDown(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    const p = send(NSPoint, ev, sel("locationInWindow"));
    pushEvent(.{ .mouse_down = .{ .x = p.x, .y = p.y } });
}

fn impAcceptsFirstResponder(recv: Id, _s: SEL) callconv(.c) bool {
    _ = recv;
    _ = _s;
    return true;
}

// Live-resize plumbing. During an edge drag AppKit runs a modal tracking
// loop INSIDE sendEvent: — the frames loop is parked in that call, so no
// ! frame fires and the compositor stretches a stale drawable until
// mouse-up. The view's setFrameSize: IMP and NSWindowDidResizeNotification
// both fire per drag step inside the tracking loop — liveDraw dedupes them
// by dims so each step renders once. The consumer's `! frame` body rides
// frame_cb, installed when `frames` starts; live_win is the open Window.
var live_win: ?*Window = null;
var frame_cb: ?*const fn (*Frame) void = null;
var in_live_resize: bool = false;

fn syncSurfaceSize(win: *Window) void {
    const cv = send(Id, win.win, sel("contentView"));
    const cb = send(NSRect, cv, sel("bounds"));
    win.vp_w = @floatCast(cb.size.width);
    win.vp_h = @floatCast(cb.size.height);
    const bs = send(f64, win.win, sel("backingScaleFactor"));
    // contentsScale must track the display's backingScaleFactor — left at
    // the 1.0 default, CA allocates bounds×1 backing and RESAMPLES our
    // 2× drawable into it: every edge re-rasterizes per frame = shimmer
    // on all static geometry, independent of layout.
    const cs = send(f64, win.layer, sel("contentsScale"));
    if (cs != bs) send1(void, f64, win.layer, sel("setContentsScale:"), bs);
    const cur = send(NSSize, win.layer, sel("drawableSize"));
    // Integral pixels only — fractional-point bounds during a live drag
    // would hand setDrawableSize sizes it truncates differently per step:
    // a ±1px compositor stretch oscillation.
    const dw = @round(cb.size.width * bs);
    const dh = @round(cb.size.height * bs);
    if (cur.width != dw or cur.height != dh) {
        send1(void, NSSize, win.layer, sel("setDrawableSize:"), .{ .width = dw, .height = dh });
    }
}

fn drawLiveFrame(win: *Window, cb: *const fn (*Frame) void) void {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const drawable = send(Id, win.layer, sel("nextDrawable"));
    if (drawable == null) return;
    const desc = send(Id, cls("MTLRenderPassDescriptor"), sel("renderPassDescriptor"));
    const atts = send(Id, desc, sel("colorAttachments"));
    const att = send1(Id, u64, atts, sel("objectAtIndexedSubscript:"), 0);
    const tex = send(Id, drawable, sel("texture"));
    send1(void, Id, att, sel("setTexture:"), tex);
    send1(void, u64, att, sel("setLoadAction:"), 2); // MTLLoadActionClear
    send1(void, u64, att, sel("setStoreAction:"), 1); // MTLStoreActionStore
    send1(void, MTLClearColor, att, sel("setClearColor:"), win.clear);
    const buf = send(Id, win.queue, sel("commandBuffer"));
    const enc = send1(Id, Id, buf, sel("renderCommandEncoderWithDescriptor:"), desc);
    send1(void, Id, enc, sel("setRenderPipelineState:"), win.pso);
    var f = Frame{ .encoder = enc, .layer = win.layer, .pso = win.pso, .pso_rect = win.pso_rect, .pso_tex = win.pso_tex, .pso_inst = win.pso_inst, .samp = win.samp, .vp_w = win.vp_w, .vp_h = win.vp_h, .insts = &win.insts, .clip_stack = undefined, .clip_depth = 0 };
    cb(&f);
    instFlush(&f);
    send(void, enc, sel("endEncoding"));
    if (in_live_resize) {
        // The Zed/gpui ordering under presentsWithTransaction: commit the
        // buffer, waitUntilScheduled bounds the wait to GPU scheduling (NOT
        // the commit), then the drawable presents directly — it lands with
        // the current CATransaction commit, atomically with the bounds
        // change. Unlike buf presentDrawable:+commit, the drawable is not
        // parked waiting on a commit that may never come — so the pool
        // doesn't drain and the event pump keeps breathing.
        send(void, buf, sel("commit"));
        send(void, buf, sel("waitUntilScheduled"));
        send(void, drawable, sel("present"));
    } else {
        send1(void, Id, buf, sel("presentDrawable:"), drawable);
        send(void, buf, sel("commit"));
    }
}

// One draw per dims change: setFrameSize: AND the resize notification
// both fire per drag step at the same dims — dedupe by vp size so each
// step renders once, not twice.
fn liveDraw(win: *Window, cb: *const fn (*Frame) void) void {
    syncSurfaceSize(win);
    if (win.lr_w == win.vp_w and win.lr_h == win.vp_h) return;
    win.lr_w = win.vp_w;
    win.lr_h = win.vp_h;
    drawLiveFrame(win, cb);
}

fn impWindowResized(recv: Id, _s: SEL, note: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = note;
    const win = live_win orelse return;
    const cb = frame_cb orelse return;
    liveDraw(win, cb);
}

// During a live drag AppKit calls setFrameSize: on the content view
// synchronously per step, while a CATransaction is still open — drawing
// here with the drawable.present() path puts our frame into the SAME
// commit as the bounds change (see drawLiveFrame), so no mismatched
// intermediate reaches the screen.
var orig_setFrameSize: ?*const fn (Id, SEL, NSSize) callconv(.c) void = null;

fn impSetFrameSize(recv: Id, _s: SEL, size: NSSize) callconv(.c) void {
    if (orig_setFrameSize) |orig| orig(recv, _s, size);
    const win = live_win orelse return;
    const cb = frame_cb orelse return;
    liveDraw(win, cb);
}

// Live-resize brackets: PwT goes ON only inside the drag, where every
// draw happens inside an open CATransaction — the drawable.present()
// path lands each frame atomically with the bounds commit. Outside the
// drag it stays OFF: transaction-pinned presents in the frames loop
// starve the drawable pool and throttle the event pump.
fn impLiveStart(recv: Id, _s: SEL, note: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = note;
    const win = live_win orelse return;
    in_live_resize = true;
    win.lr_w = -1;
    send1(void, bool, win.layer, sel("setPresentsWithTransaction:"), true);
}

// The flag drops AFTER the final draw so that frame lands in the closing
// transaction; from then on presents are immediate again and the pool
// can't be held hostage by queued transaction-pinned presents.
fn impLiveEnd(recv: Id, _s: SEL, note: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = note;
    const win = live_win orelse return;
    const cb = frame_cb orelse return;
    win.lr_w = -1;
    // Final frame BEFORE the flag drops: the end-of-resize transaction is
    // still open, so this present lands in the closing commit.
    liveDraw(win, cb);
    in_live_resize = false;
    send1(void, bool, win.layer, sel("setPresentsWithTransaction:"), false);
}

fn ensureViewClass() ?objc.Class {
    if (view_class) |c| return c;
    const sup: objc.Class = @ptrCast(cls("NSView"));
    const c = objc.objc_allocateClassPair(sup, "KoruMetalView", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("keyDown:"), @ptrCast(&impKeyDown), "v@:@");
    _ = objc.class_addMethod(c, sel("mouseDown:"), @ptrCast(&impMouseDown), "v@:@");
    _ = objc.class_addMethod(c, sel("acceptsFirstResponder"), @ptrCast(&impAcceptsFirstResponder), "B@:");
    _ = objc.class_addMethod(c, sel("windowResized:"), @ptrCast(&impWindowResized), "v@:@");
    const orig_ss = objc.class_getMethodImplementation(sup, sel("setFrameSize:"));
    orig_setFrameSize = @ptrCast(orig_ss);
    _ = objc.class_addMethod(c, sel("setFrameSize:"), @ptrCast(&impSetFrameSize), "v@:{_NSSize=dd}");
    _ = objc.class_addMethod(c, sel("liveStart:"), @ptrCast(&impLiveStart), "v@:@");
    _ = objc.class_addMethod(c, sel("liveEnd:"), @ptrCast(&impLiveEnd), "v@:@");
    objc.objc_registerClassPair(c);
    view_class = c;
    return c;
}

// ============================================================================
// Window lifecycle — the ASYMMETRIC model, same shape as raylib's:
//   opened — fresh from window.open, never rendered. No disposer accepts it.
//   active — has presented at least one frame.
//   closed — window.close accepts ONLY <!active>.
// ============================================================================

// The ObjC objects a live window needs every frame, carried in one token.
pub const Window = struct {
    app: Id,
    win: Id,
    layer: Id,
    queue: Id,
    pso: Id,
    pso_rect: Id,
    pso_tex: Id,
    pso_inst: Id,
    samp: Id,
    vp_w: f32,
    vp_h: f32,
    lr_w: f32,
    lr_h: f32,
    clear: MTLClearColor,
    insts: std.ArrayList(GpuInstance),
};

// A frame in flight — carries the LIVE render encoder, so draw calls inside
// `! frame` record into the pass the engine ends, presents and commits after
// the body returns. Pipeline states and viewport ride along so draw tors
// stay one-borrow calls. `insts` points at the window's persistent instance
// list; the clip stack is per-frame — a clip pushed inside `! frame` ends
// with the frame.
pub const Frame = struct {
    encoder: Id,
    layer: Id,
    pso: Id,
    pso_rect: Id,
    pso_tex: Id,
    pso_inst: Id,
    samp: Id,
    vp_w: f32,
    vp_h: f32,
    insts: *std.ArrayList(GpuInstance),
    clip_stack: [16][4]f32,
    clip_depth: u8,
};

~pub tor window.open { width: i32, height: i32, title: string }
| win *Window<opened!>
| err string

~proc window.open|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);

    const app = send(Id, cls("NSApplication"), sel("sharedApplication"));
    _ = send1(bool, i64, app, sel("setActivationPolicy:"), 0);
    send(void, app, sel("finishLaunching"));

    const rect = NSRect{
        .origin = .{ .x = 0, .y = 0 },
        .size = .{ .width = @floatFromInt(width), .height = @floatFromInt(height) },
    };
    const wobj = send4(
        Id, NSRect, u64, u64, bool,
        send(Id, cls("NSWindow"), sel("alloc")),
        sel("initWithContentRect:styleMask:backing:defer:"),
        rect, 15, 2, false,
    );
    if (wobj == null) {
        return .{ .err = "metal: NSWindow init failed" };
    }

    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    send1(void, Id, wobj, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));

    // Do NOT preserve content during live resize — "preserve" is the
    // window server stretching the previous surface onto each new step.
    // We draw a correctly-sized frame per step in setFrameSize:, so a
    // stretched intermediate is pure artifact: static geometry appears to
    // shift then snap back each step.
    send1(void, bool, wobj, sel("setPreservesContentDuringLiveResize:"), false);

    const device = MTLCreateSystemDefaultDevice();
    if (device == null) {
        return .{ .err = "metal: MTLCreateSystemDefaultDevice returned null" };
    }

    const layer = send(Id, cls("CAMetalLayer"), sel("layer"));
    send1(void, Id, layer, sel("setDevice:"), device);
    send1(void, u64, layer, sel("setPixelFormat:"), 80); // MTLPixelFormatBGRA8Unorm
    // presentsWithTransaction stays OFF here — it's flipped on only during
    // live resize (impLiveStart/impLiveEnd), where every draw sits inside
    // an open CATransaction. On at all times, presents outside a
    // transaction (the frames loop) queue for commits that rarely come:
    // the drawable pool fills, nextDrawable blocks, everything grays out.
    // contentsScale + drawableSize in BACKING pixels from the start —
    // drawableSize is pixels, not points.
    const bs0 = send(f64, wobj, sel("backingScaleFactor"));
    send1(void, f64, layer, sel("setContentsScale:"), bs0);
    // Pin content top-left: CAMetalLayer's default gravity stretches its
    // content to fill new bounds on every resize step — the "texture
    // resized then repainted" artifact. topLeft keeps static geometry
    // anchored; only the growing edge can show a brief unpainted strip.
    const grav = cf.CFStringCreateWithCString(null, "topLeft", cf.kCFStringEncodingUTF8);
    send1(void, Id, layer, sel("setContentsGravity:"), @as(Id, @ptrCast(@constCast(grav))));
    send1(void, NSSize, layer, sel("setDrawableSize:"), NSSize{
        .width = @as(f64, @floatFromInt(width)) * bs0,
        .height = @as(f64, @floatFromInt(height)) * bs0,
    });

    // Our own NSView subclass carries the responder IMPs — it becomes the
    // content view AND first responder so key/mouse events route to us.
    const view_cls = ensureViewClass() orelse {
        return .{ .err = "metal: KoruMetalView class registration failed" };
    };
    const view = send1(
        Id, NSRect,
        send(Id, @as(Id, @ptrCast(view_cls)), sel("alloc")),
        sel("initWithFrame:"), rect,
    );
    send1(void, Id, wobj, sel("setContentView:"), view);
    send1(void, Id, view, sel("setLayer:"), layer);
    send1(void, bool, view, sel("setWantsLayer:"), true);

    const queue = send(Id, device, sel("newCommandQueue"));
    if (queue == null) {
        return .{ .err = "metal: newCommandQueue returned null" };
    }

    // Pipeline: compile the MSL source, wire the descriptor, build the state.
    const srcStr = cf.CFStringCreateWithCString(null, msl_src.ptr, cf.kCFStringEncodingUTF8);
    var shaderErr: Id = null;
    const lib = send3(Id, Id, Id, *Id, device, sel("newLibraryWithSource:options:error:"), @as(Id, @ptrCast(@constCast(srcStr))), @as(Id, null), &shaderErr);
    if (lib == null) {
        if (shaderErr) |e| {
            const d = send(Id, e, sel("localizedDescription"));
            const cstr_ = cf.CFStringGetCStringPtr(@ptrCast(d), cf.kCFStringEncodingUTF8);
            if (cstr_ != null) std.debug.print("metal: shader error: {s}\n", .{std.mem.span(cstr_)});
        }
        return .{ .err = "metal: shader library compile failed" };
    }

    const vname = cf.CFStringCreateWithCString(null, "vertex_main", cf.kCFStringEncodingUTF8);
    const fname = cf.CFStringCreateWithCString(null, "fragment_main", cf.kCFStringEncodingUTF8);
    const vfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(vname))));
    const ffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(fname))));
    if (vfn == null or ffn == null) {
        return .{ .err = "metal: shader functions not found in library" };
    }

    const pdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, pdesc, sel("setVertexFunction:"), vfn);
    send1(void, Id, pdesc, sel("setFragmentFunction:"), ffn);
    const patts = send(Id, pdesc, sel("colorAttachments"));
    const patt = send1(Id, u64, patts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, patt, sel("setPixelFormat:"), 80); // match the layer

    var psoErr: Id = null;
    const pso = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), pdesc, &psoErr);
    if (pso == null) {
        return .{ .err = "metal: render pipeline state creation failed" };
    }

    // Second pipeline, same library: the rect pair. Per-draw params ride
    // through [[buffer(0)]] — no vertex buffer, no descriptor changes.
    const rvname = cf.CFStringCreateWithCString(null, "rect_vertex", cf.kCFStringEncodingUTF8);
    const rfname = cf.CFStringCreateWithCString(null, "rect_fragment", cf.kCFStringEncodingUTF8);
    const rvfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(rvname))));
    const rffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(rfname))));
    if (rvfn == null or rffn == null) {
        return .{ .err = "metal: rect shader functions not found in library" };
    }
    const rpdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, rpdesc, sel("setVertexFunction:"), rvfn);
    send1(void, Id, rpdesc, sel("setFragmentFunction:"), rffn);
    const rpatts = send(Id, rpdesc, sel("colorAttachments"));
    const rpatt = send1(Id, u64, rpatts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, rpatt, sel("setPixelFormat:"), 80);
    send1(void, bool, rpatt, sel("setBlendingEnabled:"), true);
    send1(void, u64, rpatt, sel("setSourceRGBBlendFactor:"), 4);
    send1(void, u64, rpatt, sel("setDestinationRGBBlendFactor:"), 5);
    send1(void, u64, rpatt, sel("setSourceAlphaBlendFactor:"), 1);
    send1(void, u64, rpatt, sel("setDestinationAlphaBlendFactor:"), 5);
    var rpsoErr: Id = null;
    const pso_rect = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), rpdesc, &rpsoErr);
    if (pso_rect == null) {
        return .{ .err = "metal: rect pipeline state creation failed" };
    }

    // Third pipeline: textured quads — same corner expansion plus uv out,
    // fragment samples [[texture(0)]] through [[sampler(0)]].
    const tvname = cf.CFStringCreateWithCString(null, "tex_vertex", cf.kCFStringEncodingUTF8);
    const tfname = cf.CFStringCreateWithCString(null, "tex_fragment", cf.kCFStringEncodingUTF8);
    const tvfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(tvname))));
    const tffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(tfname))));
    if (tvfn == null or tffn == null) {
        return .{ .err = "metal: tex shader functions not found in library" };
    }
    const tpdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, tpdesc, sel("setVertexFunction:"), tvfn);
    send1(void, Id, tpdesc, sel("setFragmentFunction:"), tffn);
    const tpatts = send(Id, tpdesc, sel("colorAttachments"));
    const tpatt = send1(Id, u64, tpatts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, tpatt, sel("setPixelFormat:"), 80);
    send1(void, bool, tpatt, sel("setBlendingEnabled:"), true);
    send1(void, u64, tpatt, sel("setSourceRGBBlendFactor:"), 4);
    send1(void, u64, tpatt, sel("setDestinationRGBBlendFactor:"), 5);
    send1(void, u64, tpatt, sel("setSourceAlphaBlendFactor:"), 1);
    send1(void, u64, tpatt, sel("setDestinationAlphaBlendFactor:"), 5);
    var tpsoErr: Id = null;
    const pso_tex = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), tpdesc, &tpsoErr);
    if (pso_tex == null) {
        return .{ .err = "metal: tex pipeline state creation failed" };
    }

    // Fourth pipeline: the instanced quad vocabulary — one instanced draw
    // per run of recorded instances (nanoui's model). Same blend as the
    // rect/tex pipelines.
    const ivname = cf.CFStringCreateWithCString(null, "inst_vertex", cf.kCFStringEncodingUTF8);
    const ifname = cf.CFStringCreateWithCString(null, "inst_fragment", cf.kCFStringEncodingUTF8);
    const ivfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(ivname))));
    const iffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(ifname))));
    if (ivfn == null or iffn == null) {
        return .{ .err = "metal: inst shader functions not found in library" };
    }
    const ipdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, ipdesc, sel("setVertexFunction:"), ivfn);
    send1(void, Id, ipdesc, sel("setFragmentFunction:"), iffn);
    const ipatts = send(Id, ipdesc, sel("colorAttachments"));
    const ipatt = send1(Id, u64, ipatts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, ipatt, sel("setPixelFormat:"), 80);
    send1(void, bool, ipatt, sel("setBlendingEnabled:"), true);
    send1(void, u64, ipatt, sel("setSourceRGBBlendFactor:"), 4);
    send1(void, u64, ipatt, sel("setDestinationRGBBlendFactor:"), 5);
    send1(void, u64, ipatt, sel("setSourceAlphaBlendFactor:"), 1);
    send1(void, u64, ipatt, sel("setDestinationAlphaBlendFactor:"), 5);
    var ipsoErr: Id = null;
    const pso_inst = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), ipdesc, &ipsoErr);
    if (pso_inst == null) {
        return .{ .err = "metal: inst pipeline state creation failed" };
    }

    // One shared sampler: linear min/mag, clamp — enough for image quads.
    const sdesc = send(Id, cls("MTLSamplerDescriptor"), sel("new"));
    send1(void, u64, sdesc, sel("setMinFilter:"), 1); // MTLSamplerMinMagFilterLinear
    send1(void, u64, sdesc, sel("setMagFilter:"), 1);
    const samp = send1(Id, Id, device, sel("newSamplerStateWithDescriptor:"), sdesc);
    if (samp == null) {
        return .{ .err = "metal: sampler state creation failed" };
    }

    // We own the release: releasedWhenClosed (default YES) frees wobj the
    // moment the user hits the close button, leaving win.win dangling for
    // the `| done` -> window.close path to message. NO keeps the object
    // alive; window.close sends the matching release.
    send1(void, bool, wobj, sel("setReleasedWhenClosed:"), false);

    send1(void, Id, wobj, sel("makeKeyAndOrderFront:"), @as(Id, null));
    send1(void, bool, app, sel("activateIgnoringOtherApps:"), true);
    // First responder only sticks on an onscreen window — ordering in resets
    // it, so this must come after orderFront, not beside content-view setup.
    _ = send1(bool, Id, wobj, sel("makeFirstResponder:"), view);

    // Resize notifications post per drag step of a live resize — the view
    // observes them so impWindowResized can draw inside AppKit's tracking
    // loop instead of stretching until mouse-up.
    const nc = send(Id, cls("NSNotificationCenter"), sel("defaultCenter"));
    send4(void, Id, SEL, Id, Id, nc, sel("addObserver:selector:name:object:"),
        view, sel("windowResized:"), NSWindowDidResizeNotification, wobj);
    send4(void, Id, SEL, Id, Id, nc, sel("addObserver:selector:name:object:"),
        view, sel("liveStart:"), NSWindowWillStartLiveResizeNotification, wobj);
    send4(void, Id, SEL, Id, Id, nc, sel("addObserver:selector:name:object:"),
        view, sel("liveEnd:"), NSWindowDidEndLiveResizeNotification, wobj);

    const w = std.heap.page_allocator.create(Window) catch @panic("metal: OOM allocating Window token");
    w.* = Window{
        .app = app,
        .win = wobj,
        .layer = layer,
        .queue = queue,
        .pso = pso,
        .pso_rect = pso_rect,
        .pso_tex = pso_tex,
        .pso_inst = pso_inst,
        .samp = samp,
        .vp_w = @floatFromInt(width),
        .vp_h = @floatFromInt(height),
        .lr_w = -1,
        .lr_h = -1,
        .clear = .{ .red = 0.1, .green = 0.1, .blue = 0.15, .alpha = 1.0 },
        .insts = .empty,
    };
    live_win = w;
    return .{ .win = w };
}

// The frame loop — the `opened -> active` transition, same bracket shape as
// raylib's: the engine acquires the drawable, builds the render pass, hands
// the user a *Frame borrow for pass configuration, then ends, presents and
// commits around the body. `! frame` fires once per frame; `count` bounds
// the loop so tests halt.
//
// Callbacks as effect branches, the vaxis shape: ObjC IMPs cannot call Koru
// arms, so they push into the mailbox while sendEvent runs; the loop drains
// it here — the splice site where arms are callable — and fires the
// optional `! ?` arms. Unbound optional arms are generated no-ops. `! close`
// fires when the window closed (isVisible polled — no delegate needed; the
// default close button just closes); quit() breaks the loop.
~pub tor frames { win: *Window<!opened|!active>, count: ?i32 }
! frame *Frame<frame!>
! ?key-down koru/metal:KeyData
! ?mouse-down koru/metal:MouseData
! ?close
| done *Window<active!>

~proc frames|zig {
    const __cap = @as(?i32, count) orelse 2147483647;
    // Live-resize path: during an edge drag this loop is parked inside
    // sendEvent:, so the windowResized: IMP draws through frame_cb instead.
    $mod.frame_cb = frame;
    var i: i32 = 0;
    while (i < __cap) : (i += 1) {
        const pool = $mod.objc_autoreleasePoolPush();
        defer $mod.objc_autoreleasePoolPop(pool);

        // Pump pending AppKit events so the window tracks, closes, repaints.
        // sendEvent dispatches to our view's IMPs, which push the mailbox.
        while (true) {
            const ev = $mod.send4(
                $mod.Id, u64, $mod.Id, $mod.Id, bool,
                win.app,
                $mod.sel("nextEventMatchingMask:untilDate:inMode:dequeue:"),
                $mod.std.math.maxInt(u64), @as($mod.Id, null), $mod.NSDefaultRunLoopMode, true,
            );
            if (ev == null) break;
            $mod.send1(void, $mod.Id, win.app, $mod.sel("sendEvent:"), ev);
        }
        $mod.send(void, win.app, $mod.sel("updateWindows"));

        // Mailbox -> effect arms, the dispatch site.
        while ($mod.popEvent()) |mev| {
            switch (mev) {
                .key_down => |k| key_down(k),
                .mouse_down => |m| mouse_down(m),
            }
        }
        if ($mod.should_quit) break;
        if (!$mod.send(bool, win.win, $mod.sel("isVisible"))) {
            close();
            break;
        }

        // Track the live size every iteration: vp is layout points so the
        // shader maps 1:1 (no stretch), drawableSize is pixels so the
        // layer reallocates instead of letting the compositor scale a
        // stale surface. Both derive from contentView bounds.
        $mod.syncSurfaceSize(win);

        const drawable = $mod.send($mod.Id, win.layer, $mod.sel("nextDrawable"));
        if (drawable == null) break; // window closed or invisible

        const desc = $mod.send($mod.Id, $mod.cls("MTLRenderPassDescriptor"), $mod.sel("renderPassDescriptor"));
        const atts = $mod.send($mod.Id, desc, $mod.sel("colorAttachments"));
        const att = $mod.send1($mod.Id, u64, atts, $mod.sel("objectAtIndexedSubscript:"), 0);
        const tex = $mod.send($mod.Id, drawable, $mod.sel("texture"));
        $mod.send1(void, $mod.Id, att, $mod.sel("setTexture:"), tex);
        $mod.send1(void, u64, att, $mod.sel("setLoadAction:"), 2); // MTLLoadActionClear
        $mod.send1(void, u64, att, $mod.sel("setStoreAction:"), 1); // MTLStoreActionStore
        $mod.send1(void, $mod.MTLClearColor, att, $mod.sel("setClearColor:"), win.clear);

        // The encoder exists BEFORE the frame body: the `! frame` body records
        // draws into a live pass, then the engine ends, presents, commits.
        const buf = $mod.send($mod.Id, win.queue, $mod.sel("commandBuffer"));
        const enc = $mod.send1($mod.Id, $mod.Id, buf, $mod.sel("renderCommandEncoderWithDescriptor:"), desc);
        $mod.send1(void, $mod.Id, enc, $mod.sel("setRenderPipelineState:"), win.pso);

        var __f = $mod.Frame{ .encoder = enc, .layer = win.layer, .pso = win.pso, .pso_rect = win.pso_rect, .pso_tex = win.pso_tex, .pso_inst = win.pso_inst, .samp = win.samp, .vp_w = win.vp_w, .vp_h = win.vp_h, .insts = &win.insts, .clip_stack = undefined, .clip_depth = 0 };
        frame(&__f);

        $mod.instFlush(&__f);
        $mod.send(void, enc, $mod.sel("endEncoding"));
        $mod.send1(void, $mod.Id, buf, $mod.sel("presentDrawable:"), drawable);
        $mod.send(void, buf, $mod.sel("commit"));
        // A snapshot request issued inside the frame body is serviced here —
        // same iteration, after commit, while the drawable is still ours.
        if ($mod.snap_pending) {
            $mod.snap_pending = false;
            $mod.dumpDrawable(drawable, win);
        }

        $mod.std.Thread.sleep(16 * $mod.std.time.ns_per_ms);
    }
    return .{ .done = win };
}

// No-op consumer of the per-frame borrow — auto-inserted release, mirror of
// raylib's release.frame.
~pub tor release.frame { f: *Frame<!frame> }
~proc release.frame|zig { _ = &f; }

~pub tor window.close { win: *Window<!active> }

~proc window.close|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    send(void, win.win, sel("close"));
    send(void, win.win, sel("release"));
    win.insts.deinit(std.heap.page_allocator);
    std.heap.page_allocator.destroy(win);
}

// ============================================================================
// Clear color — a WINDOW property, not a draw call. Metal reads the pass
// descriptor's clearColor at encoder creation, so a `draw.clear` inside the
// frame body would be a silent no-op by construction. Setting it here, as a
// borrow (same shape as raylib's window.fps), keeps the semantic honest: the
// stored color is applied to every frame's attachment.
// ============================================================================

~pub tor window.clear.color { win: *Window<opened|active>, r: f32, g: f32, b: f32 }

~proc window.clear.color|zig {
    win.clear = .{ .red = r, .green = g, .blue = b, .alpha = 1.0 };
}

// ============================================================================
// Drawing — every draw call borrows the frame handle, so it can only appear
// inside a `! frame` body, where it records into the live render encoder.
// ============================================================================

~pub tor draw.triangle { f: *Frame<frame> }

~proc draw.triangle|zig {
    instFlush(f);
    send1(void, Id, f.encoder, sel("setRenderPipelineState:"), f.pso);
    send3(void, u64, u64, u64, f.encoder, sel("drawPrimitives:vertexStart:vertexCount:"), 3, 0, 3);
}

// One colored quad in PIXEL space — the first real draw surface. The shader
// reads RectParams through [[buffer(0)]] (setVertexBytes) and maps
// pixel→NDC against the viewport the window opened with. Y is screen-space:
// row 0 at the top.
~pub tor draw.rect { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.rect|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = 0,
        .border_width = 0,
        .kind = inst_quad,
        .clip_round = 0,
    });
}

// A rounded-rect fill — same quad, SDF corners. `radius` is clamped to the
// half-extents in the fragment.
~pub tor draw.roundrect { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.roundrect|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = @floatCast(radius),
        .border_width = 0,
        .kind = inst_quad,
        .clip_round = 0,
    });
}

// A rounded rect carrying fill AND border in one instance — the panel
// primitive. `bw` is the border thickness in points; the border color is
// ignored (and the border skipped) when bw is 0.
~pub tor draw.panel { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, r: f64, g: f64, b: f64, a: f64, bw: f64, br: f64, bg: f64, bb: f64, ba: f64 }

~proc draw.panel|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ @floatCast(br), @floatCast(bg), @floatCast(bb), @floatCast(ba) },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = @floatCast(radius),
        .border_width = @floatCast(bw),
        .kind = inst_quad,
        .clip_round = 0,
    });
}

// A Gaussian-blurred shadow box — Evan Wallace's fast rounded-rect shadow,
// after nanoui. `blur` is sigma in points; the drawn quad extends 3*sigma
// past the box in every direction.
~pub tor draw.shadow { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, blur: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.shadow|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = @floatCast(radius),
        .border_width = @floatCast(blur),
        .kind = inst_shadow,
        .clip_round = 0,
    });
}

// The clip stack — every instance records the clip live when it is pushed,
// so a group of draws bounded by push/pop clip together. Nesting is by
// INTERSECTION: the pushed rect is clamped to the parent clip.
~pub tor draw.clip.push { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64 }

~proc draw.clip.push|zig {
    if (f.clip_depth >= f.clip_stack.len) return;
    var x0: f32 = @floatCast(x);
    var y0: f32 = @floatCast(y);
    var x1: f32 = x0 + @as(f32, @floatCast(w));
    var y1: f32 = y0 + @as(f32, @floatCast(h));
    if (f.clip_depth > 0) {
        const parent = f.clip_stack[f.clip_depth - 1];
        x0 = @max(x0, parent[0]);
        y0 = @max(y0, parent[1]);
        x1 = @min(x1, parent[2]);
        y1 = @min(y1, parent[3]);
    }
    f.clip_stack[f.clip_depth] = .{ x0, y0, x1, y1 };
    f.clip_depth += 1;
}

~pub tor draw.clip.pop { f: *Frame<frame> }

~proc draw.clip.pop|zig {
    if (f.clip_depth > 0) f.clip_depth -= 1;
}

// ============================================================================
// Images — decode to BGRA premultiplied via NSImage + CGBitmapContext (pure
// Cocoa/CoreGraphics, no extra frameworks), upload once into an MTLTexture.
// The texture handle is the value handed to Clay as imageData — it comes
// back out of the IMAGE render command verbatim for draw.image.
// ============================================================================

// Two-arm load — `| img` hands back the texture handle as i64 pointer
// bits (the same value Clay hands back as imageData for draw.image);
// `| err` names which step failed. No degraded/placeholder path.
~pub tor image.load { win: *Window<opened|active>, path: string } | img i64 | err string

~proc image.load|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);

    var pbuf: [1024]u8 = undefined;
    const pstr = cf.CFStringCreateWithCString(null, cstr(path, &pbuf), cf.kCFStringEncodingUTF8);
    const nsimg = send1(
        Id, Id,
        send(Id, cls("NSImage"), sel("alloc")),
        sel("initWithContentsOfFile:"),
        @as(Id, @ptrCast(@constCast(pstr))),
    );
    if (nsimg == null) return .{ .err = "metal: image file not readable" };
    var prop: NSRect = undefined;
    const cg = send3(Id, *NSRect, Id, Id, nsimg, sel("CGImageForProposedRect:context:hints:"), &prop, @as(Id, null), @as(Id, null));
    if (cg == null) return .{ .err = "metal: no CGImage in file" };
    const w = CGImageGetWidth(cg);
    const h = CGImageGetHeight(cg);
    if (w == 0 or h == 0) return .{ .err = "metal: zero-size image" };

    // Rasterize into a BGRA-premultiplied buffer — the layer's pixel format
    // (BGRA8Unorm) expects premultiplied alpha; kCGImageAlphaPremultipliedFirst
    // | kCGBitmapByteOrder32Little is exactly that byte order.
    const cs = CGColorSpaceCreateDeviceRGB();
    const bctx = CGBitmapContextCreate(null, w, h, 8, w * 4, cs, 2 | (2 << 12));
    if (bctx == null) return .{ .err = "metal: bitmap context failed" };
    CGContextDrawImage(bctx, .{ .origin = .{ .x = 0, .y = 0 }, .size = .{ .width = @floatFromInt(w), .height = @floatFromInt(h) } }, cg);
    const px = CGBitmapContextGetData(bctx) orelse return .{ .err = "metal: no bitmap data" };

    const device = send(Id, win.layer, sel("device"));
    const tdesc = send4(
        Id, u64, u64, u64, bool,
        cls("MTLTextureDescriptor"),
        sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"),
        80, w, h, false,
    );
    const tex = send1(Id, Id, device, sel("newTextureWithDescriptor:"), tdesc);
    if (tex == null) return .{ .err = "metal: texture creation failed" };
    const region = MTLRegion{
        .origin = .{ .x = 0, .y = 0, .z = 0 },
        .size = .{ .width = w, .height = h, .depth = 1 },
    };
    send4(void, MTLRegion, u64, ?*const anyopaque, u64, tex, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, px, w * 4);

    return .{ .img = @as(i64, @intCast(@intFromPtr(tex))) };
}

// One textured quad in PIXEL space — tex is a texture handle as i64
// pointer bits (or any imageData Clay hands back verbatim).
~pub tor draw.image { f: *Frame<frame>, tex: i64, x: f64, y: f64, w: f64, h: f64 }

~proc draw.image|zig {
    instFlush(f);
    const tid: Id = @ptrFromInt(@as(usize, @intCast(tex)));
    send1(void, Id, f.encoder, sel("setRenderPipelineState:"), f.pso_tex);
    var params = RectParams{
        .r = 1, .g = 1, .b = 1, .a = 1,
        .ox = @floatCast(x), .oy = @floatCast(y), .sw = @floatCast(w), .sh = @floatCast(h),
        .vw = f.vp_w, .vh = f.vp_h,
    };
    send3(void, *const RectParams, u64, u64, f.encoder, sel("setVertexBytes:length:atIndex:"), &params, @sizeOf(RectParams), 0);
    send2(void, Id, u64, f.encoder, sel("setFragmentTexture:atIndex:"), tid, 0);
    send2(void, Id, u64, f.encoder, sel("setFragmentSamplerState:atIndex:"), f.samp, 0);
    send3(void, u64, u64, u64, f.encoder, sel("drawPrimitives:vertexStart:vertexCount:"), 4, 0, 4);
}

// Request the frames loop to exit at the next iteration — same shape as
// vaxis:quit. Sets a module flag; frames checks it after mailbox dispatch.
~pub tor quit {}

~proc quit|zig {
    should_quit = true;
}
