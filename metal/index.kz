// @korulang/metal — a Metal window for Koru (v0: open + clear + close)
//
// Tracer for the native-app assimilation path: can Koru drive an
// Objective-C-flavored API with no shim? Everything below goes through
// objc_msgSend typed casts — no .m file, no wrapper library, just the
// ObjC runtime's C surface plus the few genuinely-C entry points
// (MTLCreateSystemDefaultDevice, CFStringCreateWithCString).
//
// The C footguns this compiles away, same bet as raylib/index.kz:
//
//   1. A window you open and never render is leaked Cocoa state — here it is
//      a KORU030 outright: `frames` is the only route to <active!>, and
//      <active!> is the only state window.close accepts.
//   2. Rendering without a drawable/descriptor bracket is a silent no-op —
//      here every draw call borrows a *Frame<frame> that only exists inside
//      the `! frame` effect-branch body: the pass descriptor lives between
//      the engine's bracket, so drawing outside a frame is not expressible.
//   3. Forgetting to end/present a command buffer hangs the swap — the
//      engine owns that bracket: endEncoding + presentDrawable + commit are
//      emitted around the frame body, so the user cannot omit them.
//
// House style follows raylib/index.kz and sqlite3/index.kz: `<state!>` grants
// an obligation, `<!state>` consumes it, bare `<state>` borrows.

~import std/build

~std/build:requires {
    exe.linkLibC();
    exe.linkFramework("Cocoa");
    exe.linkFramework("QuartzCore");
    exe.linkFramework("Metal");
    exe.linkFramework("CoreFoundation");
    exe.linkFramework("CoreText");
    exe.linkFramework("CoreGraphics");
}

const std = @import("std");

const objc = @cImport({
    @cInclude("objc/runtime.h");
    @cInclude("objc/message.h");
    @cInclude("objc/objc.h");
});

const cf = @cImport({
    @cInclude("CoreFoundation/CoreFoundation.h");
});

const Id = ?*anyopaque;
const SEL = objc.SEL;

extern fn MTLCreateSystemDefaultDevice() callconv(.c) Id;
extern fn objc_autoreleasePoolPush() callconv(.c) *anyopaque;
extern fn objc_autoreleasePoolPop(*anyopaque) callconv(.c) void;
extern fn CGImageGetWidth(image: Id) callconv(.c) usize;
extern fn CGImageGetHeight(image: Id) callconv(.c) usize;
extern fn CGColorSpaceCreateDeviceRGB() callconv(.c) Id;
extern fn CGBitmapContextCreate(data: ?*anyopaque, width: usize, height: usize, bitsPerComponent: usize, bytesPerRow: usize, space: Id, bitmapInfo: u32) callconv(.c) Id;
extern fn CGBitmapContextGetData(c: Id) callconv(.c) ?*anyopaque;
extern fn CGContextDrawImage(c: Id, rect: NSRect, image: Id) callconv(.c) void;
extern var NSDefaultRunLoopMode: Id;
extern var NSWindowDidResizeNotification: Id;
extern var NSWindowWillStartLiveResizeNotification: Id;
extern var NSWindowDidEndLiveResizeNotification: Id;

// CoreText/CoreGraphics for the glyph atlas + shaping (nanoui port) —
// declared raw, same style as the Metal externs above. CId is the
// const-qualified ref the translated CoreFoundation headers produce —
// CF objects are opaque handles, and a ?*const param accepts them
// without casts.
const CId = ?*const anyopaque;
extern fn CTFontGetAscent(font: CId) callconv(.c) f64;
extern fn CTFontGetDescent(font: CId) callconv(.c) f64;
extern fn CTFontGetLeading(font: CId) callconv(.c) f64;
extern fn CTFontGetBoundingRectsForGlyphs(font: CId, orientation: u32, glyphs: [*]const u16, rects: ?*NSRect, count: isize) callconv(.c) NSRect;
extern fn CTFontDrawGlyphs(font: CId, glyphs: [*]const u16, positions: [*]const NSPoint, count: usize, ctx: CId) callconv(.c) void;
extern fn CTLineCreateWithAttributedString(s: CId) callconv(.c) Id;
extern fn CTLineGetTypographicBounds(line: CId, ascent: ?*f64, descent: ?*f64, leading: ?*f64) callconv(.c) f64;
extern fn CTLineGetGlyphRuns(line: CId) callconv(.c) Id;
extern fn CTRunGetGlyphCount(run: CId) callconv(.c) isize;
extern fn CTRunGetGlyphs(run: CId, range: NSRange, out: [*]u16) callconv(.c) void;
extern fn CTRunGetPositions(run: CId, range: NSRange, out: [*]NSPoint) callconv(.c) void;
extern fn CTRunGetAdvances(run: CId, range: NSRange, out: [*]NSSize) callconv(.c) void;
extern fn CTRunGetStringIndices(run: CId, range: NSRange, out: [*]isize) callconv(.c) void;
extern fn CTRunGetAttributes(run: CId) callconv(.c) Id;
extern fn CFStringGetCString(s: CId, buf: [*]u8, max: isize, enc: u32) callconv(.c) bool;
extern fn CFArrayGetCount(arr: CId) callconv(.c) isize;
extern fn CFArrayGetValueAtIndex(arr: CId, i: isize) callconv(.c) Id;
extern fn CFDictionaryGetValue(dict: CId, key: ?*const anyopaque) callconv(.c) Id;
extern fn CFHash(ref: ?*const anyopaque) callconv(.c) usize;
extern fn CFEqual(a: ?*const anyopaque, b: ?*const anyopaque) callconv(.c) bool;
extern fn CGContextRelease(ctx: CId) callconv(.c) void;
extern fn CGContextScaleCTM(ctx: CId, sx: f64, sy: f64) callconv(.c) void;
extern fn CGContextTranslateCTM(ctx: CId, tx: f64, ty: f64) callconv(.c) void;
extern fn CGContextSetGrayFillColor(ctx: CId, gray: f64, alpha: f64) callconv(.c) void;
extern fn CGContextSetShouldAntialias(ctx: CId, v: bool) callconv(.c) void;
extern fn CGContextSetShouldSmoothFonts(ctx: CId, v: bool) callconv(.c) void;
extern fn CGContextSetAllowsFontSubpixelPositioning(ctx: CId, v: bool) callconv(.c) void;
extern fn CGContextSetShouldSubpixelPositionFonts(ctx: CId, v: bool) callconv(.c) void;
extern var kCTFontAttributeName: Id;
extern var kCTForegroundColorFromContextAttributeName: Id;

const NSPoint = extern struct { x: f64, y: f64 };
const NSSize = extern struct { width: f64, height: f64 };
const NSRect = extern struct { origin: NSPoint, size: NSSize };
const NSRange = extern struct { location: isize, length: isize };
const MTLClearColor = extern struct { red: f64, green: f64, blue: f64, alpha: f64 };
const MTLOrigin = extern struct { x: u64, y: u64, z: u64 };
const MTLSize = extern struct { width: u64, height: u64, depth: u64 };
const MTLRegion = extern struct { origin: MTLOrigin, size: MTLSize };

// Vertex positions come from [[vertex_id]] — no vertex buffers needed for a
// static triangle. Compiled at runtime through newLibraryWithSource:.
// The rect pair takes per-draw RectParams through [[buffer(0)]] —
// setVertexBytes — and converts pixel-space origin+size to NDC against the
// drawable viewport carried on the Frame.
const msl_src: [:0]const u8 =
    \\#include <metal_stdlib>
    \\using namespace metal;
    \\vertex float4 vertex_main(uint vid [[vertex_id]]) {
    \\    float2 pos[3] = { float2(0.0, 0.7), float2(-0.7, -0.5), float2(0.7, -0.5) };
    \\    return float4(pos[vid], 0.0, 1.0);
    \\}
    \\fragment float4 fragment_main() {
    \\    return float4(1.0, 0.45, 0.1, 1.0);
    \\}
    \\struct RectParams {
    \\    float4 color;
    \\    float2 origin;
    \\    float2 size;
    \\    float2 viewport;
    \\};
    \\struct RectOut {
    \\    float4 pos [[position]];
    \\    float4 color;
    \\};
    \\vertex RectOut rect_vertex(uint vid [[vertex_id]], constant RectParams& p [[buffer(0)]]) {
    \\    float2 corners[4] = { float2(0.0,0.0), float2(1.0,0.0), float2(0.0,1.0), float2(1.0,1.0) };
    \\    float2 pix = p.origin + corners[vid] * p.size;
    \\    RectOut o;
    \\    o.pos = float4(pix.x / p.viewport.x * 2.0 - 1.0, 1.0 - pix.y / p.viewport.y * 2.0, 0.0, 1.0);
    \\    o.color = p.color;
    \\    return o;
    \\}
    \\fragment float4 rect_fragment(RectOut in [[stage_in]]) {
    \\    return in.color;
    \\}
    \\// Instanced quads — ported from nanoui's shader.metal (MIT,
    \\// github.com/justrach/nanoui). One instance = one rounded rectangle
    \\// with optional border (kind 0), an atlas glyph (kind 1 — R8 coverage
    \\// sampled at uv), a Gaussian-blurred shadow box (kind 2), or an
    \\// image-atlas rect (kind 3 — RGBA sampled at uv, tinted by color).
    \\// Each instance clips to its clip rect; clip corners may be rounded.
    \\struct Inst {
    \\    float4 rect;          // x, y, w, h in points
    \\    float4 color;         // straight alpha
    \\    float4 border_color;
    \\    float4 uv;            // atlas u0,v0,u1,v1 — reserved, unused today
    \\    float4 clip;          // x0, y0, x1, y1 — huge when unclipped
    \\    float radius;
    \\    float border_width;   // blur sigma for kind 2
    \\    float kind;
    \\    float clip_round;     // corners * 4096 + radius, 0 = square clip
    \\};
    \\struct InstOut {
    \\    float4 pos [[position]];
    \\    float2 local;
    \\    float2 world;
    \\    float2 uv;
    \\    uint inst [[flat]];
    \\};
    \\vertex InstOut inst_vertex(uint vid [[vertex_id]], uint iid [[instance_id]],
    \\                          constant Inst *insts [[buffer(0)]],
    \\                          constant float2 &vp [[buffer(1)]]) {
    \\    Inst i = insts[iid];
    \\    float2 corner = float2(vid & 1, vid >> 1);
    \\    // Shadows reach three standard deviations past their box.
    \\    float grow = i.kind == 2 ? i.border_width * 3.0 : 0.0;
    \\    float2 p = i.rect.xy - grow + corner * (i.rect.zw + 2.0 * grow);
    \\    InstOut o;
    \\    o.pos = float4(p.x / vp.x * 2.0 - 1.0, 1.0 - p.y / vp.y * 2.0, 0.0, 1.0);
    \\    o.local = p - i.rect.xy;
    \\    o.world = p;
    \\    o.uv = mix(i.uv.xy, i.uv.zw, corner);
    \\    o.inst = iid;
    \\    return o;
    \\}
    \\// Shadow coverage after Evan Wallace's fast rounded-rectangle shadows:
    \\// the box's coverage blurred by a Gaussian, exact along x with erf,
    \\// sampled four times along y.
    \\static float inst_gaussian(float x, float sigma) {
    \\    return exp(-(x * x) / (2.0 * sigma * sigma)) / (sqrt(2.0 * M_PI_F) * sigma);
    \\}
    \\static float2 inst_erf2(float2 x) {
    \\    float2 s = sign(x), a = abs(x);
    \\    x = 1.0 + (0.278393 + (0.230389 + 0.078108 * (a * a)) * a) * a;
    \\    x *= x;
    \\    return s - s / (x * x);
    \\}
    \\static float inst_blur_along_x(float x, float y, float sigma, float corner, float2 half_size) {
    \\    float delta = min(half_size.y - corner - abs(y), 0.0);
    \\    float curved = half_size.x - corner + sqrt(max(0.0, corner * corner - delta * delta));
    \\    float2 integral = 0.5 + 0.5 * inst_erf2((x + float2(-curved, curved)) * (sqrt(0.5) / sigma));
    \\    return integral.y - integral.x;
    \\}
    \\static float inst_shadow_alpha(float2 p, float2 half_size, float corner, float sigma) {
    \\    float low = p.y - half_size.y;
    \\    float high = p.y + half_size.y;
    \\    float start = clamp(-3.0 * sigma, low, high);
    \\    float end = clamp(3.0 * sigma, low, high);
    \\    float step = (end - start) / 4.0;
    \\    float y = start + step * 0.5;
    \\    float alpha = 0.0;
    \\    for (int k = 0; k < 4; k++) {
    \\        alpha += inst_blur_along_x(p.x, p.y - y, sigma, corner, half_size) * inst_gaussian(y, sigma) * step;
    \\        y += step;
    \\    }
    \\    return alpha;
    \\}
    \\static float inst_rounded_box(float2 p, float2 half_size, float r) {
    \\    float2 q = abs(p) - half_size + r;
    \\    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
    \\}
    \\fragment float4 inst_fragment(InstOut in [[stage_in]],
    \\                             constant Inst *insts [[buffer(0)]],
    \\                             texture2d<float> atlas [[texture(0)]],
    \\                             texture2d<float> images [[texture(1)]]) {
    \\    Inst i = insts[in.inst];
    \\    if (in.world.x < i.clip.x || in.world.y < i.clip.y || in.world.x > i.clip.z || in.world.y > i.clip.w)
    \\        discard_fragment();
    \\    float clip_cover = 1.0;
    \\    if (i.clip_round > 0.0) {
    \\        float corners = floor(i.clip_round / 4096.0);
    \\        float rad = i.clip_round - corners * 4096.0;
    \\        float2 ch = (i.clip.zw - i.clip.xy) * 0.5;
    \\        float2 q = in.world - i.clip.xy - ch;
    \\        float cd = inst_rounded_box(q, ch, min(rad, min(ch.x, ch.y)));
    \\        float caa = max(fwidth(cd), 0.0001) * 0.5;
    \\        uint bit = q.y < 0.0 ? (q.x < 0.0 ? 1u : 2u) : (q.x < 0.0 ? 8u : 4u);
    \\        if ((uint(corners) & bit) != 0u) clip_cover = 1.0 - smoothstep(-caa, caa, cd);
    \\        if (clip_cover <= 0.0) discard_fragment();
    \\    }
    \\    float2 half_size = i.rect.zw * 0.5;
    \\    float2 p = in.local - half_size;
    \\    float r = min(i.radius, min(half_size.x, half_size.y));
    \\    float d = inst_rounded_box(p, half_size, r);
    \\    if (i.kind == 1.0) {
    \\        constexpr sampler s(filter::linear, address::clamp_to_edge);
    \\        float a = atlas.sample(s, in.uv).r * i.color.a;
    \\        return float4(i.color.rgb, a) * clip_cover;
    \\    }
    \\    if (i.kind == 2.0) {
    \\        float sigma = max(i.border_width, 0.25);
    \\        float a = inst_shadow_alpha(p, half_size, r, sigma) * i.color.a;
    \\        return float4(i.color.rgb, a) * clip_cover;
    \\    }
    \\    if (i.kind == 3.0) {
    \\        constexpr sampler s(filter::linear, address::clamp_to_edge);
    \\        float4 c = images.sample(s, in.uv);
    \\        // Atlas pixels are BGRA-PREMULTIPLIED; the pipeline blends
    \\        // SourceAlpha/1-SourceAlpha, so straighten before tinting.
    \\        c.rgb /= max(c.a, 1e-5);
    \\        return c * i.color * clip_cover;
    \\    }
    \\    float aa = max(fwidth(d), 0.0001) * 0.5;
    \\    float coverage = 1.0 - smoothstep(-aa, aa, d);
    \\    float4 c = i.color;
    \\    if (i.border_width > 0.0 && i.border_color.a > 0.0) {
    \\        float inner = smoothstep(-i.border_width - aa, -i.border_width + aa, d);
    \\        c = mix(c, i.border_color, inner);
    \\    }
    \\    float a = c.a * coverage;
    \\    // Straight alpha out — the pipeline blends SourceAlpha/1-SourceAlpha.
    \\    return float4(c.rgb, a) * clip_cover;
    \\}
;

// Host twin of the MSL RectParams — float4 first so every float2 still
// lands on an 8-byte boundary (MSL constant-address-space layout rules).
const RectParams = extern struct {
    r: f32, g: f32, b: f32, a: f32,
    ox: f32, oy: f32, sw: f32, sh: f32,
    vw: f32, vh: f32,
};

// ============================================================================
// Instanced quads — ported from nanoui's gpu.zig + metal.zig (MIT,
// github.com/justrach/nanoui). Draw tors APPEND GpuInstances to the frame's
// list instead of drawing; the frame flushes once per run of instanced work
// (before any non-instanced draw, and at frame end) as a single instanced
// triangle-strip draw. Ordering against textured-quad draws is preserved by
// flushing first — image draws interleave exactly where they were called.
//
// The buffer is a fresh shared-storage MTLBuffer per flush, autoreleased:
// the encoder retains bound resources until the command buffer completes,
// so transient per-frame buffers are correct without a ring (nanoui's
// offscreen path does the same).
// ============================================================================

// Host twin of the MSL Inst — [4]f32 fields are 16-byte members either way,
// so offsets match the constant-address-space layout.
const GpuInstance = extern struct {
    rect: [4]f32,
    color: [4]f32,
    border_color: [4]f32,
    uv: [4]f32,
    clip: [4]f32,
    radius: f32,
    border_width: f32,
    kind: f32,
    clip_round: f32,
};

const inst_quad: f32 = 0;
const inst_text: f32 = 1;
const inst_shadow: f32 = 2;
const inst_image: f32 = 3;

// A clip rect as the shader reads it: x0,y0,x1,y1. An empty stack means the
// huge unclipped rect — cheap in the fragment (four compares).
const no_clip: [4]f32 = .{ -1e6, -1e6, 1e6, 1e6 };

fn curClip(f: *const Frame) [4]f32 {
    if (f.clip_depth == 0) return no_clip;
    return f.clip_stack[f.clip_depth - 1];
}

fn instPush(f: *Frame, inst: GpuInstance) void {
    f.insts.append(std.heap.page_allocator, inst) catch @panic("metal: OOM pushing instance");
}

// Records any pending instances through the instanced pipeline. Called by
// the frame's own end bracket and by any draw that is NOT an instance —
// so ordering against textured quads survives the split path.
fn instFlush(f: *Frame) void {
    if (f.insts.items.len == 0) return;
    const n = f.insts.items.len;
    const device = f.device;
    const buf = send3(
        Id, ?*const anyopaque, u64, u64,
        device, sel("newBufferWithBytes:length:options:"),
        f.insts.items.ptr, n * @sizeOf(GpuInstance), 0, // MTLStorageModeShared
    );
    if (buf == null) @panic("metal: instance buffer allocation failed");
    send(void, buf, sel("autorelease"));
    send1(void, Id, f.encoder, sel("setRenderPipelineState:"), f.pso_inst);
    send3(void, Id, u64, u64, f.encoder, sel("setVertexBuffer:offset:atIndex:"), buf, 0, 0);
    const vp: [2]f32 = .{ f.vp_w, f.vp_h };
    send3(void, *const [2]f32, u64, u64, f.encoder, sel("setVertexBytes:length:atIndex:"), &vp, 8, 1);
    send3(void, Id, u64, u64, f.encoder, sel("setFragmentBuffer:offset:atIndex:"), buf, 0, 0);
    send2(void, Id, u64, f.encoder, sel("setFragmentTexture:atIndex:"), f.text.atlas.texture, 0);
    send2(void, Id, u64, f.encoder, sel("setFragmentTexture:atIndex:"), f.images.texture, 1);
    send4(void, u64, u64, u64, u64, f.encoder, sel("drawPrimitives:vertexStart:vertexCount:instanceCount:"), 4, 0, 4, n);
    f.flushed.* += n;
    f.insts.clearRetainingCapacity();
}

// ============================================================================
// Text — CoreText shaping over a shelf-packed R8 glyph atlas, ported from
// nanoui's atlas.zig + text_mac.zig (MIT, github.com/justrach/nanoui).
// draw.text shapes a run once per (string, size) — layouts live two
// frames — then each glyph rasterizes once per font and quarter-pixel
// subpixel bin into the atlas; every glyph becomes one kind-1 instance
// the shader samples as coverage. Fonts are NSFont (toll-free CTFont)
// at the system's face; a run's fallback font joins run_fonts by index.
// ============================================================================

const atlas_initial: u32 = 2048;
const atlas_max: u32 = 4096;
const atlas_pad: u32 = 1;
const atlas_bins: u8 = 4; // subpixel bins per pixel, horizontal

// Shelf packer shared by both atlases: rows bottom-up, each new entry
// extends the current shelf or starts a new one. Geometry only — the
// owning atlas decides texture format, key space, and what resets mean.
const Shelf = struct {
    size: u32,
    x: u32 = 0,
    y: u32 = 0,
    h: u32 = 0,

    fn allocate(s: *Shelf, w: u32, h: u32) ?[2]u32 {
        if (s.x + w > s.size) {
            s.y += s.h;
            s.x = 0;
            s.h = 0;
        }
        if (s.y + h > s.size) return null;
        const at: [2]u32 = .{ s.x, s.y };
        s.x += w;
        s.h = @max(s.h, h);
        return at;
    }

    // Doubles the shelf side up to atlas_max, restarting the pack. The
    // owner rebuilds its texture and clears its key map — every entry
    // must re-rasterize/re-pack against the NEW texel space.
    fn grow(s: *Shelf) void {
        if (s.size < atlas_max) s.size *= 2;
        s.x = 0;
        s.y = 0;
        s.h = 0;
    }
};

// One glyph's picture in the atlas — uv texels, and x/y/w/h in points
// relative to the pen position on the baseline.
const Sprite = struct { uv: [4]f32, x: f32, y: f32, w: f32, h: f32 };
const SpriteKey = struct { font: u16, glyph: u16, bin: u8 };

const GlyphAtlas = struct {
    device: Id,
    texture: Id,
    shelf: Shelf,
    scale: f32,
    sprites: std.AutoHashMapUnmanaged(SpriteKey, ?Sprite) = .empty,
    pixels: std.ArrayList(u8) = .empty,
    // Set when a glyph didn't fit this frame — beginFrame grows the
    // atlas before the next frame body runs. The reset is DEFERRED, not
    // mid-frame: instances always bind the atlas they were rasterized
    // against (nanoui resets mid-frame and repaints; our instance stream
    // is already recorded, so the growth happens between frames). A
    // skipped glyph draws one frame late.
    needs_reset: bool = false,

    fn makeTexture(device: Id, side: u32) Id {
        const desc = send4(Id, u64, u64, u64, bool, cls("MTLTextureDescriptor"), sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), 10, side, side, false); // R8Unorm
        return send1(Id, Id, device, sel("newTextureWithDescriptor:"), desc) orelse @panic("metal: glyph atlas texture failed");
    }

    fn init(device: Id, scale: f32) GlyphAtlas {
        return .{ .device = device, .texture = makeTexture(device, atlas_initial), .shelf = .{ .size = atlas_initial }, .scale = scale };
    }

    fn deinit(a: *GlyphAtlas) void {
        a.sprites.deinit(std.heap.page_allocator);
        a.pixels.deinit(std.heap.page_allocator);
        if (a.texture != null) send(void, a.texture, sel("release"));
    }

    fn makeRoom(a: *GlyphAtlas) void {
        const grew = a.shelf.size < atlas_max;
        a.shelf.grow();
        if (grew) {
            send(void, a.texture, sel("release"));
            a.texture = makeTexture(a.device, a.shelf.size);
        }
        a.sprites.clearRetainingCapacity();
    }

    fn upload(a: *GlyphAtlas, origin: [2]u32, w: u32, h: u32) void {
        const region = MTLRegion{
            .origin = .{ .x = origin[0], .y = origin[1], .z = 0 },
            .size = .{ .width = w, .height = h, .depth = 1 },
        };
        send4(void, MTLRegion, u64, *const anyopaque, u64, a.texture, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, a.pixels.items.ptr, w);
    }

    // The sprite of `g` in `font` drawn at `bin` quarters of a pixel —
    // null is a DESIGNED absence, not a failure: blank glyphs (spaces)
    // have no bounds, oversized ones can't fit, and full-atlas skips set
    // needs_reset and draw one frame late.
    fn glyph(a: *GlyphAtlas, font_id: u16, font: Id, g: u16, bin: u8) ?Sprite {
        const key: SpriteKey = .{ .font = font_id, .glyph = g, .bin = bin };
        if (a.sprites.get(key)) |sp| return sp;
        const sp = a.rasterize(font, g, bin);
        a.sprites.put(std.heap.page_allocator, key, sp) catch @panic("metal: OOM in glyph atlas");
        return sp;
    }

    fn rasterize(a: *GlyphAtlas, font: Id, g: u16, bin: u8) ?Sprite {
        const scale = a.scale;
        var glyphs = [1]u16{g};
        const bounds = CTFontGetBoundingRectsForGlyphs(font, 0, &glyphs, null, 1);
        if (bounds.size.width <= 0 or bounds.size.height <= 0) return null;
        const sub: f64 = @as(f64, @floatFromInt(bin)) / atlas_bins;
        const s: f64 = scale;
        const x0 = @floor(bounds.origin.x * s + sub);
        const y0 = @floor(bounds.origin.y * s);
        const x1 = @ceil((bounds.origin.x + bounds.size.width) * s + sub);
        const y1 = @ceil((bounds.origin.y + bounds.size.height) * s);
        const w: u32 = @as(u32, @intFromFloat(x1 - x0)) + 2 * atlas_pad;
        const h: u32 = @as(u32, @intFromFloat(y1 - y0)) + 2 * atlas_pad;
        if (w > atlas_max or h > atlas_max) return null;
        const origin = a.shelf.allocate(w, h) orelse {
            a.needs_reset = true;
            return null;
        };

        a.pixels.resize(std.heap.page_allocator, w * h) catch @panic("metal: OOM in glyph atlas");
        @memset(a.pixels.items, 0);
        // 7 = kCGImageAlphaOnly — an 8-bit coverage mask, no color space.
        const ctx = CGBitmapContextCreate(a.pixels.items.ptr, w, h, 8, w, null, 7) orelse @panic("metal: glyph bitmap context failed");
        defer CGContextRelease(ctx);
        CGContextSetShouldAntialias(ctx, true);
        CGContextSetShouldSmoothFonts(ctx, false);
        CGContextSetAllowsFontSubpixelPositioning(ctx, true);
        CGContextSetShouldSubpixelPositionFonts(ctx, true);
        CGContextSetGrayFillColor(ctx, 1, 1);
        // The glyph's origin, in pixels from the bitmap's bottom left.
        CGContextTranslateCTM(ctx, @as(f64, atlas_pad) - x0 + sub, @as(f64, atlas_pad) - y0);
        CGContextScaleCTM(ctx, s, s);
        const at = [1]NSPoint{.{ .x = 0, .y = 0 }};
        CTFontDrawGlyphs(font, &glyphs, &at, 1, ctx);

        a.upload(origin, w, h);
        const as: f32 = @floatFromInt(a.shelf.size);
        const fw: f32 = @floatFromInt(w);
        const fh: f32 = @floatFromInt(h);
        return .{
            .uv = .{
                @as(f32, @floatFromInt(origin[0])) / as,
                @as(f32, @floatFromInt(origin[1])) / as,
                @as(f32, @floatFromInt(origin[0] + w)) / as,
                @as(f32, @floatFromInt(origin[1] + h)) / as,
            },
            .x = (@as(f32, @floatCast(x0)) - @as(f32, atlas_pad)) / scale,
            .y = -(@as(f32, @floatCast(y0)) - @as(f32, atlas_pad) + fh) / scale,
            .w = fw / scale,
            .h = fh / scale,
        };
    }
};

// One shaped glyph: `font` indexes TextSystem.run_fonts; x/y the pen
// offset on the baseline, `adv` the pen advance, `str_idx` the string
// index the glyph's cluster starts at (UTF-16 units — byte-equal for
// ASCII, the v1 hit-testing contract).
const Glyph = struct { font: u16, glyph: u16, x: f32, y: f32, adv: f32, str_idx: u32 };
const Layout = struct { width: f32, glyphs: []Glyph };
const Font = struct { ref: Id, ascent: f32, descent: f32, leading: f32 };

const TextSystem = struct {
    atlas: GlyphAtlas,
    scale: f32,
    fonts: std.AutoHashMapUnmanaged(u32, Font) = .empty, // key: size bits
    run_fonts: std.ArrayList(Id) = .empty,
    layouts: std.AutoHashMapUnmanaged(u64, Layout) = .empty,
    previous: std.AutoHashMapUnmanaged(u64, Layout) = .empty,
    scratch_glyphs: std.ArrayList(u16) = .empty,
    scratch_points: std.ArrayList(NSPoint) = .empty,
    scratch_adv: std.ArrayList(NSSize) = .empty,
    scratch_idx: std.ArrayList(isize) = .empty,

    fn init(device: Id, scale: f32) TextSystem {
        return .{ .atlas = .init(device, scale), .scale = scale };
    }

    fn deinit(ts: *TextSystem) void {
        var fit = ts.fonts.valueIterator();
        while (fit.next()) |f| cf.CFRelease(f.ref);
        ts.fonts.deinit(std.heap.page_allocator);
        for (ts.run_fonts.items) |f| cf.CFRelease(f);
        ts.run_fonts.deinit(std.heap.page_allocator);
        var lit = ts.layouts.valueIterator();
        while (lit.next()) |l| std.heap.page_allocator.free(l.glyphs);
        ts.layouts.deinit(std.heap.page_allocator);
        var pit = ts.previous.valueIterator();
        while (pit.next()) |l| std.heap.page_allocator.free(l.glyphs);
        ts.previous.deinit(std.heap.page_allocator);
        ts.scratch_glyphs.deinit(std.heap.page_allocator);
        ts.scratch_points.deinit(std.heap.page_allocator);
        ts.scratch_adv.deinit(std.heap.page_allocator);
        ts.scratch_idx.deinit(std.heap.page_allocator);
        ts.atlas.deinit();
    }

    // Frame start: layouts unused last frame die, this frame's become
    // last; a deferred atlas reset grows before any glyph looks up.
    fn beginFrame(ts: *TextSystem) void {
        if (ts.atlas.needs_reset) {
            ts.atlas.needs_reset = false;
            ts.atlas.makeRoom();
        }
        var it = ts.previous.valueIterator();
        while (it.next()) |l| std.heap.page_allocator.free(l.glyphs);
        ts.previous.clearRetainingCapacity();
        std.mem.swap(std.AutoHashMapUnmanaged(u64, Layout), &ts.layouts, &ts.previous);
    }

    // The system font at `size` — v1 is regular weight only; the cache
    // key is the size bits so a heavier face later joins the same map.
    fn font(ts: *TextSystem, size: f32) Font {
        const key: u32 = @bitCast(size);
        if (ts.fonts.get(key)) |f| return f;
        const nsfont = send2(Id, f64, f64, cls("NSFont"), sel("systemFontOfSize:weight:"), @as(f64, size), 0.0) orelse @panic("metal: NSFont creation failed");
        const ref: Id = send(Id, nsfont, sel("retain"));
        const f: Font = .{
            .ref = ref,
            .ascent = @floatCast(CTFontGetAscent(ref)),
            .descent = @floatCast(CTFontGetDescent(ref)),
            .leading = @floatCast(CTFontGetLeading(ref)),
        };
        ts.fonts.put(std.heap.page_allocator, key, f) catch @panic("metal: OOM caching font");
        return f;
    }

    // The index of `f` among the run fonts, retaining it if new.
    fn fontId(ts: *TextSystem, f: Id) u16 {
        const h = CFHash(f);
        for (ts.run_fonts.items, 0..) |known, i| {
            if (known == f or (CFHash(known) == h and CFEqual(known, f))) return @intCast(i);
        }
        ts.run_fonts.append(std.heap.page_allocator, @ptrCast(@constCast(cf.CFRetain(f)))) catch @panic("metal: OOM tracking run font");
        return @intCast(ts.run_fonts.items.len - 1);
    }

    fn layoutKey(text: []const u8, size: f32) u64 {
        var h = std.hash.Wyhash.init(0);
        h.update(text);
        h.update(std.mem.asBytes(&size));
        return h.final();
    }

    // `text` shaped on one line — the cache serves two frames.
    fn layout(ts: *TextSystem, text: []const u8, size: f32) Layout {
        if (text.len == 0) return .{ .width = 0, .glyphs = &.{} };
        const k = layoutKey(text, size);
        if (ts.layouts.get(k)) |l| return l;
        if (ts.previous.fetchRemove(k)) |kv| {
            ts.layouts.put(std.heap.page_allocator, k, kv.value) catch @panic("metal: OOM promoting text layout");
            return kv.value;
        }
        const l = ts.shape(text, size);
        ts.layouts.put(std.heap.page_allocator, k, l) catch @panic("metal: OOM caching text layout");
        return l;
    }

    fn shape(ts: *TextSystem, text: []const u8, size: f32) Layout {
        const f = ts.font(size);
        const str = cf.CFStringCreateWithBytes(null, text.ptr, @intCast(text.len), cf.kCFStringEncodingUTF8, 0) orelse @panic("metal: CFString creation failed");
        defer cf.CFRelease(str);
        const keys = [_]?*const anyopaque{ kCTFontAttributeName, kCTForegroundColorFromContextAttributeName };
        const values = [_]?*const anyopaque{ f.ref, cf.kCFBooleanTrue };
        const attrs = cf.CFDictionaryCreate(null, @ptrCast(@constCast(keys[0..].ptr)), @ptrCast(@constCast(values[0..].ptr)), 2, &cf.kCFTypeDictionaryKeyCallBacks, &cf.kCFTypeDictionaryValueCallBacks) orelse @panic("metal: CFDictionary creation failed");
        defer cf.CFRelease(attrs);
        const astr = cf.CFAttributedStringCreate(null, str, attrs) orelse @panic("metal: CFAttributedString creation failed");
        defer cf.CFRelease(astr);
        const line = CTLineCreateWithAttributedString(astr) orelse @panic("metal: CTLine creation failed");
        defer cf.CFRelease(line);
        const w: f32 = @floatCast(CTLineGetTypographicBounds(line, null, null, null));

        var glyphs: std.ArrayList(Glyph) = .empty;
        const runs = CTLineGetGlyphRuns(line);
        var r: isize = 0;
        while (r < CFArrayGetCount(runs)) : (r += 1) {
            const run = CFArrayGetValueAtIndex(runs, r);
            const count: usize = @intCast(@max(0, CTRunGetGlyphCount(run)));
            if (count == 0) continue;
            const run_font = CFDictionaryGetValue(CTRunGetAttributes(run), kCTFontAttributeName) orelse @panic("metal: glyph run carried no font");
            const fid = ts.fontId(run_font);
            ts.scratch_glyphs.resize(std.heap.page_allocator, count) catch @panic("metal: OOM shaping text");
            ts.scratch_points.resize(std.heap.page_allocator, count) catch @panic("metal: OOM shaping text");
            ts.scratch_adv.resize(std.heap.page_allocator, count) catch @panic("metal: OOM shaping text");
            ts.scratch_idx.resize(std.heap.page_allocator, count) catch @panic("metal: OOM shaping text");
            const all: NSRange = .{ .location = 0, .length = 0 };
            CTRunGetGlyphs(run, all, ts.scratch_glyphs.items.ptr);
            CTRunGetPositions(run, all, ts.scratch_points.items.ptr);
            CTRunGetAdvances(run, all, ts.scratch_adv.items.ptr);
            CTRunGetStringIndices(run, all, ts.scratch_idx.items.ptr);
            for (ts.scratch_glyphs.items, ts.scratch_points.items, ts.scratch_adv.items, ts.scratch_idx.items) |g, p, adv, si| {
                glyphs.append(std.heap.page_allocator, .{ .font = fid, .glyph = g, .x = @floatCast(p.x), .y = @floatCast(p.y), .adv = @floatCast(adv.width), .str_idx = @intCast(@max(0, si)) }) catch @panic("metal: OOM shaping text");
            }
        }
        return .{ .width = w, .glyphs = glyphs.toOwnedSlice(std.heap.page_allocator) catch @panic("metal: OOM shaping text") };
    }
};

// ============================================================================
// Images — decoded once to BGRA-premultiplied pixels at load, packed into
// a per-window RGBA atlas (kind 3). The handle Clay carries through
// imageData is a 1-based index into `decoded_images`, NOT a texture
// pointer: the atlas slot is per-window and per-generation, re-pinned
// lazily after every deferred shelf growth clears it.
// ============================================================================

const DecodedImage = struct { pixels: []u8, w: u32, h: u32 };
var decoded_images: std.ArrayList(DecodedImage) = .empty;

const img_atlas_pad: u32 = 2; // gutter ring — keeps linear filtering off neighbors

const ImageAtlas = struct {
    device: Id,
    texture: Id,
    shelf: Shelf,
    slots: std.AutoHashMapUnmanaged(u32, [4]f32) = .empty, // handle → uv rect
    zeros: std.ArrayList(u8) = .empty, // gutter scratch — pad ring must be zero, not whatever the texture held
    // Same deferred contract as GlyphAtlas.needs_reset — a full shelf
    // grows at beginFrame, never mid-encode.
    needs_reset: bool = false,

    fn makeTexture(device: Id, side: u32) Id {
        const desc = send4(Id, u64, u64, u64, bool, cls("MTLTextureDescriptor"), sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), 80, side, side, false); // BGRA8Unorm
        return send1(Id, Id, device, sel("newTextureWithDescriptor:"), desc) orelse @panic("metal: image atlas texture failed");
    }

    fn init(device: Id) ImageAtlas {
        return .{ .device = device, .texture = makeTexture(device, atlas_initial), .shelf = .{ .size = atlas_initial } };
    }

    fn deinit(a: *ImageAtlas) void {
        a.slots.deinit(std.heap.page_allocator);
        a.zeros.deinit(std.heap.page_allocator);
        send(void, a.texture, sel("release"));
    }

    // Frame start: a full shelf from last frame grows before any
    // draw.image looks a slot up. Clearing `slots` drops only the uv
    // RECORD — re-pinning re-uploads from the decoded registry.
    fn beginFrame(a: *ImageAtlas) void {
        if (!a.needs_reset) return;
        a.needs_reset = false;
        if (a.shelf.size < atlas_max) {
            a.shelf.grow();
            send(void, a.texture, sel("release"));
            a.texture = makeTexture(a.device, a.shelf.size);
        } else {
            a.shelf.x = 0;
            a.shelf.y = 0;
            a.shelf.h = 0;
        }
        a.slots.clearRetainingCapacity();
    }

    // The uv rect `handle` occupies — uploading the decoded pixels on
    // first ask or after a reset cleared the slot. null = didn't fit;
    // the caller skips the instance and it draws one frame late.
    fn slot(a: *ImageAtlas, handle: u32, img: DecodedImage) ?[4]f32 {
        if (a.slots.get(handle)) |uv| return uv;
        const pw = img.w + 2 * img_atlas_pad;
        const ph = img.h + 2 * img_atlas_pad;
        if (pw > a.shelf.size or ph > a.shelf.size) {
            a.needs_reset = true;
            return null;
        }
        const origin = a.shelf.allocate(pw, ph) orelse {
            a.needs_reset = true;
            return null;
        };
        // Zero the whole slot (gutter included) before the inner upload —
        // a fresh slot's pad ring is undefined texels, and linear
        // filtering bleeds ±0.5px of it into the image edge.
        a.zeros.resize(std.heap.page_allocator, pw * ph * 4) catch @panic("metal: OOM in image atlas");
        @memset(a.zeros.items, 0);
        const slot_region = MTLRegion{
            .origin = .{ .x = origin[0], .y = origin[1], .z = 0 },
            .size = .{ .width = pw, .height = ph, .depth = 1 },
        };
        send4(void, MTLRegion, u64, *const anyopaque, u64, a.texture, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), slot_region, 0, a.zeros.items.ptr, pw * 4);
        const region = MTLRegion{
            .origin = .{ .x = origin[0] + img_atlas_pad, .y = origin[1] + img_atlas_pad, .z = 0 },
            .size = .{ .width = img.w, .height = img.h, .depth = 1 },
        };
        send4(void, MTLRegion, u64, *const anyopaque, u64, a.texture, sel("replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0, img.pixels.ptr, img.w * 4);
        const s: f32 = @floatFromInt(a.shelf.size);
        const uv: [4]f32 = .{
            @as(f32, @floatFromInt(origin[0] + img_atlas_pad)) / s,
            @as(f32, @floatFromInt(origin[1] + img_atlas_pad)) / s,
            @as(f32, @floatFromInt(origin[0] + img_atlas_pad + img.w)) / s,
            @as(f32, @floatFromInt(origin[1] + img_atlas_pad + img.h)) / s,
        };
        a.slots.put(std.heap.page_allocator, handle, uv) catch @panic("metal: OOM in image atlas");
        return uv;
    }
};

fn sel(comptime name: [:0]const u8) SEL {
    return objc.sel_registerName(name);
}

fn cls(comptime name: [:0]const u8) Id {
    return @ptrCast(objc.objc_getClass(name));
}

// msgSend, arity-indexed. objc_msgSend is an unprototyped forwarder; the
// call's real signature is asserted per use by the fn-pointer cast.
fn send(comptime R: type, recv: Id, selector: SEL) R {
    return @as(*const fn (Id, SEL) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector);
}

fn send1(comptime R: type, comptime A1: type, recv: Id, selector: SEL, a1: A1) R {
    return @as(*const fn (Id, SEL, A1) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1);
}

fn send2(comptime R: type, comptime A1: type, comptime A2: type, recv: Id, selector: SEL, a1: A1, a2: A2) R {
    return @as(*const fn (Id, SEL, A1, A2) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2);
}

fn send3(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3) R {
    return @as(*const fn (Id, SEL, A1, A2, A3) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3);
}

fn send4(comptime R: type, comptime A1: type, comptime A2: type, comptime A3: type, comptime A4: type, recv: Id, selector: SEL, a1: A1, a2: A2, a3: A3, a4: A4) R {
    return @as(*const fn (Id, SEL, A1, A2, A3, A4) callconv(.c) R, @ptrCast(&objc.objc_msgSend))(recv, selector, a1, a2, a3, a4);
}

fn cstr(title: []const u8, buf: []u8) [*:0]const u8 {
    const n = @min(title.len, buf.len - 1);
    @memcpy(buf[0..n], title[0..n]);
    buf[n] = 0;
    return @ptrCast(buf.ptr);
}

// ============================================================================
// Event mailbox — the ObjC ↔ Koru boundary. ObjC IMPs are plain C functions:
// they cannot call Koru effect arms, so they PUSH events into this ring, and
// the `frames` proc — the splice site where arms are callable — drains it and
// dispatches. Mirror of vaxis's watcher-thread + wake-pipe decoupling.
// ============================================================================

pub const KeyData = struct {
    code: u16,
    // The characters this keypress types — empty for keys that type
    // nothing (arrows, backspace, function keys; filtered at the IMP).
    // The slice points into ev_chars — valid until its slot wraps.
    chars: []const u8 = &.{},
};

pub const MouseData = struct {
    x: f64,
    y: f64,
};

// A wheel turn — dx/dy in points (line-based wheels scaled ×12, the nanoui
// convention), x/y the pointer location in top-left space so consumers can
// scope the scroll to the region under it.
pub const ScrollData = struct {
    x: f64,
    y: f64,
    dx: f64,
    dy: f64,
};

const Event = union(enum) {
    key_down: KeyData,
    mouse_down: MouseData,
    mouse_up: MouseData,
    mouse_move: MouseData,
    mouse_drag: MouseData,
    scroll: ScrollData,
};

var ev_buf: [64]Event = undefined;
// Char backing for key_down events — a ring parallel to ev_buf so a
// KeyData's chars slice stays valid after the Event is copied out.
var ev_chars: [64][16]u8 = undefined;
var ev_head: usize = 0;
var ev_tail: usize = 0;

fn pushKey(kc: u16, chars: []const u8) void {
    const next = (ev_tail + 1) % ev_buf.len;
    if (next == ev_head) return;
    const n = @min(chars.len, ev_chars[0].len);
    @memcpy(ev_chars[ev_tail][0..n], chars[0..n]);
    ev_buf[ev_tail] = .{ .key_down = .{ .code = kc, .chars = ev_chars[ev_tail][0..n] } };
    ev_tail = next;
}

fn pushEvent(e: Event) void {
    // Moves and drags coalesce onto the tail — a pointer flood must not
    // starve clicks queued behind it; only the freshest position matters.
    if (ev_tail != ev_head) {
        const last = if (ev_tail == 0) ev_buf.len - 1 else ev_tail - 1;
        switch (e) {
            .mouse_move => if (ev_buf[last] == .mouse_move) {
                ev_buf[last] = e;
                return;
            },
            .mouse_drag => if (ev_buf[last] == .mouse_drag) {
                ev_buf[last] = e;
                return;
            },
            else => {},
        }
    }
    const next = (ev_tail + 1) % ev_buf.len;
    if (next != ev_head) {
        ev_buf[ev_tail] = e;
        ev_tail = next;
    }
}

fn popEvent() ?Event {
    if (ev_head == ev_tail) return null;
    const e = ev_buf[ev_head];
    ev_head = (ev_head + 1) % ev_buf.len;
    return e;
}

var should_quit: bool = false;

// ============================================================================
// Automation verbs — synthesized input and framebuffer capture. First-class
// package surface, not test scaffolding: an agent driving a shared workspace
// injects through the SAME mailbox the ObjC IMPs write, and a snapshot reads
// the SAME drawable the encoder just presented. What automation sees and does
// is what a user's hands see and do — that equivalence is the point.
// ============================================================================

var snap_pending: bool = false;
var snap_path: [512]u8 = undefined;
var snap_len: usize = 0;

// Uncompressed 32-bit BMP — BGRA byte order, bottom-up rows. Zero deps; the
// caller converts to PNG with `sips` when it needs a portable artifact.
fn writeBmp(path: []const u8, px: []const u8, w: u32, h: u32) void {
    const row_bytes = w * 4;
    const img_bytes = row_bytes * h;
    const file_bytes = 14 + 40 + img_bytes;
    var f = std.fs.cwd().createFile(path, .{}) catch return;
    defer f.close();
    var hdr: [54]u8 = std.mem.zeroes([54]u8);
    hdr[0] = 'B';
    hdr[1] = 'M';
    std.mem.writeInt(u32, hdr[2..6], file_bytes, .little);
    std.mem.writeInt(u32, hdr[10..14], 54, .little);
    std.mem.writeInt(u32, hdr[14..18], 40, .little);
    std.mem.writeInt(u32, hdr[18..22], w, .little);
    std.mem.writeInt(u32, hdr[22..26], h, .little);
    std.mem.writeInt(u16, hdr[26..28], 1, .little);
    std.mem.writeInt(u16, hdr[28..30], 32, .little);
    std.mem.writeInt(u32, hdr[34..38], img_bytes, .little);
    f.writeAll(&hdr) catch return;
    var row: usize = h;
    while (row > 0) : (row -= 1) {
        const off = (row - 1) * row_bytes;
        f.writeAll(px[off .. off + row_bytes]) catch return;
    }
}

// Private-storage textures forbid CPU getBytes — readback is a blit copy
// into a shared-mode MTLBuffer, synced. Shared by the drawable snapshot
// and the offscreen surface's snap.
fn readbackToBmp(device: Id, queue: Id, tex: Id, path: []const u8) void {
    const tw: u64 = send(u64, tex, sel("width"));
    const th: u64 = send(u64, tex, sel("height"));
    const len: usize = @intCast(tw * th * 4);

    const mtlbuf = send2(Id, usize, u64, device, sel("newBufferWithLength:options:"), len, 0);
    const cmd = send(Id, queue, sel("commandBuffer"));
    const blit = send(Id, cmd, sel("blitCommandEncoder"));
    const Blit = *const fn (Id, SEL, Id, u64, u64, MTLOrigin, MTLSize, Id, u64, u64, u64) callconv(.c) void;
    const copy: Blit = @ptrCast(&objc.objc_msgSend);
    copy(
        blit,
        sel("copyFromTexture:sourceSlice:sourceLevel:sourceOrigin:sourceSize:toBuffer:destinationOffset:destinationBytesPerRow:destinationBytesPerImage:"),
        tex, 0, 0,
        .{ .x = 0, .y = 0, .z = 0 },
        .{ .width = tw, .height = th, .depth = 1 },
        mtlbuf, 0, tw * 4, len,
    );
    send(void, blit, sel("endEncoding"));
    send(void, cmd, sel("commit"));
    send(void, cmd, sel("waitUntilCompleted"));

    const contents: [*]u8 = @ptrCast(send(?*anyopaque, mtlbuf, sel("contents")));
    writeBmp(path, contents[0..len], @intCast(tw), @intCast(th));
    send(void, mtlbuf, sel("release"));
}

fn dumpDrawable(drawable: Id, win: *Window) void {
    const tex = send(Id, drawable, sel("texture"));
    readbackToBmp(win.device, win.queue, tex, snap_path[0..snap_len]);
}

~pub tor input.key { code: i64 }

~proc input.key|zig {
    pushKey(@intCast(code), &.{});
}

// Injects a key-down carrying typable text — the automation twin of a real
// keypress, so probes can exercise the chars path deterministically. The
// sentinel keycode 0xFFFF names no physical key.
~pub tor input.type { chars: string }

~proc input.type|zig {
    pushKey(0xFFFF, chars);
}

~pub tor input.mouse { x: f64, y: f64 }

~proc input.mouse|zig {
    pushEvent(.{ .mouse_down = .{ .x = x, .y = y } });
}

~pub tor input.move { x: f64, y: f64 }

~proc input.move|zig {
    pushEvent(.{ .mouse_move = .{ .x = x, .y = y } });
}

~pub tor input.up { x: f64, y: f64 }

~proc input.up|zig {
    pushEvent(.{ .mouse_up = .{ .x = x, .y = y } });
}

~pub tor input.drag { x: f64, y: f64 }

~proc input.drag|zig {
    pushEvent(.{ .mouse_drag = .{ .x = x, .y = y } });
}

~pub tor input.scroll { x: f64, y: f64, dx: f64, dy: f64 }

~proc input.scroll|zig {
    pushEvent(.{ .scroll = .{ .x = x, .y = y, .dx = dx, .dy = dy } });
}

// Live content size in points — locationInWindow's space. vp_w/vp_h are
// pinned at open for the shader viewport; hit-testing and layout-on-resize
// need the size NOW, not the size at open.
pub const Size = struct {
    w: f64,
    h: f64,
};

~pub tor window.size { win: *Window<opened|active> } -> koru/metal:Size

~proc window.size|zig {
    const cv = send(Id, win.win, sel("contentView"));
    const b = send(NSRect, cv, sel("bounds"));
    return .{ .w = @floatCast(b.size.width), .h = @floatCast(b.size.height) };
}

~pub tor window.snap { path: string }

~proc window.snap|zig {
    const n = @min(path.len, snap_path.len - 1);
    @memcpy(snap_path[0..n], path[0..n]);
    snap_len = n;
    snap_pending = true;
}

// ============================================================================
// Subclassing-as-a-library: KoruMetalView, an NSView subclass minted at
// runtime. IMPs are module fns that write the mailbox — they carry no Koru
// knowledge, just C ABI and a queue.
// ============================================================================

var view_class: ?objc.Class = null;

fn impKeyDown(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    const kc = send(u16, ev, sel("keyCode"));
    // The typable characters — [NSEvent characters] applies modifiers
    // (shift → "A"). Control bytes, DEL, and the private-use range AppKit
    // gives arrows/function keys (U+F700–F8FF → EF 9C..EF A3) type
    // nothing, so chars stays empty for them.
    var tmp: [16]u8 = undefined;
    var chars: []const u8 = &.{};
    const ns = send(Id, ev, sel("characters"));
    if (ns != null and CFStringGetCString(ns, &tmp, tmp.len, cf.kCFStringEncodingUTF8)) {
        const got = tmp[0..std.mem.len(@as([*:0]u8, @ptrCast(&tmp)))];
        const control = got[0] < 0x20 or got[0] == 0x7F;
        const private_use = got.len >= 3 and got[0] == 0xEF and got[1] >= 0x9C and got[1] <= 0xA3;
        if (!control and !private_use) chars = got;
    }
    pushKey(kc, chars);
}

// Window coords are bottom-left origin and include the titlebar; convert
// to the view and flip — consumers get the same top-left pixel space draw
// calls use. Shared by every pointer IMP.
fn viewPoint(recv: Id, ev: Id) MouseData {
    const pw = send(NSPoint, ev, sel("locationInWindow"));
    const pv = send2(NSPoint, NSPoint, Id, recv, sel("convertPoint:fromView:"), pw, @as(Id, null));
    const bounds = send(NSRect, recv, sel("bounds"));
    return .{ .x = pv.x, .y = bounds.size.height - pv.y };
}

fn impMouseDown(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = _s;
    pushEvent(.{ .mouse_down = viewPoint(recv, ev) });
}

fn impMouseUp(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = _s;
    pushEvent(.{ .mouse_up = viewPoint(recv, ev) });
}

fn impMouseMoved(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = _s;
    pushEvent(.{ .mouse_move = viewPoint(recv, ev) });
}

fn impMouseDragged(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = _s;
    pushEvent(.{ .mouse_drag = viewPoint(recv, ev) });
}

fn impScrollWheel(recv: Id, _s: SEL, ev: Id) callconv(.c) void {
    _ = _s;
    const p = viewPoint(recv, ev);
    var dx = send(f64, ev, sel("scrollingDeltaX"));
    var dy = send(f64, ev, sel("scrollingDeltaY"));
    // Non-precise deltas are in lines — scale to points (nanoui's ×12).
    if (!send(bool, ev, sel("hasPreciseScrollingDeltas"))) {
        dx *= 12;
        dy *= 12;
    }
    pushEvent(.{ .scroll = .{ .x = p.x, .y = p.y, .dx = dx, .dy = dy } });
}

fn impAcceptsFirstResponder(recv: Id, _s: SEL) callconv(.c) bool {
    _ = recv;
    _ = _s;
    return true;
}

// Live-resize plumbing. During an edge drag AppKit runs a modal tracking
// loop INSIDE sendEvent: — the frames loop is parked in that call, so no
// ! frame fires and the compositor stretches a stale drawable until
// mouse-up. The view's setFrameSize: IMP and NSWindowDidResizeNotification
// both fire per drag step inside the tracking loop — liveDraw dedupes them
// by dims so each step renders once. The consumer's `! frame` body rides
// frame_cb, installed when `frames` starts; live_win is the open Window.
var live_win: ?*Window = null;
var frame_cb: ?*const fn (*Frame) void = null;
var in_live_resize: bool = false;

fn syncSurfaceSize(win: *Window) void {
    const cv = send(Id, win.win, sel("contentView"));
    const cb = send(NSRect, cv, sel("bounds"));
    win.vp_w = @floatCast(cb.size.width);
    win.vp_h = @floatCast(cb.size.height);
    const bs = send(f64, win.win, sel("backingScaleFactor"));
    // contentsScale must track the display's backingScaleFactor — left at
    // the 1.0 default, CA allocates bounds×1 backing and RESAMPLES our
    // 2× drawable into it: every edge re-rasterizes per frame = shimmer
    // on all static geometry, independent of layout.
    const cs = send(f64, win.layer, sel("contentsScale"));
    if (cs != bs) send1(void, f64, win.layer, sel("setContentsScale:"), bs);
    const cur = send(NSSize, win.layer, sel("drawableSize"));
    // Integral pixels only — fractional-point bounds during a live drag
    // would hand setDrawableSize sizes it truncates differently per step:
    // a ±1px compositor stretch oscillation.
    const dw = @round(cb.size.width * bs);
    const dh = @round(cb.size.height * bs);
    if (cur.width != dw or cur.height != dh) {
        send1(void, NSSize, win.layer, sel("setDrawableSize:"), .{ .width = dw, .height = dh });
    }
}

fn drawLiveFrame(win: *Window, cb: *const fn (*Frame) void) void {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    const drawable = send(Id, win.layer, sel("nextDrawable"));
    if (drawable == null) return;
    const desc = send(Id, cls("MTLRenderPassDescriptor"), sel("renderPassDescriptor"));
    const atts = send(Id, desc, sel("colorAttachments"));
    const att = send1(Id, u64, atts, sel("objectAtIndexedSubscript:"), 0);
    const tex = send(Id, drawable, sel("texture"));
    send1(void, Id, att, sel("setTexture:"), tex);
    send1(void, u64, att, sel("setLoadAction:"), 2); // MTLLoadActionClear
    send1(void, u64, att, sel("setStoreAction:"), 1); // MTLStoreActionStore
    send1(void, MTLClearColor, att, sel("setClearColor:"), win.clear);
    const buf = send(Id, win.queue, sel("commandBuffer"));
    const enc = send1(Id, Id, buf, sel("renderCommandEncoderWithDescriptor:"), desc);
    send1(void, Id, enc, sel("setRenderPipelineState:"), win.pso);
    win.flushed = 0;
    var f = Frame{ .encoder = enc, .device = win.device, .pso = win.pso, .pso_rect = win.pso_rect, .pso_inst = win.pso_inst, .vp_w = win.vp_w, .vp_h = win.vp_h, .insts = &win.insts, .flushed = &win.flushed, .clip_stack = undefined, .clip_depth = 0, .text = &win.text, .images = &win.images };
    win.text.beginFrame();
    win.images.beginFrame();
    cb(&f);
    instFlush(&f);
    send(void, enc, sel("endEncoding"));
    if (in_live_resize) {
        // The Zed/gpui ordering under presentsWithTransaction: commit the
        // buffer, waitUntilScheduled bounds the wait to GPU scheduling (NOT
        // the commit), then the drawable presents directly — it lands with
        // the current CATransaction commit, atomically with the bounds
        // change. Unlike buf presentDrawable:+commit, the drawable is not
        // parked waiting on a commit that may never come — so the pool
        // doesn't drain and the event pump keeps breathing.
        send(void, buf, sel("commit"));
        send(void, buf, sel("waitUntilScheduled"));
        send(void, drawable, sel("present"));
    } else {
        send1(void, Id, buf, sel("presentDrawable:"), drawable);
        send(void, buf, sel("commit"));
    }
}

// One draw per dims change: setFrameSize: AND the resize notification
// both fire per drag step at the same dims — dedupe by vp size so each
// step renders once, not twice.
fn liveDraw(win: *Window, cb: *const fn (*Frame) void) void {
    syncSurfaceSize(win);
    if (win.lr_w == win.vp_w and win.lr_h == win.vp_h) return;
    win.lr_w = win.vp_w;
    win.lr_h = win.vp_h;
    drawLiveFrame(win, cb);
}

fn impWindowResized(recv: Id, _s: SEL, note: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = note;
    const win = live_win orelse return;
    const cb = frame_cb orelse return;
    liveDraw(win, cb);
}

// During a live drag AppKit calls setFrameSize: on the content view
// synchronously per step, while a CATransaction is still open — drawing
// here with the drawable.present() path puts our frame into the SAME
// commit as the bounds change (see drawLiveFrame), so no mismatched
// intermediate reaches the screen.
var orig_setFrameSize: ?*const fn (Id, SEL, NSSize) callconv(.c) void = null;

fn impSetFrameSize(recv: Id, _s: SEL, size: NSSize) callconv(.c) void {
    if (orig_setFrameSize) |orig| orig(recv, _s, size);
    const win = live_win orelse return;
    const cb = frame_cb orelse return;
    liveDraw(win, cb);
}

// Live-resize brackets: PwT goes ON only inside the drag, where every
// draw happens inside an open CATransaction — the drawable.present()
// path lands each frame atomically with the bounds commit. Outside the
// drag it stays OFF: transaction-pinned presents in the frames loop
// starve the drawable pool and throttle the event pump.
fn impLiveStart(recv: Id, _s: SEL, note: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = note;
    const win = live_win orelse return;
    in_live_resize = true;
    win.lr_w = -1;
    send1(void, bool, win.layer, sel("setPresentsWithTransaction:"), true);
}

// The flag drops AFTER the final draw so that frame lands in the closing
// transaction; from then on presents are immediate again and the pool
// can't be held hostage by queued transaction-pinned presents.
fn impLiveEnd(recv: Id, _s: SEL, note: Id) callconv(.c) void {
    _ = recv;
    _ = _s;
    _ = note;
    const win = live_win orelse return;
    const cb = frame_cb orelse return;
    win.lr_w = -1;
    // Final frame BEFORE the flag drops: the end-of-resize transaction is
    // still open, so this present lands in the closing commit.
    liveDraw(win, cb);
    in_live_resize = false;
    send1(void, bool, win.layer, sel("setPresentsWithTransaction:"), false);
}

fn ensureViewClass() ?objc.Class {
    if (view_class) |c| return c;
    const sup: objc.Class = @ptrCast(cls("NSView"));
    const c = objc.objc_allocateClassPair(sup, "KoruMetalView", 0) orelse return null;
    _ = objc.class_addMethod(c, sel("keyDown:"), @ptrCast(&impKeyDown), "v@:@");
    _ = objc.class_addMethod(c, sel("mouseDown:"), @ptrCast(&impMouseDown), "v@:@");
    _ = objc.class_addMethod(c, sel("mouseUp:"), @ptrCast(&impMouseUp), "v@:@");
    _ = objc.class_addMethod(c, sel("mouseMoved:"), @ptrCast(&impMouseMoved), "v@:@");
    _ = objc.class_addMethod(c, sel("mouseDragged:"), @ptrCast(&impMouseDragged), "v@:@");
    _ = objc.class_addMethod(c, sel("scrollWheel:"), @ptrCast(&impScrollWheel), "v@:@");
    _ = objc.class_addMethod(c, sel("acceptsFirstResponder"), @ptrCast(&impAcceptsFirstResponder), "B@:");
    _ = objc.class_addMethod(c, sel("windowResized:"), @ptrCast(&impWindowResized), "v@:@");
    const orig_ss = objc.class_getMethodImplementation(sup, sel("setFrameSize:"));
    orig_setFrameSize = @ptrCast(orig_ss);
    _ = objc.class_addMethod(c, sel("setFrameSize:"), @ptrCast(&impSetFrameSize), "v@:{_NSSize=dd}");
    _ = objc.class_addMethod(c, sel("liveStart:"), @ptrCast(&impLiveStart), "v@:@");
    _ = objc.class_addMethod(c, sel("liveEnd:"), @ptrCast(&impLiveEnd), "v@:@");
    objc.objc_registerClassPair(c);
    view_class = c;
    return c;
}

// ============================================================================
// Window lifecycle — the ASYMMETRIC model, same shape as raylib's:
//   opened — fresh from window.open, never rendered. No disposer accepts it.
//   active — has presented at least one frame.
//   closed — window.close accepts ONLY <!active>.
// ============================================================================

// The ObjC objects a live window needs every frame, carried in one token.
pub const Window = struct {
    app: Id,
    win: Id,
    layer: Id,
    device: Id,
    queue: Id,
    pso: Id,
    pso_rect: Id,
    pso_inst: Id,
    vp_w: f32,
    vp_h: f32,
    lr_w: f32,
    lr_h: f32,
    clear: MTLClearColor,
    insts: std.ArrayList(GpuInstance),
    flushed: usize,
    text: TextSystem,
    images: ImageAtlas,
};

// A frame in flight — carries the LIVE render encoder, so draw calls inside
// `! frame` record into the pass the engine ends, presents and commits after
// the body returns. Pipeline states and viewport ride along so draw tors
// stay one-borrow calls. `insts` points at the window's persistent instance
// list; the clip stack is per-frame — a clip pushed inside `! frame` ends
// with the frame.
pub const Frame = struct {
    encoder: Id,
    device: Id,
    pso: Id,
    pso_rect: Id,
    pso_inst: Id,
    vp_w: f32,
    vp_h: f32,
    insts: *std.ArrayList(GpuInstance),
    // Running count of instances flushed this frame — the owner (window or
    // surface) resets it per frame; offscreen.frame returns it as `insts`.
    flushed: *usize,
    clip_stack: [16][4]f32,
    clip_depth: u8,
    text: *TextSystem,
    images: *ImageAtlas,
};

// Pipeline: compile the MSL source, wire the descriptors, build the three
// states. Shared by window.open and offscreen.open — identical shader
// program, pixel format 80, and blend settings. The base `pso` keeps NO
// blending; rect and inst blend source 4 / destination 5 / alpha 1,5.
fn buildPipelines(device: Id) error{
    ShaderLib,
    ShaderFns,
    Pso,
    RectFns,
    RectPso,
    InstFns,
    InstPso,
}!struct { pso: Id, pso_rect: Id, pso_inst: Id } {
    const srcStr = cf.CFStringCreateWithCString(null, msl_src.ptr, cf.kCFStringEncodingUTF8);
    var shaderErr: Id = null;
    const lib = send3(Id, Id, Id, *Id, device, sel("newLibraryWithSource:options:error:"), @as(Id, @ptrCast(@constCast(srcStr))), @as(Id, null), &shaderErr);
    if (lib == null) {
        if (shaderErr) |e| {
            const d = send(Id, e, sel("localizedDescription"));
            const cstr_ = cf.CFStringGetCStringPtr(@ptrCast(d), cf.kCFStringEncodingUTF8);
            if (cstr_ != null) std.debug.print("metal: shader error: {s}\n", .{std.mem.span(cstr_)});
        }
        return error.ShaderLib;
    }

    const vname = cf.CFStringCreateWithCString(null, "vertex_main", cf.kCFStringEncodingUTF8);
    const fname = cf.CFStringCreateWithCString(null, "fragment_main", cf.kCFStringEncodingUTF8);
    const vfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(vname))));
    const ffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(fname))));
    if (vfn == null or ffn == null) {
        return error.ShaderFns;
    }

    const pdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, pdesc, sel("setVertexFunction:"), vfn);
    send1(void, Id, pdesc, sel("setFragmentFunction:"), ffn);
    const patts = send(Id, pdesc, sel("colorAttachments"));
    const patt = send1(Id, u64, patts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, patt, sel("setPixelFormat:"), 80); // match the layer

    var psoErr: Id = null;
    const pso = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), pdesc, &psoErr);
    if (pso == null) {
        return error.Pso;
    }

    // Second pipeline, same library: the rect pair. Per-draw params ride
    // through [[buffer(0)]] — no vertex buffer, no descriptor changes.
    const rvname = cf.CFStringCreateWithCString(null, "rect_vertex", cf.kCFStringEncodingUTF8);
    const rfname = cf.CFStringCreateWithCString(null, "rect_fragment", cf.kCFStringEncodingUTF8);
    const rvfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(rvname))));
    const rffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(rfname))));
    if (rvfn == null or rffn == null) {
        return error.RectFns;
    }
    const rpdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, rpdesc, sel("setVertexFunction:"), rvfn);
    send1(void, Id, rpdesc, sel("setFragmentFunction:"), rffn);
    const rpatts = send(Id, rpdesc, sel("colorAttachments"));
    const rpatt = send1(Id, u64, rpatts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, rpatt, sel("setPixelFormat:"), 80);
    send1(void, bool, rpatt, sel("setBlendingEnabled:"), true);
    send1(void, u64, rpatt, sel("setSourceRGBBlendFactor:"), 4);
    send1(void, u64, rpatt, sel("setDestinationRGBBlendFactor:"), 5);
    send1(void, u64, rpatt, sel("setSourceAlphaBlendFactor:"), 1);
    send1(void, u64, rpatt, sel("setDestinationAlphaBlendFactor:"), 5);
    var rpsoErr: Id = null;
    const pso_rect = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), rpdesc, &rpsoErr);
    if (pso_rect == null) {
        return error.RectPso;
    }

    // Third pipeline: the instanced quad vocabulary — one instanced draw
    // per run of recorded instances (nanoui's model). Same blend as the
    // rect pipeline.
    const ivname = cf.CFStringCreateWithCString(null, "inst_vertex", cf.kCFStringEncodingUTF8);
    const ifname = cf.CFStringCreateWithCString(null, "inst_fragment", cf.kCFStringEncodingUTF8);
    const ivfn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(ivname))));
    const iffn = send1(Id, Id, lib, sel("newFunctionWithName:"), @as(Id, @ptrCast(@constCast(ifname))));
    if (ivfn == null or iffn == null) {
        return error.InstFns;
    }
    const ipdesc = send(Id, cls("MTLRenderPipelineDescriptor"), sel("new"));
    send1(void, Id, ipdesc, sel("setVertexFunction:"), ivfn);
    send1(void, Id, ipdesc, sel("setFragmentFunction:"), iffn);
    const ipatts = send(Id, ipdesc, sel("colorAttachments"));
    const ipatt = send1(Id, u64, ipatts, sel("objectAtIndexedSubscript:"), 0);
    send1(void, u64, ipatt, sel("setPixelFormat:"), 80);
    send1(void, bool, ipatt, sel("setBlendingEnabled:"), true);
    send1(void, u64, ipatt, sel("setSourceRGBBlendFactor:"), 4);
    send1(void, u64, ipatt, sel("setDestinationRGBBlendFactor:"), 5);
    send1(void, u64, ipatt, sel("setSourceAlphaBlendFactor:"), 1);
    send1(void, u64, ipatt, sel("setDestinationAlphaBlendFactor:"), 5);
    var ipsoErr: Id = null;
    const pso_inst = send2(Id, Id, *Id, device, sel("newRenderPipelineStateWithDescriptor:error:"), ipdesc, &ipsoErr);
    if (pso_inst == null) {
        return error.InstPso;
    }

    return .{ .pso = pso, .pso_rect = pso_rect, .pso_inst = pso_inst };
}

~pub tor window.open { width: i32, height: i32, title: string }
| win *Window<opened!>
| err string

~proc window.open|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);

    const app = send(Id, cls("NSApplication"), sel("sharedApplication"));
    _ = send1(bool, i64, app, sel("setActivationPolicy:"), 0);
    send(void, app, sel("finishLaunching"));

    const rect = NSRect{
        .origin = .{ .x = 0, .y = 0 },
        .size = .{ .width = @floatFromInt(width), .height = @floatFromInt(height) },
    };
    const wobj = send4(
        Id, NSRect, u64, u64, bool,
        send(Id, cls("NSWindow"), sel("alloc")),
        sel("initWithContentRect:styleMask:backing:defer:"),
        rect, 15, 2, false,
    );
    if (wobj == null) {
        return .{ .err = "metal: NSWindow init failed" };
    }

    var tbuf: [256]u8 = undefined;
    const titleStr = cf.CFStringCreateWithCString(null, cstr(title, &tbuf), cf.kCFStringEncodingUTF8);
    send1(void, Id, wobj, sel("setTitle:"), @as(Id, @ptrCast(@constCast(titleStr))));
    // mouseMoved: delivery is opt-in; hover state depends on it.
    send1(void, bool, wobj, sel("setAcceptsMouseMovedEvents:"), true);

    // Do NOT preserve content during live resize — "preserve" is the
    // window server stretching the previous surface onto each new step.
    // We draw a correctly-sized frame per step in setFrameSize:, so a
    // stretched intermediate is pure artifact: static geometry appears to
    // shift then snap back each step.
    send1(void, bool, wobj, sel("setPreservesContentDuringLiveResize:"), false);

    const device = MTLCreateSystemDefaultDevice();
    if (device == null) {
        return .{ .err = "metal: MTLCreateSystemDefaultDevice returned null" };
    }

    const layer = send(Id, cls("CAMetalLayer"), sel("layer"));
    send1(void, Id, layer, sel("setDevice:"), device);
    send1(void, u64, layer, sel("setPixelFormat:"), 80); // MTLPixelFormatBGRA8Unorm
    // presentsWithTransaction stays OFF here — it's flipped on only during
    // live resize (impLiveStart/impLiveEnd), where every draw sits inside
    // an open CATransaction. On at all times, presents outside a
    // transaction (the frames loop) queue for commits that rarely come:
    // the drawable pool fills, nextDrawable blocks, everything grays out.
    // contentsScale + drawableSize in BACKING pixels from the start —
    // drawableSize is pixels, not points.
    const bs0 = send(f64, wobj, sel("backingScaleFactor"));
    send1(void, f64, layer, sel("setContentsScale:"), bs0);
    // Pin content top-left: CAMetalLayer's default gravity stretches its
    // content to fill new bounds on every resize step — the "texture
    // resized then repainted" artifact. topLeft keeps static geometry
    // anchored; only the growing edge can show a brief unpainted strip.
    const grav = cf.CFStringCreateWithCString(null, "topLeft", cf.kCFStringEncodingUTF8);
    send1(void, Id, layer, sel("setContentsGravity:"), @as(Id, @ptrCast(@constCast(grav))));
    send1(void, NSSize, layer, sel("setDrawableSize:"), NSSize{
        .width = @as(f64, @floatFromInt(width)) * bs0,
        .height = @as(f64, @floatFromInt(height)) * bs0,
    });

    // Our own NSView subclass carries the responder IMPs — it becomes the
    // content view AND first responder so key/mouse events route to us.
    const view_cls = ensureViewClass() orelse {
        return .{ .err = "metal: KoruMetalView class registration failed" };
    };
    const view = send1(
        Id, NSRect,
        send(Id, @as(Id, @ptrCast(view_cls)), sel("alloc")),
        sel("initWithFrame:"), rect,
    );
    send1(void, Id, wobj, sel("setContentView:"), view);
    send1(void, Id, view, sel("setLayer:"), layer);
    send1(void, bool, view, sel("setWantsLayer:"), true);

    const queue = send(Id, device, sel("newCommandQueue"));
    if (queue == null) {
        return .{ .err = "metal: newCommandQueue returned null" };
    }

    const pipes = buildPipelines(device) catch |e| {
        return .{ .err = switch (e) {
            error.ShaderLib => "metal: shader library compile failed",
            error.ShaderFns => "metal: shader functions not found in library",
            error.Pso => "metal: render pipeline state creation failed",
            error.RectFns => "metal: rect shader functions not found in library",
            error.RectPso => "metal: rect pipeline state creation failed",
            error.InstFns => "metal: inst shader functions not found in library",
            error.InstPso => "metal: inst pipeline state creation failed",
        } };
    };

    // We own the release: releasedWhenClosed (default YES) frees wobj the
    // moment the user hits the close button, leaving win.win dangling for
    // the `| done` -> window.close path to message. NO keeps the object
    // alive; window.close sends the matching release.
    send1(void, bool, wobj, sel("setReleasedWhenClosed:"), false);

    send1(void, Id, wobj, sel("makeKeyAndOrderFront:"), @as(Id, null));
    send1(void, bool, app, sel("activateIgnoringOtherApps:"), true);
    // First responder only sticks on an onscreen window — ordering in resets
    // it, so this must come after orderFront, not beside content-view setup.
    _ = send1(bool, Id, wobj, sel("makeFirstResponder:"), view);

    // Resize notifications post per drag step of a live resize — the view
    // observes them so impWindowResized can draw inside AppKit's tracking
    // loop instead of stretching until mouse-up.
    const nc = send(Id, cls("NSNotificationCenter"), sel("defaultCenter"));
    send4(void, Id, SEL, Id, Id, nc, sel("addObserver:selector:name:object:"),
        view, sel("windowResized:"), NSWindowDidResizeNotification, wobj);
    send4(void, Id, SEL, Id, Id, nc, sel("addObserver:selector:name:object:"),
        view, sel("liveStart:"), NSWindowWillStartLiveResizeNotification, wobj);
    send4(void, Id, SEL, Id, Id, nc, sel("addObserver:selector:name:object:"),
        view, sel("liveEnd:"), NSWindowDidEndLiveResizeNotification, wobj);

    const w = std.heap.page_allocator.create(Window) catch @panic("metal: OOM allocating Window token");
    w.* = Window{
        .app = app,
        .win = wobj,
        .layer = layer,
        .device = device,
        .queue = queue,
        .pso = pipes.pso,
        .pso_rect = pipes.pso_rect,
        .pso_inst = pipes.pso_inst,
        .vp_w = @floatFromInt(width),
        .vp_h = @floatFromInt(height),
        .lr_w = -1,
        .lr_h = -1,
        .clear = .{ .red = 0.1, .green = 0.1, .blue = 0.15, .alpha = 1.0 },
        .insts = .empty,
        .flushed = 0,
        .text = .init(device, @floatCast(bs0)),
        .images = .init(device),
    };
    live_win = w;
    return .{ .win = w };
}

// The frame loop — the `opened -> active` transition, same bracket shape as
// raylib's: the engine acquires the drawable, builds the render pass, hands
// the user a *Frame borrow for pass configuration, then ends, presents and
// commits around the body. `! frame` fires once per frame; `count` bounds
// the loop so tests halt.
//
// Callbacks as effect branches, the vaxis shape: ObjC IMPs cannot call Koru
// arms, so they push into the mailbox while sendEvent runs; the loop drains
// it here — the splice site where arms are callable — and fires the
// optional `! ?` arms. Unbound optional arms are generated no-ops. `! close`
// fires when the window closed (isVisible polled — no delegate needed; the
// default close button just closes); quit() breaks the loop.
~pub tor frames { win: *Window<!opened|!active>, count: ?i32 }
! frame *Frame<frame!>
! ?key-down koru/metal:KeyData
! ?mouse-down koru/metal:MouseData
! ?mouse-up koru/metal:MouseData
! ?mouse-move koru/metal:MouseData
! ?mouse-drag koru/metal:MouseData
! ?scroll koru/metal:ScrollData
! ?close
| done *Window<active!>

~proc frames|zig {
    const __cap = @as(?i32, count) orelse 2147483647;
    // Live-resize path: during an edge drag this loop is parked inside
    // sendEvent:, so the windowResized: IMP draws through frame_cb instead.
    $mod.frame_cb = frame;
    var i: i32 = 0;
    while (i < __cap) : (i += 1) {
        const pool = $mod.objc_autoreleasePoolPush();
        defer $mod.objc_autoreleasePoolPop(pool);

        // Pump pending AppKit events so the window tracks, closes, repaints.
        // sendEvent dispatches to our view's IMPs, which push the mailbox.
        while (true) {
            const ev = $mod.send4(
                $mod.Id, u64, $mod.Id, $mod.Id, bool,
                win.app,
                $mod.sel("nextEventMatchingMask:untilDate:inMode:dequeue:"),
                $mod.std.math.maxInt(u64), @as($mod.Id, null), $mod.NSDefaultRunLoopMode, true,
            );
            if (ev == null) break;
            $mod.send1(void, $mod.Id, win.app, $mod.sel("sendEvent:"), ev);
        }
        $mod.send(void, win.app, $mod.sel("updateWindows"));

        // Mailbox -> effect arms, the dispatch site.
        while ($mod.popEvent()) |mev| {
            switch (mev) {
                .key_down => |k| key_down(k),
                .mouse_down => |m| mouse_down(m),
                .mouse_up => |m| mouse_up(m),
                .mouse_move => |m| mouse_move(m),
                .mouse_drag => |m| mouse_drag(m),
                .scroll => |s| scroll(s),
            }
        }
        if ($mod.should_quit) break;
        if (!$mod.send(bool, win.win, $mod.sel("isVisible"))) {
            close();
            break;
        }

        // Track the live size every iteration: vp is layout points so the
        // shader maps 1:1 (no stretch), drawableSize is pixels so the
        // layer reallocates instead of letting the compositor scale a
        // stale surface. Both derive from contentView bounds.
        $mod.syncSurfaceSize(win);

        const drawable = $mod.send($mod.Id, win.layer, $mod.sel("nextDrawable"));
        if (drawable == null) break; // window closed or invisible

        const desc = $mod.send($mod.Id, $mod.cls("MTLRenderPassDescriptor"), $mod.sel("renderPassDescriptor"));
        const atts = $mod.send($mod.Id, desc, $mod.sel("colorAttachments"));
        const att = $mod.send1($mod.Id, u64, atts, $mod.sel("objectAtIndexedSubscript:"), 0);
        const tex = $mod.send($mod.Id, drawable, $mod.sel("texture"));
        $mod.send1(void, $mod.Id, att, $mod.sel("setTexture:"), tex);
        $mod.send1(void, u64, att, $mod.sel("setLoadAction:"), 2); // MTLLoadActionClear
        $mod.send1(void, u64, att, $mod.sel("setStoreAction:"), 1); // MTLStoreActionStore
        $mod.send1(void, $mod.MTLClearColor, att, $mod.sel("setClearColor:"), win.clear);

        // The encoder exists BEFORE the frame body: the `! frame` body records
        // draws into a live pass, then the engine ends, presents, commits.
        const buf = $mod.send($mod.Id, win.queue, $mod.sel("commandBuffer"));
        const enc = $mod.send1($mod.Id, $mod.Id, buf, $mod.sel("renderCommandEncoderWithDescriptor:"), desc);
        $mod.send1(void, $mod.Id, enc, $mod.sel("setRenderPipelineState:"), win.pso);

        win.flushed = 0;
        var __f = $mod.Frame{ .encoder = enc, .device = win.device, .pso = win.pso, .pso_rect = win.pso_rect, .pso_inst = win.pso_inst, .vp_w = win.vp_w, .vp_h = win.vp_h, .insts = &win.insts, .flushed = &win.flushed, .clip_stack = undefined, .clip_depth = 0, .text = &win.text, .images = &win.images };
        win.text.beginFrame();
        win.images.beginFrame();
        frame(&__f);

        $mod.instFlush(&__f);
        $mod.send(void, enc, $mod.sel("endEncoding"));
        $mod.send1(void, $mod.Id, buf, $mod.sel("presentDrawable:"), drawable);
        $mod.send(void, buf, $mod.sel("commit"));
        // A snapshot request issued inside the frame body is serviced here —
        // same iteration, after commit, while the drawable is still ours.
        if ($mod.snap_pending) {
            $mod.snap_pending = false;
            $mod.dumpDrawable(drawable, win);
        }

        $mod.std.Thread.sleep(16 * $mod.std.time.ns_per_ms);
    }
    return .{ .done = win };
}

// No-op consumer of the per-frame borrow — auto-inserted release, mirror of
// raylib's release.frame.
~pub tor release.frame { f: *Frame<!frame> }
~proc release.frame|zig { _ = &f; }

~pub tor window.close { win: *Window<!active> }

~proc window.close|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);
    send(void, win.win, sel("close"));
    send(void, win.win, sel("release"));
    win.insts.deinit(std.heap.page_allocator);
    win.text.deinit();
    win.images.deinit();
    std.heap.page_allocator.destroy(win);
}

// ============================================================================
// Clear color — a WINDOW property, not a draw call. Metal reads the pass
// descriptor's clearColor at encoder creation, so a `draw.clear` inside the
// frame body would be a silent no-op by construction. Setting it here, as a
// borrow (same shape as raylib's window.fps), keeps the semantic honest: the
// stored color is applied to every frame's attachment.
// ============================================================================

~pub tor window.clear.color { win: *Window<opened|active>, r: f32, g: f32, b: f32 }

~proc window.clear.color|zig {
    win.clear = .{ .red = r, .green = g, .blue = b, .alpha = 1.0 };
}

// ============================================================================
// Offscreen surface — the window's render path minus the window. Same device,
// same three pipelines, same instanced draw vocabulary, same readback — the
// only difference is the render target is a Private-storage texture instead
// of a drawable, so nothing touches AppKit or the screen. Exists so headless
// binaries can run the real paint path (draw.* -> instPush -> instFlush ->
// commit -> waitUntilCompleted) under a benchmark, the nanoui Tester model.
// ============================================================================

pub const Surface = struct {
    device: Id,
    queue: Id,
    tex: Id,
    pso: Id,
    pso_rect: Id,
    pso_inst: Id,
    vp_w: f32,
    vp_h: f32,
    clear: MTLClearColor,
    insts: std.ArrayList(GpuInstance),
    flushed: usize,
    text: TextSystem,
    images: ImageAtlas,
    // The last committed command buffer, retained — offscreen.wait reads its
    // GPU timestamps. null until the first frame commits.
    last: Id,
};

~pub tor offscreen.open { width: i32, height: i32, scale: f64 }
| surf *Surface<ready!>
| err string

~proc offscreen.open|zig {
    const device = MTLCreateSystemDefaultDevice();
    if (device == null) {
        return .{ .err = "metal: MTLCreateSystemDefaultDevice returned null" };
    }
    const queue = send(Id, device, sel("newCommandQueue"));
    if (queue == null) {
        return .{ .err = "metal: newCommandQueue returned null" };
    }
    const pipes = buildPipelines(device) catch |e| {
        return .{ .err = switch (e) {
            error.ShaderLib => "metal: shader library compile failed",
            error.ShaderFns => "metal: shader functions not found in library",
            error.Pso => "metal: render pipeline state creation failed",
            error.RectFns => "metal: rect shader functions not found in library",
            error.RectPso => "metal: rect pipeline state creation failed",
            error.InstFns => "metal: inst shader functions not found in library",
            error.InstPso => "metal: inst pipeline state creation failed",
        } };
    };

    // Render target: a real texture in Private storage, the same pixel
    // format the layer uses (80 = BGRA8Unorm), sized in BACKING pixels —
    // points x scale, matching the window's drawableSize. ShaderRead lets
    // the blit readback (and any future sample) reach it.
    const desc = send4(
        Id, u64, u64, u64, bool,
        cls("MTLTextureDescriptor"),
        sel("texture2DDescriptorWithPixelFormat:width:height:mipmapped:"),
        80,
        @intFromFloat(@as(f64, @floatFromInt(width)) * scale),
        @intFromFloat(@as(f64, @floatFromInt(height)) * scale),
        false,
    );
    send1(void, u64, desc, sel("setUsage:"), 4 | 1); // RenderTarget|ShaderRead
    send1(void, u64, desc, sel("setStorageMode:"), 2); // Private
    const tex = send1(Id, Id, device, sel("newTextureWithDescriptor:"), desc);
    if (tex == null) {
        return .{ .err = "metal: offscreen render target creation failed" };
    }

    const s = std.heap.page_allocator.create(Surface) catch @panic("metal: OOM allocating Surface token");
    s.* = Surface{
        .device = device,
        .queue = queue,
        .tex = tex,
        .pso = pipes.pso,
        .pso_rect = pipes.pso_rect,
        .pso_inst = pipes.pso_inst,
        .vp_w = @floatFromInt(width),
        .vp_h = @floatFromInt(height),
        .clear = .{ .red = 0.1, .green = 0.1, .blue = 0.15, .alpha = 1.0 },
        .insts = .empty,
        .flushed = 0,
        .text = .init(device, @floatCast(scale)),
        .images = .init(device),
        .last = null,
    };
    return .{ .surf = s };
}

// Same semantic as window.clear.color: a surface property read at pass
// descriptor creation, applied to every frame's attachment.
~pub tor offscreen.clear.color { s: *Surface<ready>, r: f32, g: f32, b: f32 }

~proc offscreen.clear.color|zig {
    s.clear = .{ .red = r, .green = g, .blue = b, .alpha = 1.0 };
}

// One headless frame — the `frames` per-frame block minus drawable, present,
// and the 16ms pump sleep: build the pass on s.tex, hand `! frame` a live
// encoder, flush, end, commit. The command buffer is retained in s.last so
// offscreen.wait can read GPU timestamps; nothing waits here — a benchmark
// measures encode (CPU) and wait (GPU) as separate laps.
~pub tor offscreen.frame { s: *Surface<ready> }
! frame *Frame<frame!>
| done i64

~proc offscreen.frame|zig {
    const pool = $mod.objc_autoreleasePoolPush();
    defer $mod.objc_autoreleasePoolPop(pool);

    const desc = $mod.send($mod.Id, $mod.cls("MTLRenderPassDescriptor"), $mod.sel("renderPassDescriptor"));
    const atts = $mod.send($mod.Id, desc, $mod.sel("colorAttachments"));
    const att = $mod.send1($mod.Id, u64, atts, $mod.sel("objectAtIndexedSubscript:"), 0);
    $mod.send1(void, $mod.Id, att, $mod.sel("setTexture:"), s.tex);
    $mod.send1(void, u64, att, $mod.sel("setLoadAction:"), 2); // MTLLoadActionClear
    $mod.send1(void, u64, att, $mod.sel("setStoreAction:"), 1); // MTLStoreActionStore
    $mod.send1(void, $mod.MTLClearColor, att, $mod.sel("setClearColor:"), s.clear);

    const buf = $mod.send($mod.Id, s.queue, $mod.sel("commandBuffer"));
    const enc = $mod.send1($mod.Id, $mod.Id, buf, $mod.sel("renderCommandEncoderWithDescriptor:"), desc);
    $mod.send1(void, $mod.Id, enc, $mod.sel("setRenderPipelineState:"), s.pso);

    s.flushed = 0;
    var __f = $mod.Frame{ .encoder = enc, .device = s.device, .pso = s.pso, .pso_rect = s.pso_rect, .pso_inst = s.pso_inst, .vp_w = s.vp_w, .vp_h = s.vp_h, .insts = &s.insts, .flushed = &s.flushed, .clip_stack = undefined, .clip_depth = 0, .text = &s.text, .images = &s.images };
    s.text.beginFrame();
    s.images.beginFrame();
    frame(&__f);

    $mod.instFlush(&__f);
    $mod.send(void, enc, $mod.sel("endEncoding"));
    $mod.send(void, buf, $mod.sel("commit"));
    if (s.last != null) $mod.send(void, s.last, $mod.sel("release"));
    s.last = $mod.send($mod.Id, buf, $mod.sel("retain"));
    return .{ .done = @intCast(s.flushed) };
}

// GPU-side duration of the last committed frame — GPUStart/EndTime on the
// retained command buffer, in ms. Commit-wait here, NOT in offscreen.frame,
// keeps the encode lap honest.
~pub tor offscreen.wait { s: *Surface<ready> } -> f64

~proc offscreen.wait|zig {
    if (s.last == null) @panic("metal: offscreen.wait: no frame committed");
    send(void, s.last, sel("waitUntilCompleted"));
    const t0 = send(f64, s.last, sel("GPUStartTime"));
    const t1 = send(f64, s.last, sel("GPUEndTime"));
    return (t1 - t0) * 1000.0;
}

// Pixel gate: wait for the GPU to finish, then blit the render target into a
// shared buffer and write the BMP — identical readback to the window path.
~pub tor offscreen.snap { s: *Surface<ready>, path: string }

~proc offscreen.snap|zig {
    if (s.last == null) @panic("metal: offscreen.snap: no frame committed");
    send(void, s.last, sel("waitUntilCompleted"));
    readbackToBmp(s.device, s.queue, s.tex, path);
}

~pub tor offscreen.close { s: *Surface<!ready> }

~proc offscreen.close|zig {
    if (s.last != null) send(void, s.last, sel("release"));
    send(void, s.tex, sel("release"));
    s.insts.deinit(std.heap.page_allocator);
    s.text.deinit();
    s.images.deinit();
    std.heap.page_allocator.destroy(s);
}

// ============================================================================
// Drawing — every draw call borrows the frame handle, so it can only appear
// inside a `! frame` body, where it records into the live render encoder.
// ============================================================================

~pub tor draw.triangle { f: *Frame<frame> }

~proc draw.triangle|zig {
    instFlush(f);
    send1(void, Id, f.encoder, sel("setRenderPipelineState:"), f.pso);
    send3(void, u64, u64, u64, f.encoder, sel("drawPrimitives:vertexStart:vertexCount:"), 3, 0, 3);
}

// One colored quad in PIXEL space — the first real draw surface. The shader
// reads RectParams through [[buffer(0)]] (setVertexBytes) and maps
// pixel→NDC against the viewport the window opened with. Y is screen-space:
// row 0 at the top.
~pub tor draw.rect { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.rect|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = 0,
        .border_width = 0,
        .kind = inst_quad,
        .clip_round = 0,
    });
}

// A rounded-rect fill — same quad, SDF corners. `radius` is clamped to the
// half-extents in the fragment.
~pub tor draw.roundrect { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.roundrect|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = @floatCast(radius),
        .border_width = 0,
        .kind = inst_quad,
        .clip_round = 0,
    });
}

// A rounded rect carrying fill AND border in one instance — the panel
// primitive. `bw` is the border thickness in points; the border color is
// ignored (and the border skipped) when bw is 0.
~pub tor draw.panel { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, r: f64, g: f64, b: f64, a: f64, bw: f64, br: f64, bg: f64, bb: f64, ba: f64 }

~proc draw.panel|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ @floatCast(br), @floatCast(bg), @floatCast(bb), @floatCast(ba) },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = @floatCast(radius),
        .border_width = @floatCast(bw),
        .kind = inst_quad,
        .clip_round = 0,
    });
}

// A Gaussian-blurred shadow box — Evan Wallace's fast rounded-rect shadow,
// after nanoui. `blur` is sigma in points; the drawn quad extends 3*sigma
// past the box in every direction.
~pub tor draw.shadow { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64, radius: f64, blur: f64, r: f64, g: f64, b: f64, a: f64 }

~proc draw.shadow|zig {
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = .{ 0, 0, 0, 0 },
        .clip = curClip(f),
        .radius = @floatCast(radius),
        .border_width = @floatCast(blur),
        .kind = inst_shadow,
        .clip_round = 0,
    });
}

// The clip stack — every instance records the clip live when it is pushed,
// so a group of draws bounded by push/pop clip together. Nesting is by
// INTERSECTION: the pushed rect is clamped to the parent clip.
~pub tor draw.clip.push { f: *Frame<frame>, x: f64, y: f64, w: f64, h: f64 }

~proc draw.clip.push|zig {
    if (f.clip_depth >= f.clip_stack.len) return;
    var x0: f32 = @floatCast(x);
    var y0: f32 = @floatCast(y);
    var x1: f32 = x0 + @as(f32, @floatCast(w));
    var y1: f32 = y0 + @as(f32, @floatCast(h));
    if (f.clip_depth > 0) {
        const parent = f.clip_stack[f.clip_depth - 1];
        x0 = @max(x0, parent[0]);
        y0 = @max(y0, parent[1]);
        x1 = @min(x1, parent[2]);
        y1 = @min(y1, parent[3]);
    }
    f.clip_stack[f.clip_depth] = .{ x0, y0, x1, y1 };
    f.clip_depth += 1;
}

~pub tor draw.clip.pop { f: *Frame<frame> }

~proc draw.clip.pop|zig {
    if (f.clip_depth > 0) f.clip_depth -= 1;
}

// ============================================================================
// Text — one run of the system font. x,y is the TOP-LEFT of the line box
// in points (the convention every other draw verb uses); the baseline is
// y + the font's ascent, snapped to a pixel row. Each glyph becomes a
// kind-1 instance sampling the atlas — the run shapes once per
// (string, size) and every glyph rasterizes once per quarter-pixel bin.
~pub tor draw.text { f: *Frame<frame>, x: f64, y: f64, size: f64, r: f64, g: f64, b: f64, a: f64, text: string }

~proc draw.text|zig {
    const ts = f.text;
    const sz: f32 = @floatCast(size);
    const fnt = ts.font(sz);
    const lay = ts.layout(text, sz);
    if (lay.glyphs.len == 0) return;
    const scale = ts.scale;
    const cx: f32 = @floatCast(x);
    const baseline = @round((@as(f32, @floatCast(y)) + fnt.ascent) * scale) / scale;
    const color: [4]f32 = .{ @floatCast(r), @floatCast(g), @floatCast(b), @floatCast(a) };
    for (lay.glyphs) |gl| {
        const pen = (cx + gl.x) * scale;
        const px = @floor(pen);
        const bin: u8 = @intFromFloat(@min(@as(f32, atlas_bins - 1), @floor((pen - px) * atlas_bins)));
        const sp = ts.atlas.glyph(gl.font, ts.run_fonts.items[gl.font], gl.glyph, bin) orelse continue;
        instPush(f, .{
            .rect = .{ px / scale + sp.x, baseline - gl.y + sp.y, sp.w, sp.h },
            .color = color,
            .border_color = .{ 0, 0, 0, 0 },
            .uv = sp.uv,
            .clip = curClip(f),
            .radius = 0,
            .border_width = 0,
            .kind = inst_text,
            .clip_round = 0,
        });
    }
}

// ============================================================================
// Text hit-testing — caret math over the SHAPED layout, so it can be called
// from `! mouse-down` arms where no Frame exists. Both take the window for
// its TextSystem and reuse the layout cache — hit-testing a string you're
// drawing every frame is a cache hit.
//
// v1 contract: str_idx counts UTF-16 units, so index math is byte-exact
// for ASCII only; a multi-byte run through caret verbs is unmeasured.
// ============================================================================

// The caret index for a click at `x` points into the run — the midpoint
// rule: a click left of a glyph's advance midpoint puts the caret before
// that glyph's cluster.
~pub tor text.index { win: *Window<opened|active>, text: string, size: f64, x: f64 } -> i64

~proc text.index|zig {
    const lay = win.text.layout(text, @floatCast(size));
    const click: f32 = @floatCast(x);
    for (lay.glyphs) |g| {
        if (click < g.x + g.adv * 0.5) return @intCast(g.str_idx);
    }
    return @intCast(text.len);
}

// The pen x at caret `index` — where a caret rect or a second draw.text
// continuation goes. Past-the-end lands after the last advance.
~pub tor text.offset { win: *Window<opened|active>, text: string, size: f64, index: i64 } -> f64

~proc text.offset|zig {
    const lay = win.text.layout(text, @floatCast(size));
    const idx: u32 = @intCast(@max(0, index));
    var pen: f32 = 0;
    for (lay.glyphs) |g| {
        if (g.str_idx >= idx) return g.x;
        pen = g.x + g.adv;
    }
    return pen;
}

// The font's ascent at `size` — top of the line box down to the baseline.
// draw.text already takes the box's top (it adds ascent internally), so
// consumers holding a top-left box (a clay TEXT command's boundingBox)
// pass box.y directly; ascent matters for sizing the line box — with
// text.descent a consumer can center a line: box_top = y + (h - asc -
// desc) / 2. Same font path draw.text shapes with, so the metric can't
// drift from the renderer.
~pub tor text.ascent { win: *Window<opened|active>, size: f64 } -> f64

~proc text.ascent|zig {
    return @floatCast(win.text.font(@floatCast(size)).ascent);
}

// The font's descent at `size` — baseline to line-box bottom.
~pub tor text.descent { win: *Window<opened|active>, size: f64 } -> f64

~proc text.descent|zig {
    return @floatCast(win.text.font(@floatCast(size)).descent);
}

// ============================================================================
// Images — decode to BGRA premultiplied via NSImage + CGBitmapContext (pure
// Cocoa/CoreGraphics, no extra frameworks), then pack into the window's
// image atlas as a kind-3 instance instead of owning a texture. The value
// handed to Clay as imageData is a 1-based index into `decoded_images` —
// it comes back out of the IMAGE render command verbatim for draw.image.
// ============================================================================

// Two-arm load — `| img` hands back the decoded-image handle as i64;
// `| err` names which step failed. No degraded/placeholder path.
~pub tor image.load { win: *Window<opened|active>, path: string } | img i64 | err string

~proc image.load|zig {
    const pool = objc_autoreleasePoolPush();
    defer objc_autoreleasePoolPop(pool);

    var pbuf: [1024]u8 = undefined;
    const pstr = cf.CFStringCreateWithCString(null, cstr(path, &pbuf), cf.kCFStringEncodingUTF8);
    const nsimg = send1(
        Id, Id,
        send(Id, cls("NSImage"), sel("alloc")),
        sel("initWithContentsOfFile:"),
        @as(Id, @ptrCast(@constCast(pstr))),
    );
    if (nsimg == null) return .{ .err = "metal: image file not readable" };
    var prop: NSRect = undefined;
    const cg = send3(Id, *NSRect, Id, Id, nsimg, sel("CGImageForProposedRect:context:hints:"), &prop, @as(Id, null), @as(Id, null));
    if (cg == null) return .{ .err = "metal: no CGImage in file" };
    const w = CGImageGetWidth(cg);
    const h = CGImageGetHeight(cg);
    if (w == 0 or h == 0) return .{ .err = "metal: zero-size image" };

    // Rasterize into a BGRA-premultiplied buffer — the atlas texture's
    // pixel format (BGRA8Unorm) takes the bytes as-is;
    // kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little is
    // exactly that byte order.
    const cs = CGColorSpaceCreateDeviceRGB();
    const bctx = CGBitmapContextCreate(null, w, h, 8, w * 4, cs, 2 | (2 << 12));
    if (bctx == null) return .{ .err = "metal: bitmap context failed" };
    CGContextDrawImage(bctx, .{ .origin = .{ .x = 0, .y = 0 }, .size = .{ .width = @floatFromInt(w), .height = @floatFromInt(h) } }, cg);
    const px = CGBitmapContextGetData(bctx) orelse return .{ .err = "metal: no bitmap data" };
    // The bitmap context owns `px` and dies with it — copy before release.
    const buf = std.heap.page_allocator.alloc(u8, w * h * 4) catch @panic("metal: OOM decoding image");
    @memcpy(buf, @as([*]u8, @ptrCast(px))[0 .. w * h * 4]);
    CGContextRelease(bctx);
    cf.CFRelease(cs);
    send(void, nsimg, sel("release"));

    const img: DecodedImage = .{ .pixels = buf, .w = @intCast(w), .h = @intCast(h) };
    decoded_images.append(std.heap.page_allocator, img) catch @panic("metal: OOM registering image");
    const handle: u32 = @intCast(decoded_images.items.len);
    // Eager pack into this window's atlas — if it doesn't fit the slot
    // records needs_reset and draw.image re-pins it after the grow.
    _ = win.images.slot(handle, img);
    return .{ .img = @as(i64, handle) };
}

// One image-atlas rect in PIXEL space — `tex` is the 1-based handle
// image.load returned (or any imageData Clay hands back verbatim).
~pub tor draw.image { f: *Frame<frame>, tex: i64, x: f64, y: f64, w: f64, h: f64 }

~proc draw.image|zig {
    const handle: u32 = @intCast(tex);
    if (handle == 0 or handle > decoded_images.items.len) @panic("metal: draw.image with an invalid image handle");
    const img = decoded_images.items[handle - 1];
    const uv = f.images.slot(handle, img) orelse return; // shelf full — draws one frame late
    instPush(f, .{
        .rect = .{ @floatCast(x), @floatCast(y), @floatCast(w), @floatCast(h) },
        .color = .{ 1, 1, 1, 1 },
        .border_color = .{ 0, 0, 0, 0 },
        .uv = uv,
        .clip = curClip(f),
        .radius = 0,
        .border_width = 0,
        .kind = inst_image,
        .clip_round = 0,
    });
}

// Request the frames loop to exit at the next iteration — same shape as
// vaxis:quit. Sets a module flag; frames checks it after mailbox dispatch.
~pub tor quit {}

~proc quit|zig {
    should_quit = true;
}
