// Known-answer: real Rails-produced digests — none generated by this package.
//
// Source: /tmp/oc-scout/rust/vectors/rails_compat.json, "passwords.digests" /
// "passwords.checks" — golden vectors produced by bcrypt-ruby inside the
// once-campfire reference Rails container (reference-tools/ runs the generator
// against the live Rails app). Cost 12, the `$2a$` spelling has_secure_password
// writes into User#password_digest. Every expectation below is taken from the
// checks array, not re-derived.
//
// The 'pässwörd ☃' case is the discriminating one: its password carries >0x7f
// bytes, exactly where pre-2011 crypt_blowfish "$2a$" differed from "$2b$" —
// bcrypt-ruby's digest verifying under Zig's $2b$ algorithm confirms modern
// bcrypt-ruby emits the fixed algorithm. The 'ignored' case pins bcrypt's
// silent 72-byte truncation: "aaa…ignored" truncates to the same 72 a's, so
// Rails itself returns true for it.

import libs/bcrypt
import std/io

libs/bcrypt:verify(password: "secret123456", digest: "$2a$12$I/2qP3ixlNN..JU2dXSN0umG7/Folk3aUaqgSHn/Rl0G82O9WYk66"): a
|> std/io:print.ln("secret123456 vs its digest      = {{ a:any }}")
|> libs/bcrypt:verify(password: "wrong", digest: "$2a$12$I/2qP3ixlNN..JU2dXSN0umG7/Folk3aUaqgSHn/Rl0G82O9WYk66"): b
|> std/io:print.ln("wrong vs same digest            = {{ b:any }}")
|> libs/bcrypt:verify(password: "pässwörd ☃", digest: "$2a$12$kolfXguIoTYueHR5JN6QAeV84/81BRcUbA.dz4fVMiqp5RUtos1I6"): c
|> std/io:print.ln("utf8 password vs its digest     = {{ c:any }}")
|> libs/bcrypt:verify(password: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaignored", digest: "$2a$12$TZrwCKzycdLOZ2HeWOMW1OYHE8nrAWHoOY05FWLQ6N38GSUKn4DMW"): d
|> std/io:print.ln("72-byte truncation (want true)  = {{ d:any }}")
|> libs/bcrypt:verify(password: "garbage", digest: "not a digest"): e
|> std/io:print.ln("malformed digest (want false)   = {{ e:any }}")
