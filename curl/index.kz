// @koru/curl - HTTP Client for Koru
//
// Wraps industry-standard libcurl with phantom obligation types
// to enforce connection cleanup at compile-time.

~import std/build
~import std/deps

// System dependency: libcurl must be installed
~std/deps:requires.system {
    "name": "curl",
    "check": "curl-config --version",
    "brew": "curl",
    "apt": "libcurl4-openssl-dev",
    "dnf": "libcurl-devel",
    "pacman": "curl",
    "apk": "curl-dev"
}

// Build requirements: link against libcurl
~std/build:requires {
    exe.linkSystemLibrary("curl");
    exe.linkLibC();
}

const std = @import("std");
const c = @cImport({
    @cInclude("curl/curl.h");
});

// ============================================================================
// Types
// ============================================================================

pub const Response = struct {
    handle: ?*c.CURL,
    allocator: std.mem.Allocator,
    status: i32,
    body: []u8,
};

pub const Error = struct {
    code: i32,
    msg: []const u8,
};

// Callback context - holds both buffer and allocator for Zig 0.15 API
const WriteContext = struct {
    buffer: std.ArrayListUnmanaged(u8),
    allocator: std.mem.Allocator,
};

fn writeCallback(ptr: [*c]u8, size: c_uint, nmemb: c_uint, userdata: ?*anyopaque) callconv(.c) c_uint {
    const real_size = size * nmemb;
    if (userdata) |ud| {
        const ctx: *WriteContext = @ptrCast(@alignCast(ud));
        ctx.buffer.appendSlice(ctx.allocator, ptr[0..real_size]) catch return 0;
    }
    return real_size;
}

fn curlError(code: c.CURLcode, allocator: std.mem.Allocator) Error {
    const msg = c.curl_easy_strerror(code);
    const duped = allocator.dupe(u8, std.mem.span(msg)) catch "allocation failed";
    return .{ .code = @intCast(code), .msg = duped };
}

// ============================================================================
// GET Request
// ============================================================================

~pub tor get { url: string, allocator: ?std.mem.Allocator }
| ok *Response<open!>
| err Error

~proc get|zig {
    // Use provided allocator or default to page_allocator
    const alloc = allocator orelse std.heap.page_allocator;

    const handle = c.curl_easy_init();
    if (handle == null) {
        return .{ .err = .{ .code = @intCast(c.CURLE_FAILED_INIT), .msg = "Failed to initialize curl" } };
    }
    errdefer _ = c.curl_easy_cleanup(handle);

    // Set URL
    _ = c.curl_easy_setopt(handle, c.CURLOPT_URL, url.ptr);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_FOLLOWLOCATION, @as(c_long, 1));

    // Response buffer with allocator context
    var write_ctx = WriteContext{
        .buffer = std.ArrayListUnmanaged(u8){},
        .allocator = alloc,
    };

    _ = c.curl_easy_setopt(handle, c.CURLOPT_WRITEFUNCTION, writeCallback);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_WRITEDATA, &write_ctx);

    // Perform request
    const result = c.curl_easy_perform(handle);
    if (result != c.CURLE_OK) {
        write_ctx.buffer.deinit(alloc);
        return .{ .err = curlError(result, alloc) };
    }

    // Get HTTP status code
    var http_code: c_long = 0;
    _ = c.curl_easy_getinfo(handle, c.CURLINFO_RESPONSE_CODE, &http_code);

    // Create response
    const resp = alloc.create(Response) catch {
        write_ctx.buffer.deinit(alloc);
        _ = c.curl_easy_cleanup(handle);
        return .{ .err = .{ .code = -1, .msg = "allocation failed" } };
    };
    resp.* = .{
        .handle = handle,
        .allocator = alloc,
        .status = @intCast(http_code),
        .body = write_ctx.buffer.toOwnedSlice(alloc) catch &[_]u8{},
    };

    return .{ .ok = resp };
}

// ============================================================================
// POST Request
// ============================================================================

~pub tor post { url: string, body: string, allocator: ?std.mem.Allocator }
| ok *Response<open!>
| err Error

~proc post|zig {
    // Use provided allocator or default to page_allocator
    const alloc = allocator orelse std.heap.page_allocator;

    const handle = c.curl_easy_init();
    if (handle == null) {
        return .{ .err = .{ .code = @intCast(c.CURLE_FAILED_INIT), .msg = "Failed to initialize curl" } };
    }
    errdefer _ = c.curl_easy_cleanup(handle);

    // Set URL and POST
    _ = c.curl_easy_setopt(handle, c.CURLOPT_URL, url.ptr);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_POST, @as(c_long, 1));
    _ = c.curl_easy_setopt(handle, c.CURLOPT_POSTFIELDS, body.ptr);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_POSTFIELDSIZE, @as(c_long, @intCast(body.len)));

    // Response buffer with allocator context
    var write_ctx = WriteContext{
        .buffer = std.ArrayListUnmanaged(u8){},
        .allocator = alloc,
    };

    _ = c.curl_easy_setopt(handle, c.CURLOPT_WRITEFUNCTION, writeCallback);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_WRITEDATA, &write_ctx);

    // Perform request
    const result = c.curl_easy_perform(handle);
    if (result != c.CURLE_OK) {
        write_ctx.buffer.deinit(alloc);
        return .{ .err = curlError(result, alloc) };
    }

    // Get HTTP status code
    var http_code: c_long = 0;
    _ = c.curl_easy_getinfo(handle, c.CURLINFO_RESPONSE_CODE, &http_code);

    // Create response
    const resp = alloc.create(Response) catch {
        write_ctx.buffer.deinit(alloc);
        _ = c.curl_easy_cleanup(handle);
        return .{ .err = .{ .code = -1, .msg = "allocation failed" } };
    };
    resp.* = .{
        .handle = handle,
        .allocator = alloc,
        .status = @intCast(http_code),
        .body = write_ctx.buffer.toOwnedSlice(alloc) catch &[_]u8{},
    };

    return .{ .ok = resp };
}

// ============================================================================
// POST with Headers (for APIs)
// ============================================================================

pub const Header = struct {
    name: []const u8,
    value: []const u8,
};

~pub tor post.with-headers {
    url: string,
    body: string,
    headers: []const Header,
    allocator: ?std.mem.Allocator
}
| ok *Response<open!>
| err Error

~proc post.with-headers|zig {
    const alloc = allocator orelse std.heap.page_allocator;

    const handle = c.curl_easy_init();
    if (handle == null) {
        return .{ .err = .{ .code = @intCast(c.CURLE_FAILED_INIT), .msg = "Failed to initialize curl" } };
    }
    errdefer _ = c.curl_easy_cleanup(handle);

    // Set URL and POST
    _ = c.curl_easy_setopt(handle, c.CURLOPT_URL, url.ptr);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_POST, @as(c_long, 1));
    _ = c.curl_easy_setopt(handle, c.CURLOPT_POSTFIELDS, body.ptr);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_POSTFIELDSIZE, @as(c_long, @intCast(body.len)));

    // Build header list
    var header_list: ?*c.curl_slist = null;
    for (headers) |h| {
        // Format: "Name: Value"
        const header_str = std.fmt.allocPrintSentinel(alloc, "{s}: {s}", .{ h.name, h.value }, 0) catch {
            if (header_list) |list| c.curl_slist_free_all(list);
            return .{ .err = .{ .code = -1, .msg = "header allocation failed" } };
        };
        header_list = c.curl_slist_append(header_list, header_str.ptr);
        alloc.free(header_str);
    }

    if (header_list) |list| {
        _ = c.curl_easy_setopt(handle, c.CURLOPT_HTTPHEADER, list);
    }
    defer if (header_list) |list| c.curl_slist_free_all(list);

    // Response buffer
    var write_ctx = WriteContext{
        .buffer = std.ArrayListUnmanaged(u8){},
        .allocator = alloc,
    };

    _ = c.curl_easy_setopt(handle, c.CURLOPT_WRITEFUNCTION, writeCallback);
    _ = c.curl_easy_setopt(handle, c.CURLOPT_WRITEDATA, &write_ctx);

    // Perform request
    const result = c.curl_easy_perform(handle);
    if (result != c.CURLE_OK) {
        write_ctx.buffer.deinit(alloc);
        return .{ .err = curlError(result, alloc) };
    }

    // Get HTTP status code
    var http_code: c_long = 0;
    _ = c.curl_easy_getinfo(handle, c.CURLINFO_RESPONSE_CODE, &http_code);

    // Create response
    const resp = alloc.create(Response) catch {
        write_ctx.buffer.deinit(alloc);
        _ = c.curl_easy_cleanup(handle);
        return .{ .err = .{ .code = -1, .msg = "allocation failed" } };
    };
    resp.* = .{
        .handle = handle,
        .allocator = alloc,
        .status = @intCast(http_code),
        .body = write_ctx.buffer.toOwnedSlice(alloc) catch &[_]u8{},
    };

    return .{ .ok = resp };
}

// ============================================================================
// Close (discharges obligation)
// ============================================================================

~pub tor close { resp: *Response<!open> }

~proc close|zig {
    // Clean up curl handle
    if (resp.handle) |h| {
        c.curl_easy_cleanup(h);
    }
    // Free body memory
    if (resp.body.len > 0) {
        resp.allocator.free(resp.body);
    }
    // Free response struct
    resp.allocator.destroy(resp);
}

// ============================================================================
// Multi interface — many transfers, one thread
//
// libcurl's multi interface multiplexes N transfers over sockets from a single
// thread: `curl_multi_perform` advances every handle as far as it can without
// blocking and returns. Concurrency here is a property of the sockets, not of
// threads — nothing in this section spawns one.
//
// Two pumps over the same arms. `drain` performs one non-blocking pass and
// reports; call it from an event loop and transfers progress between frames.
// `await` runs the same loop with a real poll timeout until the batch drains.
//
// Progress is READ from the handles (`curl_easy_getinfo`) rather than pushed
// by libcurl's XFERINFO callback, deliberately: a C callback firing a Koru
// effect branch is an unproven shape, and polling the byte counters needs
// nothing of the sort.
// ============================================================================

const MAX_TRANSFERS = 32;

const Slot = struct {
    easy: ?*c.CURL,
    ctx: WriteContext,
    url: [:0]u8,
    body: ?[:0]u8,
    hdrs: ?*c.curl_slist,
    live: bool,
    last_pct: i32,
};

pub const Multi = struct {
    handle: ?*c.CURLM,
    slots: [MAX_TRANSFERS]Slot,
    count: usize,
    allocator: std.mem.Allocator,
};

// What a `! progress` firing carries: which transfer, and how far along.
pub const Progress = struct {
    index: i32,
    percent: i32,
    downloaded: i64,
};

// What a `! ?started-multi` firing carries: which slot the transfer landed in.
// Deliberately the SAME ordinal `Progress.index` reports against, because that
// is the whole point of the arm — a consumer that seeds one row per transfer
// here can be found again by every later `! progress` without keeping a second
// list in step by hand.
pub const Transfer = struct {
    index: i32,
};

// What a `! ?chunk` firing carries: which transfer, and the bytes that arrived
// since the last drain. `data` is a POLL-SCOPED borrow (valid only within the
// `! chunk` body, same convention as sqlite3's row-scoped text): the buffer it
// points into is cleared the moment the arm returns. Copy out what you keep.
pub const Chunk = struct {
    index: i32,
    data: []const u8,
};

// The promise. Holds the batch while it is in flight.
pub const Pending = struct {
    m: *Multi,
};

~pub tor multi.new { allocator: ?std.mem.Allocator } -> *Multi<empty!>
~proc multi.new|zig {
    const alloc = allocator orelse std.heap.page_allocator;
    const m = alloc.create(Multi) catch @panic("curl: OOM allocating Multi");
    m.* = .{
        .handle = c.curl_multi_init(),
        .slots = undefined,
        .count = 0,
        .allocator = alloc,
    };
    return m;
}

// One URL per call, mirroring curl_multi_add_handle. Consumes EITHER state and
// issues `open` — not because adding destroys the batch, but because it moves
// it: a fresh batch is `empty`, and `multi.start` accepts only `<!open>`. So a
// batch with no transfers in it cannot be started, and the compiler says so
// rather than libcurl returning nothing at runtime. Same shape as
// raylib:frames consuming `<!opened|!active>`.
~pub tor multi.add { m: *Multi<!empty|!open>, url: string } -> *Multi<open!>
~proc multi.add|zig {
    if (m.count >= MAX_TRANSFERS) return m;

    const idx = m.count;
    const slot = &m.slots[idx];

    slot.* = .{
        .easy = c.curl_easy_init(),
        .ctx = .{ .buffer = std.ArrayListUnmanaged(u8){}, .allocator = m.allocator },
        .url = m.allocator.dupeZ(u8, url) catch @panic("curl: OOM duplicating url"),
        .body = null,
        .hdrs = null,
        .live = true,
        .last_pct = -1,
    };

    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_URL, slot.url.ptr);
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_FOLLOWLOCATION, @as(c_long, 1));
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_WRITEFUNCTION, writeCallback);
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_WRITEDATA, &slot.ctx);
    _ = c.curl_multi_add_handle(m.handle, slot.easy);

    m.count += 1;
    return m;
}

// The authenticated-POST twin of `multi.add` — the request shape
// `post.with-headers` speaks, on the batch surface `poll`/`await` can pump
// under a live UI. The slot OWNS its copies of the body and the built header
// list (libcurl requires both to outlive the transfer; the caller's strings
// are free to die the moment this returns), released in `multi.close` with
// the url. No FOLLOWLOCATION here: a redirected POST silently degrades to a
// GET, and an API endpoint that redirects deserves a loud status over a
// quietly wrong verb.
~pub tor multi.add.post {
    m: *Multi<!empty|!open>,
    url: string,
    body: string,
    headers: []const Header
} -> *Multi<open!>

~proc multi.add.post|zig {
    if (m.count >= MAX_TRANSFERS) return m;

    const idx = m.count;
    const slot = &m.slots[idx];

    slot.* = .{
        .easy = c.curl_easy_init(),
        .ctx = .{ .buffer = std.ArrayListUnmanaged(u8){}, .allocator = m.allocator },
        .url = m.allocator.dupeZ(u8, url) catch @panic("curl: OOM duplicating url"),
        .body = m.allocator.dupeZ(u8, body) catch @panic("curl: OOM duplicating body"),
        .hdrs = null,
        .live = true,
        .last_pct = -1,
    };

    for (headers) |h| {
        const header_str = std.fmt.allocPrintSentinel(m.allocator, "{s}: {s}", .{ h.name, h.value }, 0) catch @panic("curl: OOM building header");
        slot.hdrs = c.curl_slist_append(slot.hdrs, header_str.ptr);
        m.allocator.free(header_str);
    }

    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_URL, slot.url.ptr);
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_POST, @as(c_long, 1));
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_POSTFIELDS, slot.body.?.ptr);
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_POSTFIELDSIZE, @as(c_long, @intCast(slot.body.?.len)));
    if (slot.hdrs) |list| {
        _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_HTTPHEADER, list);
    }
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_WRITEFUNCTION, writeCallback);
    _ = c.curl_easy_setopt(slot.easy, c.CURLOPT_WRITEDATA, &slot.ctx);
    _ = c.curl_multi_add_handle(m.handle, slot.easy);

    m.count += 1;
    return m;
}

// Starts nothing by itself — the multi interface begins work on the first
// perform. What it does is hand back a promise, so the batch handle can no
// longer be added to or closed while transfers are in flight.
// `! ?started-multi` pulses ONCE PER TRANSFER before the promise is handed back
// — the one moment where every slot exists and none has moved. It is the twin of
// `poll`'s `! progress`, at the other end of the batch's life: progress reports
// a transfer that has advanced, this reports a transfer that now exists.
//
// Optional, so a caller that does not care about per-transfer setup writes
// nothing. A caller that does gets its rows built by the same act that built the
// transfers, instead of hand-counting a second list into agreement (the three
// literal `insert(xfers)` rows this arm retires in koru-examples/downloads).
~pub tor multi.start { m: *Multi<!open> }
! ?started-multi *Transfer
| started *Pending<open!>
| failed Error

// `$mod.`-qualified throughout: a proc body carrying effect branches splices
// into the CALLER, where this module's scope is gone (KORU112). The arm is what
// changed that — before it, bare `c` and `Pending` were fine here.
~proc multi.start|zig {
    if (m.handle == null) {
        return .{ .failed = .{ .code = @intCast($mod.c.CURLM_INTERNAL_ERROR), .msg = "curl_multi_init failed" } };
    }
    var i: usize = 0;
    while (i < m.count) : (i += 1) {
        if (!m.slots[i].live) continue;
        var t = $mod.Transfer{ .index = @intCast(i) };
        started_multi(&t);
    }
    const p = m.allocator.create($mod.Pending) catch @panic("curl: OOM allocating Pending");
    p.* = .{ .m = m };
    return .{ .started = p };
}

// Build a Response for a finished handle and detach it from the batch.
// Removing before cleanup is libcurl's rule — cleaning up an easy handle still
// attached to a multi corrupts the multi. Doing it here means the Response
// handed to the author is already detached and `close` stays the single
// disposer for both the sync and multi paths.
fn harvest(m: *Multi, easy: ?*c.CURL) ?*Response {
    var i: usize = 0;
    while (i < m.count) : (i += 1) {
        const slot = &m.slots[i];
        if (slot.easy != easy or !slot.live) continue;

        var http_code: c_long = 0;
        _ = c.curl_easy_getinfo(slot.easy, c.CURLINFO_RESPONSE_CODE, &http_code);

        _ = c.curl_multi_remove_handle(m.handle, slot.easy);
        slot.live = false;

        const resp = m.allocator.create(Response) catch @panic("curl: OOM allocating Response");
        resp.* = .{
            .handle = slot.easy,
            .allocator = m.allocator,
            .status = @intCast(http_code),
            .body = slot.ctx.buffer.toOwnedSlice(m.allocator) catch &[_]u8{},
        };
        slot.easy = null;
        return resp;
    }
    return null;
}

fn pctOf(slot: *Slot) i32 {
    var dl: c.curl_off_t = 0;
    var total: c.curl_off_t = 0;
    _ = c.curl_easy_getinfo(slot.easy, c.CURLINFO_SIZE_DOWNLOAD_T, &dl);
    _ = c.curl_easy_getinfo(slot.easy, c.CURLINFO_CONTENT_LENGTH_DOWNLOAD_T, &total);
    if (total <= 0) return 0;
    return @intCast(@divTrunc(dl * 100, total));
}

// NON-BLOCKING. One pass: advance every transfer as far as it can go without
// waiting, report what moved, return.
//
// It BORROWS the promise (`<open>`, no bang), and that is the whole point of
// the shape. Advancing a batch does not end it: the handle that comes back is
// the one that went in. The earlier spelling consumed `<!open>` and re-issued
// `<open!>` on a `| pending` branch that returned the identical pointer — a
// consume-and-reissue of the SAME state on the SAME handle, which is a borrow
// wearing a consume's clothes. (Contrast `multi.add`, which also returns its
// argument but moves it `empty` → `open`: there the consume-and-reissue IS the
// state transition, and is right.)
//
// The cost of the old shape was not cosmetic. A caller holding the promise
// across calls — a frame loop, a store — had to surrender the obligation and
// take it back every single pass, which for a store means removing the row and
// re-inserting it. Borrowing lets the owner keep `<open!>` for the whole run,
// which is what is actually true: polling never made the batch not-theirs.
//
// So this reports and returns nothing. `| complete` says the batch has stopped
// running; `finish` is what ends it, because ending is a consuming act and
// consumption happens on INPUT, never on a branch.
// `! ?chunk` is the streaming arm, and PRESENCE IS THE SWITCH: provide it and
// every drain pass hands you the bytes that arrived since the last one, with
// the slot's buffer cleared behind each firing — `finished` then carries only
// the status and whatever trailed the final drain. Omit it and nothing drains:
// bodies buffer whole and arrive on `finished`, exactly as before. The arm
// fires from THIS proc body during the pass (the same shape as `! progress`),
// never from libcurl's C callback — the callback only ever appends to the
// slot buffer, which is the boundary this section's header commits to.
~pub tor poll { p: *Pending<open> }
! ?chunk *Chunk
! ?progress *Progress
! finished *Response<open!>
| running
| complete

~proc poll|zig {
    const m = p.m;

    var running: c_int = 0;
    _ = $mod.c.curl_multi_perform(m.handle, &running);

    var numfds: c_int = 0;
    _ = $mod.c.curl_multi_poll(m.handle, null, 0, 0, &numfds);

    if (@hasDecl(__H, "chunk")) {
        var ci: usize = 0;
        while (ci < m.count) : (ci += 1) {
            const slot = &m.slots[ci];
            if (!slot.live) continue;
            if (slot.ctx.buffer.items.len == 0) continue;
            var ch = $mod.Chunk{ .index = @intCast(ci), .data = slot.ctx.buffer.items };
            chunk(&ch);
            slot.ctx.buffer.clearRetainingCapacity();
        }
    }

    var i: usize = 0;
    while (i < m.count) : (i += 1) {
        const slot = &m.slots[i];
        if (!slot.live) continue;
        const pct = $mod.pctOf(slot);
        if (pct == slot.last_pct) continue;
        slot.last_pct = pct;
        var pr = $mod.Progress{ .index = @intCast(i), .percent = pct, .downloaded = 0 };
        progress(&pr);
    }

    var left: c_int = 0;
    while ($mod.c.curl_multi_info_read(m.handle, &left)) |msg| {
        if (msg.*.msg != $mod.c.CURLMSG_DONE) continue;
        if ($mod.harvest(m, msg.*.easy_handle)) |resp| finished(resp);
    }

    if (running > 0) return .{ .running = .{} };
    return .{ .complete = .{} };
}

// Ends a promise that has stopped running, handing the batch back. The
// consuming half of `poll`: `<!open>` dies HERE, on an input, because that is
// the only position a phantom obligation can be consumed in. One `finish` per
// promise, however many `poll`s came before it.
//
// Sibling of `cancel`, and the difference is intent rather than mechanism —
// `finish` collects a batch that ran to the end, `cancel` abandons one that did
// not. Both are legal exits, which is why a store holding a Pending must be
// told which it wants (`! discharge`) rather than being left to guess.
~pub tor finish { p: *Pending<!open> } -> *Multi<owned!>
~proc finish|zig {
    const m = p.m;
    m.allocator.destroy(p);
    return m;
}

// BLOCKING. The same pass in a loop with a real poll timeout, until nothing is
// left running. The loop is here in the proc, not a koru fold — so this needs
// no back-edge and no Handlers threading.
~pub tor await { p: *Pending<!open> }
! ?chunk *Chunk
! ?progress *Progress
! finished *Response<open!>
| done *Multi<owned!>

~proc await|zig {
    const m = p.m;
    var running: c_int = 1;

    while (running > 0) {
        _ = $mod.c.curl_multi_perform(m.handle, &running);

        if (@hasDecl(__H, "chunk")) {
            var ci: usize = 0;
            while (ci < m.count) : (ci += 1) {
                const slot = &m.slots[ci];
                if (!slot.live) continue;
                if (slot.ctx.buffer.items.len == 0) continue;
                var ch = $mod.Chunk{ .index = @intCast(ci), .data = slot.ctx.buffer.items };
                chunk(&ch);
                slot.ctx.buffer.clearRetainingCapacity();
            }
        }

        var i: usize = 0;
        while (i < m.count) : (i += 1) {
            const slot = &m.slots[i];
            if (!slot.live) continue;
            const pct = $mod.pctOf(slot);
            if (pct == slot.last_pct) continue;
            slot.last_pct = pct;
            var pr = $mod.Progress{ .index = @intCast(i), .percent = pct, .downloaded = 0 };
            progress(&pr);
        }

        var left: c_int = 0;
        while ($mod.c.curl_multi_info_read(m.handle, &left)) |msg| {
            if (msg.*.msg != $mod.c.CURLMSG_DONE) continue;
            if ($mod.harvest(m, msg.*.easy_handle)) |resp| finished(resp);
        }

        if (running > 0) {
            var numfds: c_int = 0;
            _ = $mod.c.curl_multi_poll(m.handle, null, 0, 100, &numfds);
        }
    }

    m.allocator.destroy(p);
    return .{ .done = m };
}

// Abandon. The other way out of a promise, and it means something different
// from finishing — which is why the compiler names both rather than choosing.
~pub tor cancel { p: *Pending<!open> } -> *Multi<owned!>
~proc cancel|zig {
    const m = p.m;
    var i: usize = 0;
    while (i < m.count) : (i += 1) {
        const slot = &m.slots[i];
        if (!slot.live) continue;
        _ = c.curl_multi_remove_handle(m.handle, slot.easy);
        c.curl_easy_cleanup(slot.easy);
        slot.ctx.buffer.deinit(m.allocator);
        slot.easy = null;
        slot.live = false;
    }
    m.allocator.destroy(p);
    return m;
}

~pub tor multi.close { m: *Multi<!owned> }
~proc multi.close|zig {
    var i: usize = 0;
    while (i < m.count) : (i += 1) {
        const slot = &m.slots[i];
        if (slot.live) {
            _ = c.curl_multi_remove_handle(m.handle, slot.easy);
            c.curl_easy_cleanup(slot.easy);
            slot.ctx.buffer.deinit(m.allocator);
        }
        m.allocator.free(slot.url);
        if (slot.body) |b| m.allocator.free(b);
        if (slot.hdrs) |h| c.curl_slist_free_all(h);
    }
    _ = c.curl_multi_cleanup(m.handle);
    m.allocator.destroy(m);
}
