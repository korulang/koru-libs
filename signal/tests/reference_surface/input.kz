//~ run
//~ expect: reference + init ok
//
// A3 pin: bare reference ~koru/signal(Breath) registers the model (compile-time
// default transform → register.model at runtime).

~import koru/signal
~import std/io

~koru/signal(Breath)

~koru/signal:init(Breath)
| ok |> std/io:print.ln("reference + init ok")
| err e |> std/io:print.ln("init failed: {{ e:s }}")
