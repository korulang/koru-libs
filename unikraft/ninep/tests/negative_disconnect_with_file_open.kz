//~ compile_fail(backend)
//~ error[KORU030]: Use-after-discharge

// NEGATIVE (must FAIL to compile), and THE HEADLINE OF THIS MODULE: disconnect
// the device while a file is still open on it. This crosses ALL THREE nesting
// levels in one line, and it is the one uk9p assertion that is about two
// resources rather than one.
//
//     9pdev.c:115   /* Every fid should have been clunked *before* destroying
//                      the connection. */
//     9pdev.c:118   UK_ASSERT(uk_list_empty(&fid_mgmt->fid_active_list));
//
// WHAT THE C DOES WITH ASSERTS OFF, which is every image anyone ships. That
// line is `do {} while(0)`. `_fid_mgmt_cleanup` then frees only the FREE list
// (9pdev.c:119-124) and walks straight past the active one. So:
//
//   * the open fid is not clunked — the SERVER still holds it, for the life of
//     the mount, and QEMU still holds the host file descriptor behind it;
//   * the `struct uk_9pfid` is not freed — a leak whose size is one fid per
//     forgotten close;
//   * `fid->_dev` now points at storage that `uk_9pdev_disconnect` releases
//     twelve lines later (9pdev.c:279, `uk_free(dev->a, dev)`), so anything
//     that later reaches that fid — including `uk_9pfid_put` on a reference the
//     transport is still holding — dereferences freed memory.
//
// No crash at the point of the mistake. No message. The unikernel keeps
// running, and what surfaces is a host-side descriptor leak in a program whose
// own log is silent.
//
// WHY THIS IS UNSPELLABLE HERE, and it is not a phantom-state check at all —
// it is the COMPOSITION RULE doing its work. `attach` CONSUMES the `*Dev`; the
// only tors that produce one are `reply.release` and `session.end`. So at the
// moment a `*File` exists, the binding `mount` has already been discharged
// twice over and naming it is not a state error, it is a use-after-discharge.
// The device handle does not exist while a fid is live. That is the whole
// design in one diagnostic.
//
// The correct program is `boot_session.kz`: `file.close` gives the `*Root`
// back, `session.end` gives the `*Dev` back, and only then does `disconnect`
// have an argument.
//
// EXPECTED: error[KORU030]: Use-after-discharge: binding 'mount' was already
//           discharged and cannot be used

// The `unikraft` namespace is declared here, not inherited: koruc's built-in
// alias probes the sibling koru-libs CHECKOUT, so in a worktree this file would
// otherwise compile against main's lifts instead of the ones beside it.
~std/compiler:paths {
    unikraft: {{ ENTRY }}/../..
}

~import unikraft/ninep
~import std/io

~unikraft/ninep:connect(tag: "korufs")
| ok mount |> unikraft/ninep:version(dev: mount, requested: "9P2000.L")
    | negotiated v |> unikraft/ninep:reply.release(v.reply)
        | ok rel |> unikraft/ninep:attach(rel.dev, uname: "korunaut", aname: "")
            | ok tree |> unikraft/ninep:walk(root: tree, name: "koru.txt")
                | ok node |> unikraft/ninep:file.open(file: node, mode: 0)
                    | ok fh |> unikraft/ninep:file.read(file: fh, offset: 0, count: 64)
                        | data d |> std/io:print.ln("read: {{ d.bytes:s }}")
                            |> unikraft/ninep:disconnect(dev: mount): rc
                                |> std/io:print.ln("should never get here: {{ rc:d }}")
                        | failed e |> std/io:print.ln("read: {{ e.reason:s }}")
                        | rejected r |> std/io:print.ln("read: {{ r.reason:s }}")
                    | refused e |> std/io:print.ln("open: {{ e.reason:s }}")
                | refused e |> std/io:print.ln("walk: {{ e.reason:s }}")
            | refused e |> std/io:print.ln("attach: {{ e.reason:s }}")
    | refused e |> std/io:print.ln("version: {{ e.reason:s }}")
| absent why |> std/io:print.ln("connect: {{ why:s }}")
| refused e |> std/io:print.ln("connect: {{ e.reason:s }}")
