// @korulang/unikraft — declare a Unikraft unikernel image from the program.
//
// Unikraft builds an image from a GNU make tree plus a Kconfig. Both are
// artifacts the program already has the information to produce, so the library
// writes them — the same move `koru/docker:image` makes for a Dockerfile.
//
//   ~koru/unikraft:image(name: "koru") {
//       APPKORU_CFLAGS-y += -DKORU_UNIKERNEL=1
//   }
//
//   ~koru/unikraft:kconfig {
//       CONFIG_OPTIMIZE_SIZE: 'y'
//       CONFIG_OPTIMIZE_DEADELIM: 'y'
//   }
//
// Then: koruc main.k unikraft gen   ->  Makefile.uk + Kraftfile
//
// WHY THE NAME IS THE LIBRARY'S TO SPELL, not the author's. A Unikraft library
// registers with `$(eval $(call addlib,<name>))` and then feeds sources through
// variables named after the SAME name, uppercased and prefixed. A wrong prefix
// is NOT an error: `addlib` succeeds, nothing attaches, and the image links
// Unikraft's weak `main`, boots, prints nothing, and exits zero. That is the
// exact failure the first hand-written seam hit (2026-08-05: "weak main()
// called. Symbol was not replaced!"), and it is the whole reason `image`
// derives three lines from one name instead of passing a block through.
//
// WHY IT IS `image` AND `kconfig`, NOT `app` AND `config`. `app` is a reserved
// default import alias (koru's config.zig seeds paths app -> {{ ENTRY }}), and
// `config` collides with the existing `std/build:config` comptime tor. A first
// cut of this module used those names in `std/` and failed only when BOTH
// blocks appeared in one program — each compiled alone. `image` also lines this
// module up with `koru/docker:image`, which is the same idea for a Dockerfile.

~import std/build
~import std/deps
~import std/compiler

// System dependency: the Unikraft CLI builds the image.
~std/deps:requires.system {
    "name": "kraft",
    "check": "kraft version",
    "brew": "unikraft/cli/kraftkit"
}

// ============================================================================
// UNIKRAFT GEN COMMAND — write Makefile.uk and Kraftfile
// ============================================================================

~std/compiler:command.declare {
    "name": "unikraft",
    "description": "Generate Makefile.uk and Kraftfile from inline unikernel declarations"
}

~[comptime|command]pub tor unikraft {
    program: *const Program,
    allocator: __koru_std.mem.Allocator,
    argv: []const []const u8,
}

~proc unikraft|zig {
    var subcommand: []const u8 = "gen";
    if (argv.len > 0) {
        subcommand = argv[0];
    }

    if (!std.mem.eql(u8, subcommand, "gen")) {
        std.debug.print("Usage: koruc <file> unikraft gen\n", .{});
        return;
    }

    var app_name: []const u8 = "";
    var extra = std.ArrayListUnmanaged([]const u8){};
    defer extra.deinit(allocator);
    var kconfig = std.ArrayListUnmanaged([]const u8){};
    defer kconfig.deinit(allocator);

    const unquote = struct {
        fn go(v: []const u8) []const u8 {
            if (v.len >= 2 and v[0] == '"' and v[v.len - 1] == '"') return v[1 .. v.len - 1];
            return v;
        }
    }.go;

    for (program.items) |item| {
        if (item != .flow) continue;
        const flow = item.flow;
        const mq = flow.inv().path.module_qualifier orelse continue;
        if (!std.mem.eql(u8, mq, "koru.unikraft") and !std.mem.eql(u8, mq, "unikraft")) continue;
        if (flow.inv().path.segments.len != 1) continue;

        const seg = flow.inv().path.segments[0];

        if (std.mem.eql(u8, seg, "image")) {
            for (flow.inv().args) |arg| {
                if (std.mem.eql(u8, arg.name, "name")) {
                    app_name = unquote(arg.value);
                } else if (std.mem.eql(u8, arg.name, "source")) {
                    const body = std.mem.trim(u8, arg.value, " \t\r\n");
                    if (body.len > 0) extra.append(allocator, body) catch return;
                }
            }
        } else if (std.mem.eql(u8, seg, "kconfig")) {
            for (flow.inv().args) |arg| {
                if (std.mem.eql(u8, arg.name, "source")) {
                    kconfig.append(allocator, arg.value) catch return;
                }
            }
        }
    }

    if (app_name.len == 0) {
        std.debug.print("No unikernel declared.\n", .{});
        std.debug.print("Use: ~koru/unikraft:image(name: \"myapp\") {{ ... }}\n", .{});
        return;
    }

    // Unikraft's convention: lib `app<name>`, variables `APP<NAME>_`.
    const lib_name = std.fmt.allocPrint(allocator, "app{s}", .{app_name}) catch return;
    defer allocator.free(lib_name);
    const prefix = std.ascii.allocUpperString(allocator, lib_name) catch return;
    defer allocator.free(prefix);

    // ---- Makefile.uk ----
    {
        var buf = std.ArrayListUnmanaged(u8){};
        defer buf.deinit(allocator);
        const w = buf.writer(allocator);

        w.writeAll("# Generated by koruc from ~koru/unikraft:image — do not edit.\n") catch return;
        w.print("$(eval $(call addlib,{s}))\n\n", .{lib_name}) catch return;
        w.print("{s}_SRCS-y += $({s}_BASE)/main.c\n", .{ prefix, prefix }) catch return;
        w.print("{s}_ALIBS-y += $({s}_BASE)/lib{s}app.a\n", .{ prefix, prefix, app_name }) catch return;

        if (extra.items.len > 0) w.writeAll("\n") catch return;
        for (extra.items) |line| {
            w.writeAll(line) catch return;
            w.writeAll("\n") catch return;
        }

        const f = std.fs.cwd().createFile("Makefile.uk", .{}) catch |err| {
            std.debug.print("failed to write Makefile.uk: {}\n", .{err});
            return;
        };
        defer f.close();
        f.writeAll(buf.items) catch return;
        std.debug.print("\x1b[32m✓\x1b[0m Makefile.uk ({s})\n", .{lib_name});
    }

    // ---- Kraftfile ----
    {
        var buf = std.ArrayListUnmanaged(u8){};
        defer buf.deinit(allocator);
        const w = buf.writer(allocator);

        w.writeAll("# Generated by koruc from ~koru/unikraft:kconfig — do not edit.\n") catch return;
        w.writeAll("spec: v0.6\n") catch return;
        w.print("name: {s}\n\n", .{app_name}) catch return;
        w.writeAll("unikraft:\n  version: stable\n  kconfig:\n") catch return;

        // Not the author's to remember: Unikraft's default STACK_SIZE_PAGE_ORDER
        // is 4 — 16 pages, exactly 64 KB — and std/io's format buffer is 65,536
        // bytes, so any Koru program that prints overflows the whole boot stack
        // and traps. Order 6 costs zero image bytes. An author line of the same
        // name wins, because the author's block is written after this one.
        w.writeAll("    CONFIG_STACK_SIZE_PAGE_ORDER: '6'\n") catch return;

        for (kconfig.items) |block| {
            var it = std.mem.splitScalar(u8, block, '\n');
            while (it.next()) |raw| {
                const line = std.mem.trim(u8, raw, " \t\r\n");
                if (line.len == 0) continue;
                w.print("    {s}\n", .{line}) catch return;
            }
        }

        w.writeAll("\ntargets:\n  - qemu/x86_64\n") catch return;

        const f = std.fs.cwd().createFile("Kraftfile", .{}) catch |err| {
            std.debug.print("failed to write Kraftfile: {}\n", .{err});
            return;
        };
        defer f.close();
        f.writeAll(buf.items) catch return;
        std.debug.print("\x1b[32m✓\x1b[0m Kraftfile ({d} kconfig block(s))\n", .{kconfig.items.len});
    }
}

// ============================================================================
// DECLARATIONS — collected during the walk above, no runtime behaviour
// ============================================================================

// The image's build registration. `name` drives the derived addlib call and both
// prefixed variables; the body is appended verbatim for what derivation cannot
// know (extra sources, CFLAGS, further archives).
~[comptime|norun]pub tor image { name: string, source: Source }

~proc image|zig {
    // Void tor — collected by the `unikraft` command.
}

// Kconfig deltas, one `CONFIG_X: 'y'` per line.
~[comptime|norun]pub tor kconfig { source: Source }

~proc kconfig|zig {
    // Void tor — collected by the `unikraft` command.
}

const std = @import("std");
