// `charp`. BOUND, not exercised against a static entry in this lift's boot
// demo — see "A GENUINE LIBRARY DEFECT FOUND WHILE WRITING THIS" above.
// Freeing the returned string is the caller's responsibility per the header
// doc comment, and WHICH allocator to free it with depends on whether the
// entry is static (libc-family `free`) or dynamic (the object's own
// allocator) — information an opaque `*const StoreEntry` does not expose to
// Koru. Not solved here; stated, not hidden.
~pub tor get.charp { entry: *const StoreEntry }
| ok string
| err i32
~proc get.charp|zig {
    var out: ?[*:0]u8 = null;
    const rc = _uk_store_get_charp(entry, &out);
    if (rc != 0) return .{ .err = @intCast(rc) };
    const p = out orelse return .{ .err = -1 };
    return .{ .ok = std.mem.span(p) };
}

~pub tor set.charp { entry: *const StoreEntry, val: string }
| ok
| err i32
~proc set.charp|zig {
    const rc = _uk_store_set_charp(entry, val.ptr);
    if (rc != 0) return .{ .err = @intCast(rc) };
    return .{ .ok = .{} };
}
