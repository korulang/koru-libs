//~ compile_fail(backend)
//~ error[KORU030]: Phantom state mismatch

// NEGATIVE (must FAIL to compile): unconfigure the device with its queue still
// configured.
//
// `stop` mints <stopped!>; `release` accepts only <!drained>, which only
// `queue.close` mints. Skipping the queue teardown is therefore unspellable.
//
// This is the one C guard that is a LOOP rather than a comparison:
//
//     for (q_id = 0; q_id < CONFIG_LIBUKBLKDEV_MAXNBQUEUES; ++q_id)
//             UK_ASSERT(!dev->_queue[q_id] || PTRISERR(dev->_queue[q_id]));
//
// (blkdev.c:551-552). It runs once per queue, on every unconfigure, in debug
// builds only. Here it is the shape of the chain and costs nothing.

~import unikraft/blk
~import std/io

~unikraft/blk:get(id: 0)
| device disk |> unikraft/blk:configure(disk.dev)
    | ok cfg |> unikraft/blk:queue.open(dev: cfg, transfer: 1)
        | ok armed |> unikraft/blk:start(dev: armed)
            | ok run |> unikraft/blk:read(dev: run, sector: 0, sectors: 1)
                | data first |> unikraft/blk:stop(first.dev)
                    | ok stopped |> unikraft/blk:release(dev: stopped)
                        | ok |> std/io:print.ln("should never get here")
                        | failed x |> unikraft/blk:abandon(x.dev)
                    | failed x |> unikraft/blk:abandon(x.dev)
                | failed e |> unikraft/blk:stop(e.dev)
                    | ok s |> unikraft/blk:queue.close(dev: s)
                        | ok dr |> unikraft/blk:release(dev: dr)
                            | ok |> _
                            | failed x |> unikraft/blk:abandon(x.dev)
                        | failed x |> unikraft/blk:abandon(x.dev)
                    | failed x |> unikraft/blk:abandon(x.dev)
                | rejected r |> unikraft/blk:io.skipped(r.dev): u |> unikraft/blk:stop(dev: u)
                    | ok s |> unikraft/blk:queue.close(dev: s)
                        | ok dr |> unikraft/blk:release(dev: dr)
                            | ok |> _
                            | failed x |> unikraft/blk:abandon(x.dev)
                        | failed x |> unikraft/blk:abandon(x.dev)
                    | failed x |> unikraft/blk:abandon(x.dev)
            | refused e |> unikraft/blk:queue.close(e.dev)
                | ok dr |> unikraft/blk:release(dev: dr)
                    | ok |> _
                    | failed x |> unikraft/blk:abandon(x.dev)
                | failed x |> unikraft/blk:abandon(x.dev)
        | refused e |> unikraft/blk:release(e.dev)
            | ok |> _
            | failed x |> unikraft/blk:abandon(x.dev)
    | refused e |> unikraft/blk:abandon(e.dev)
| missing why |> std/io:print.ln("blk0 unavailable: {{ why:s }}")
