//~ compile_fail(backend)
//~ error[KORU030]: Phantom state mismatch

// NEGATIVE (must FAIL to compile): bring a disk up, tear it down, never touch it.
//
// This is pillar 4's asymmetry, and it is the whole reason `used` is a state.
// `stop` accepts ONLY <!used>, and <used!> is minted ONLY by `read`, `write`,
// `flush` or the explicit `io.skipped`. `start` mints <running!>. So the chain
// below asks `stop` to accept a <running!> handle and the compiler refuses.
//
// What the C does instead: nothing. `uk_blkdev_stop`'s only ordering guard is
// `UK_ASSERT(dev->_data->state == UK_BLKDEV_RUNNING)` (blkdev.c:476), which is
// SATISFIED here — the device really is running — and which compiles to
// `do {} while(0)` in every shipped image anyway. Configuring queues, arming a
// virtqueue and tearing it all down without a single transfer is a program C
// cannot object to and does not.
//
// The legitimate case is still expressible, and loudly: `blk:io.skipped` mints
// <used!> without running a C call, so a health check that only wants to know
// the device starts says so in a word you can grep for. What this rejects is
// the SILENT no-op. See boot_lifecycle.kz for the same chain with a transfer.

// The `unikraft` namespace is declared here, not inherited: koruc's built-in
// alias probes the sibling koru-libs CHECKOUT, so in a worktree this file would
// otherwise compile against main's lifts instead of the ones beside it.
~std/compiler:paths {
    unikraft: {{ ENTRY }}/../..
}

~import unikraft/blk
~import std/io

~unikraft/blk:get(id: 0)
| device disk |> unikraft/blk:configure(disk.dev)
    | ok cfg |> unikraft/blk:queue.open(dev: cfg, transfer: 1)
        | ok armed |> unikraft/blk:start(dev: armed)
            | ok run |> unikraft/blk:stop(dev: run)
                | ok stopped |> unikraft/blk:queue.close(dev: stopped)
                    | ok drained |> unikraft/blk:release(dev: drained)
                        | ok |> std/io:print.ln("should never get here")
                        | failed x |> unikraft/blk:abandon(x.dev)
                    | failed x |> unikraft/blk:abandon(x.dev)
                | failed x |> unikraft/blk:abandon(x.dev)
            | refused e |> unikraft/blk:queue.close(e.dev)
                | ok dr |> unikraft/blk:release(dev: dr)
                    | ok |> _
                    | failed x |> unikraft/blk:abandon(x.dev)
                | failed x |> unikraft/blk:abandon(x.dev)
        | refused e |> unikraft/blk:release(e.dev)
            | ok |> _
            | failed x |> unikraft/blk:abandon(x.dev)
    | refused e |> unikraft/blk:abandon(e.dev)
| missing why |> std/io:print.ln("blk0 unavailable: {{ why:s }}")
