// Test: scope-value interpolation — `{{uid}}` binds a scope variable with NO
// type hint. bindValue dispatches on the value's own Zig type, so the
// transform emits the expression verbatim and the emitted scope resolves it.

~import libs/sqlite3
~import std/io

~pub tor pick { x: i64 } -> i64
~proc pick|zig { return x; }

~libs/sqlite3:open(path: ":memory:")
| db d |> libs/sqlite3:exec(conn: d, sql: "CREATE TABLE t (id INTEGER, name TEXT)")
    | ok |> libs/sqlite3:exec(conn: d, sql: "INSERT INTO t VALUES (1, 'alice'), (2, 'bob')")
        | ok |> pick(x: 2): uid
            |> libs/sqlite3:default(conn: d) {
                SELECT name FROM t WHERE id = {{ uid }}
            }
            ! row r |> libs/sqlite3:col.text(stmt: r, index: 0): name |> std/io:print.ln("scope-interp name={{ name:s }}")
            | done d4 |> libs/sqlite3:close(conn: d4) |> std/io:print.ln("done")
            | err e |> libs/sqlite3:close(e.conn) |> std/io:print.ln("err: {{ e.msg:s }}")
        | err e2 |> libs/sqlite3:close(conn: d) |> std/io:print.ln("insert err: {{ e2.msg:s }}")
    | err e3 |> libs/sqlite3:close(conn: d) |> std/io:print.ln("create err: {{ e3.msg:s }}")
| err _ |> std/io:print.ln("Open error")
