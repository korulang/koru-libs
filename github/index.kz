// koru/github — implementation companion. The `koruc <site> release |
// publish-npm | ci` commands are floated here: a site that imports koru/github
// gets these verbs on the compiler, so the release path is Koru-owned.
//
// This deliberately mirrors koru/vercel's index.kz: the config is read from the
// AST (source of truth), and the side effects shell out to the platform CLIs
// (`gh`, `npm`, and the `std/build:step` graph for `ci`). No CLI-passed data
// for the common case — argv extras are a convenience, not the spine.

const std = @import("std");

~import std/compiler
~import std/build

// ============================================================================
// REPO CONFIG (read from the program's AST)
// ============================================================================

const RepoConfig = struct {
    owner: []const u8 = "",
    repo: []const u8 = "",
    package: ?[]const u8 = null,
    tag_prefix: ?[]const u8 = null,
    npm_scope: ?[]const u8 = null,
};

fn stripQ(s: []const u8) []const u8 {
    if (s.len >= 2 and s[0] == '"' and s[s.len - 1] == '"') return s[1 .. s.len - 1];
    return s;
}

const ConfigPair = struct { name: []const u8, value: []const u8 };

/// Drop `//` line comments from a body, STRING-AWARE (a `//` inside a quoted
/// value is data, not a comment). Same rationale as vercel's.
fn stripComments(allocator: std.mem.Allocator, text: []const u8) []const u8 {
    var out = std.ArrayList(u8){};
    var i: usize = 0;
    var in_string = false;
    var s_char: u8 = '"';
    while (i < text.len) {
        const c = text[i];
        if (in_string) {
            if (c == '\\' and i + 1 < text.len) {
                out.append(allocator, c) catch {};
                out.append(allocator, text[i + 1]) catch {};
                i += 2;
                continue;
            }
            if (c == s_char) in_string = false;
            out.append(allocator, c) catch {};
            i += 1;
            continue;
        }
        if (c == '"' or c == '\'') {
            in_string = true;
            s_char = c;
            out.append(allocator, c) catch {};
            i += 1;
            continue;
        }
        if (c == '/' and i + 1 < text.len and text[i + 1] == '/') {
            while (i < text.len and text[i] != '\n') i += 1;
            continue;
        }
        out.append(allocator, c) catch {};
        i += 1;
    }
    return out.toOwnedSlice(allocator) catch allocator.alloc(u8, 0) catch "";
}

/// Split a `github:repo` body into (name, value) pairs at TOP-LEVEL commas only.
fn splitConfigPairs(allocator: std.mem.Allocator, text: []const u8) std.ArrayList(ConfigPair) {
    var out = std.ArrayList(ConfigPair){};
    var i: usize = 0;
    var start: usize = 0;
    var in_string = false;
    var s_char: u8 = '"';
    var bracket: usize = 0;
    var brace: usize = 0;
    var paren: usize = 0;
    while (i <= text.len) {
        const at_end = i == text.len;
        const c = if (at_end) ',' else text[i];
        if (in_string) {
            if (c == '\\' and !at_end) {
                i += 2;
                continue;
            }
            if (c == s_char) in_string = false;
            i += 1;
            continue;
        }
        if (c == '"' or c == '\'') {
            in_string = true;
            s_char = c;
            i += 1;
            continue;
        }
        switch (c) {
            '[' => bracket += 1,
            ']' => bracket -|= 1,
            '{' => brace += 1,
            '}' => brace -|= 1,
            '(' => paren += 1,
            ')' => paren -|= 1,
            else => {},
        }
        if ((c == ',' or at_end) and bracket == 0 and brace == 0 and paren == 0) {
            const slice = std.mem.trim(u8, text[start..i], " \t\r\n");
            if (slice.len > 0) {
                if (std.mem.indexOfScalar(u8, slice, ':')) |ci| {
                    const name = std.mem.trim(u8, slice[0..ci], " \t\r\n");
                    const value = std.mem.trim(u8, slice[ci + 1 ..], " \t\r\n");
                    out.append(allocator, .{ .name = name, .value = value }) catch {};
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}

fn readRepoConfig(allocator: std.mem.Allocator, program: *const @import("ast").Program) RepoConfig {
    const ast = @import("ast");
    var cfg = RepoConfig{};

    const flows = ast.allFlows(std.heap.page_allocator, program);
    defer std.heap.page_allocator.free(flows);
    for (flows) |flow| {
        if (flow.inv().path.module_qualifier) |mq| {
            if (!std.mem.eql(u8, mq, "github")) continue;
            if (flow.inv().path.segments.len != 1) continue;
            if (!std.mem.eql(u8, flow.inv().path.segments[0], "repo")) continue;
            var pairs = std.ArrayList(ConfigPair){};
            defer pairs.deinit(allocator);
            for (flow.inv().args) |arg| {
                // Brace-block form: one `source` arg holds the whole body.
                // Named-arg form: each field arrives directly.
                if (std.mem.eql(u8, arg.name, "source")) {
                    const body = stripComments(allocator, arg.value);
                    var nested = splitConfigPairs(allocator, body);
                    defer nested.deinit(allocator);
                    for (nested.items) |p| pairs.append(allocator, p) catch {};
                } else {
                    pairs.append(allocator, .{ .name = arg.name, .value = arg.value }) catch {};
                }
            }
            for (pairs.items) |arg| {
                if (std.mem.eql(u8, arg.name, "owner")) {
                    cfg.owner = stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "repo")) {
                    cfg.repo = stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "package")) {
                    cfg.package = if (std.mem.eql(u8, std.mem.trim(u8, arg.value, " \t\r\n"), "null")) null else stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "tag_prefix")) {
                    cfg.tag_prefix = if (std.mem.eql(u8, std.mem.trim(u8, arg.value, " \t\r\n"), "null")) null else stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "npm_scope")) {
                    cfg.npm_scope = if (std.mem.eql(u8, std.mem.trim(u8, arg.value, " \t\r\n"), "null")) null else stripQ(arg.value);
                }
            }
        }
    }
    return cfg;
}

fn wjoin(allocator: std.mem.Allocator, parts: []const []const u8) []const u8 {
    return std.fs.path.join(allocator, parts) catch "";
}

fn wrun(cmd: []const []const u8, cwd: ?[]const u8) bool {
    var child = std.process.Child.init(cmd, std.heap.page_allocator);
    child.cwd = cwd;
    const term = child.spawnAndWait() catch return false;
    return (term == .Exited and term.Exited == 0);
}

fn wout(a: std.mem.Allocator, cmd: []const []const u8) []const u8 {
    var child = std.process.Child.init(cmd, a);
    child.stdout_behavior = .Pipe;
    child.stderr_behavior = .Pipe;
    child.spawn() catch return "";
    var out = std.ArrayList(u8){};
    var err = std.ArrayList(u8){};
    child.collectOutput(a, &out, &err, 1 << 20) catch {
        _ = child.kill() catch {};
        _ = child.wait() catch {};
        return "";
    };
    _ = child.wait() catch {};
    return std.mem.trim(u8, out.items, " \t\r\n");
}

// ============================================================================
// COMMAND: release — tag and push a GitHub release from the declared repo.
// ============================================================================
~proc release|zig {
    const S = @import("std");
    const cfg = readRepoConfig(S.heap.page_allocator, program);
    if (cfg.owner.len == 0 or cfg.repo.len == 0) {
        S.debug.print("✗ github:repo must declare `owner` and `repo`\n", .{});
        S.process.exit(1);
    }
    const tag_prefix = cfg.tag_prefix orelse "v";
    const version = wout(S.heap.page_allocator, &.{ "git", "describe", "--tags", "--abbrev=0" });
    const full_repo = S.fmt.allocPrint(S.heap.page_allocator, "{s}/{s}", .{ cfg.owner, cfg.repo }) catch "";
    defer S.heap.page_allocator.free(full_repo);
    S.debug.print("→ release {s} → {s}\n", .{ tag_prefix, full_repo });
    // `gh release create` with the declared owner/repo; the tag comes from the
    // top of argv (the common case) or the last git tag. argv is a convenience,
    // not the source of truth.
    if (argv.len > 0 and argv[0].len > 0) {
        const tag = S.fmt.allocPrint(S.heap.page_allocator, "{s}{s}", .{ tag_prefix, argv[0] }) catch "";
        defer S.heap.page_allocator.free(tag);
        if (!wrun(&.{ "gh", "release", "create", tag, "--repo", full_repo }, null)) {
            S.debug.print("✗ gh release create failed\n", .{});
            S.process.exit(1);
        }
    } else {
        if (!wrun(&.{ "gh", "release", "create", version, "--repo", full_repo }, null)) {
            S.debug.print("✗ gh release create failed (no version; pass one on argv or tag first)\n", .{});
            S.process.exit(1);
        }
    }
    S.debug.print("✓ release created\n", .{});
}

// ============================================================================
// COMMAND: publish-npm — publish the npm package declared in the site.
// ============================================================================
~proc publish-npm|zig {
    const S = @import("std");
    const cfg = readRepoConfig(S.heap.page_allocator, program);
    const cwd = S.process.getCwdAlloc(S.heap.page_allocator) catch return;
    defer S.heap.page_allocator.free(cwd);
    const pkg_dir = if (cfg.package) |p|
        wjoin(S.heap.page_allocator, &.{ cwd, p })
    else
        cwd;
    S.debug.print("→ publish-npm from {s}\n", .{pkg_dir});
    // --access public for a scoped package; the CLI reads version from the
    // package.json beneath `package` — source of truth, not argv.
    if (cfg.npm_scope != null) {
        if (!wrun(&.{ "npm", "publish", "--access", "public" }, pkg_dir)) {
            S.debug.print("✗ npm publish failed\n", .{});
            S.process.exit(1);
        }
    } else {
        if (!wrun(&.{ "npm", "publish" }, pkg_dir)) {
            S.debug.print("✗ npm publish failed\n", .{});
            S.process.exit(1);
        }
    }
    S.debug.print("✓ published\n", .{});
}
