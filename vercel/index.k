// koru/vercel — host a site on Vercel through Orisha.
//
// Pure Koru, front and center. This file is the contract: nothing here is Zig,
// and nothing here touches a socket, a file descriptor, or a platform. The Zig
// half of this library — the wasm reactor host seam (the exported request/response
// windows and the `handle` function) — is generated by the `build` command into
// your build directory as a thin entry. It is plumbing, so it is fine as .kz;
// you never write it, and it is never this file.
//
// Why this split is correct: Vercel gives a deployment no socket. It accepts the
// connection, parses HTTP, and calls your function once with a request. Orisha
// already split the same way (orisha/lib/index.k) — `answer` turns request bytes
// into response bytes and never names a descriptor; the pump owns the loop. On a
// serverless host the platform owns the loop and you keep only the answer half,
// compiled to a wasm reactor.
//
// A completely static site needs no Koru of your own at all — a `site.k` that
// imports this module and declares `vercel:site`, then:
//
//     koruc site.k build      # embed ./public → wasm reactor → stage deploy/
//     koruc site.k deploy     # vercel deploy --prod on the staged deploy dir
//
// That embeds `public` into the wasm module at compile time and serves it as
// pre-rendered HTTP — no per-request parsing, no runtime dispatch, no libc.
//
// If you want Koru in the loop, author a `main.k` beside your static root. It is
// pure Koru and it becomes the whole server:

//   ~import orisha
//   ~orisha:static(name: "site", root: "public", fallback: "200.html")
//   ~orisha:handler = orisha:static-router(name: "site")

import std/build
import std/compiler
import orisha

// ============================================================================
// BUILD COMMANDS — floated by this import: `koruc <site> build | dev | deploy`.
// The Zig implementations live in the companion index.kz.
// ============================================================================

std/compiler:command.declare {
  "name": "build",
  "description": "Embed the site into an Orisha wasm reactor and stage a Vercel deploy dir"
}

[comptime|command]pub tor build {
    program: *const Program,
    allocator: std.mem.Allocator,
    argv: []string,
}

std/compiler:command.declare {
  "name": "dev",
  "description": "Serve the staged deployment locally through the real adapter"
}

[comptime|command]pub tor dev {
    program: *const Program,
    allocator: std.mem.Allocator,
    argv: []string,
}

std/compiler:command.declare {
  "name": "deploy",
  "description": "Bake (if declared), build and push to Vercel, then verify"
}

[comptime|command]pub tor deploy {
    program: *const Program,
    allocator: std.mem.Allocator,
    argv: []string,
}

std/compiler:command.declare {
  "name": "verify",
  "description": "Check the deployed site answers REAL pages — HTTP 200, never the shell"
}

[comptime|command]pub tor verify {
    program: *const Program,
    allocator: std.mem.Allocator,
    argv: []string,
}

// ---------------------------------------------------------------------------
// The handler contract the generated reactor calls.
// ---------------------------------------------------------------------------
// A site is a function from a request path to a response body. An empty body is
// a 404. Implement `body-for` here (pure Koru) for dynamic-but-small routes; a
// purely static site leaves it to Orisha's embedded static router.
[abstract|retain] pub tor body-for { path: string } -> string

body-for -> ""

// ============================================================================
// SITE — declare the deployment surface. Read by the `build`/`dev`/`deploy`
// build commands (koruc <site> <verb>), so a site's release config lives in its
// own Koru, not in a separate tool.
// ============================================================================
// - name:     site identifier
// - root:     static directory to embed (relative to this file)
// - fallback: shell file, served ONLY for the declared `routes` (client-only
//             paths that cannot be baked) — never a catch-all for missing paths
// - routes:   browser-only paths that hydrate from the shell
// - backend:  a live backend to reverse-proxy the `dynamic` prefixes to
// - dynamic:  genuinely server-side path prefixes (kept on the backend)
// - link:     directory holding the Vercel project linkage (.vercel/project.json);
//             carried into the staged deploy dir so `deploy` pushes to the SAME
//             project instead of minting a new one
// - bake:     a command to run BEFORE the embed — the site's own generator
//             (e.g. ["bun", "run", "build:local"]). Empty = no bake step.
// - bake_env: KEY=VALUE environment overrides for the bake command
//             ("STATIC_BUILD=1"). The current environment is inherited.
// - alias:    where the production deploy is aliased — the base `deploy` and
//             `verify` fetch their proofs from
// - verify:   paths that must answer HTTP 200 with a REAL page after `deploy` —
//             a response equal to the shell is a failed publish, not a success
[comptime|norun] pub tor site {
    name: string,
    root: string,
    fallback: ?string,
    routes: []string,
    backend: ?string,
    dynamic: []string,
    link: ?string,
    bake: []string,
    bake_env: []string,
    alias: ?string,
    verify: []string,
    pixie: ?bool = false,
}

// ============================================================================
// API-VOICE — a transform that inlines the pixie-voice endpoint into a router
// branch (mirrors orisha:static-router's mechanism). Declared HERE so the
// library owns the transform; the compiler collects transforms program-wide,
// and the emitted inline code runs in the branch scope and RETURNS a response.
// ============================================================================
// Usage in a handler:
//   ! [POST /api/pixie-voice] req |> vercel:api-voice(name: "site")
[comptime|transform|pre] pub tor api-voice {
    invocation: *const Invocation,
    item: *const Item,
    program: *const Program,
    allocator: std.mem.Allocator,
} -> SiteResult
