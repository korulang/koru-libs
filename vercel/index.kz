// koru/vercel — implementation companion. The build `koruc <site> build | dev |
// deploy` commands are floated here: a site that `~import koru/vercel` gets these
// verbs on the compiler, so the release path is Koru-owned, not a sidecar CLI.

const std = @import("std");

~import std/build
~import std/compiler

// ============================================================================
// DEPLOY CONFIG (read from the program's AST)
// ============================================================================

const DeployConfig = struct {
    name: []const u8 = "site",
    root: []const u8 = "public",
    fallback: ?[]const u8 = null,
    routes: [][]const u8 = &.{},
    backend: ?[]const u8 = null,
    dynamic: [][]const u8 = &.{},
};

fn readDeployConfig(allocator: std.mem.Allocator, program: *const @import("ast").Program) DeployConfig {
    const ast = @import("ast");
    var cfg = DeployConfig{};
    var routes = std.ArrayList([]const u8){};
    var dynamic = std.ArrayList([]const u8){};
    defer routes.deinit(allocator);
    defer dynamic.deinit(allocator);

    const flows = ast.allFlows(std.heap.page_allocator, program);
    defer std.heap.page_allocator.free(flows);
    for (flows) |flow| {
        if (flow.inv().path.module_qualifier) |mq| {
            if (!std.mem.eql(u8, mq, "vercel")) continue;
            if (flow.inv().path.segments.len != 1) continue;
            if (!std.mem.eql(u8, flow.inv().path.segments[0], "site")) continue;
for (flow.inv().args) |arg| {
                    if (std.mem.eql(u8, arg.name, "name")) {
                        cfg.name = stripQ(arg.value);
                    } else if (std.mem.eql(u8, arg.name, "root")) {
                        cfg.root = stripQ(arg.value);
                    } else if (std.mem.eql(u8, arg.name, "fallback")) {
                        cfg.fallback = if (std.mem.eql(u8, arg.value, "null")) null else stripQ(arg.value);
                    } else if (std.mem.eql(u8, arg.name, "backend")) {
                        cfg.backend = if (std.mem.eql(u8, arg.value, "null")) null else stripQ(arg.value);
                    }
                }
        }
    }
    cfg.routes = routes.toOwnedSlice(allocator) catch &.{};
    cfg.dynamic = dynamic.toOwnedSlice(allocator) catch &.{};
    return cfg;
}

fn stripQ(s: []const u8) []const u8 {
    if (s.len >= 2 and s[0] == '"' and s[s.len - 1] == '"') return s[1 .. s.len - 1];
    return s;
}

// Find this module's directory (koru-libs/vercel) so the command can reach the
// committed reactor template and the adapter scaffold.
fn moduleDir(program: *const @import("ast").Program) ?[]const u8 {
    for (program.items) |item| {
        if (item != .module_decl) continue;
        const m = item.module_decl;
        // koru/vercel imports as logical name "vercel" (or koru.vercel)
        if (std.mem.endsWith(u8, m.logical_name, "vercel") or std.mem.eql(u8, m.logical_name, "vercel")) {
            // For this package the canonical_path IS the module directory
            // (koru-libs/vercel) — the reactor template and scaffold live there.
            return m.canonical_path;
        }
    }
    return null;
}

// ============================================================================
// COMMAND: build
// ============================================================================
~proc build|zig {
    _ = argv;
    std.debug.print("→ koru/vercel build\n", .{});

    const cfg = readDeployConfig(allocator, program);
    std.debug.print("  deploy: name={s} root={s} fallback={?s} backend={?s}\n", .{ cfg.name, cfg.root, cfg.fallback, cfg.backend });

    const dir = moduleDir(program) orelse {
        std.debug.print("✗ could not locate koru/vercel module directory\n", .{});
        return;
    };
    std.debug.print("  vercel module dir: {s}\n", .{dir});
}
