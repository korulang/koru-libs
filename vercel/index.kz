// koru/vercel — implementation companion. The `koruc <site> build | dev |
// deploy` commands are floated here: a site that imports koru/vercel gets these
// verbs on the compiler, so the release path is Koru-owned, not a sidecar CLI.

const std = @import("std");

~import std/build
~import std/compiler

// ============================================================================
// DEPLOY CONFIG (read from the program's AST)
// ============================================================================

const DeployConfig = struct {
    name: []const u8 = "site",
    root: []const u8 = "public",
    fallback: ?[]const u8 = null,
    routes: [][]const u8 = &.{},
    backend: ?[]const u8 = null,
    dynamic: [][]const u8 = &.{},
    link: ?[]const u8 = null,
};

fn stripQ(s: []const u8) []const u8 {
    if (s.len >= 2 and s[0] == '"' and s[s.len - 1] == '"') return s[1 .. s.len - 1];
    return s;
}

const ConfigPair = struct { name: []const u8, value: []const u8 };

/// Drop `//` line comments from a site body, STRING-AWARE — a `//` inside a
/// quoted value (`"https://…"`) is data, not a comment. Without this, a trailing
/// comment on one value line swallows the next `name: value` pair into the same
/// comma segment (the newline is not a separator) and the field vanishes.
fn stripComments(allocator: std.mem.Allocator, text: []const u8) []const u8 {
    var out = std.ArrayList(u8){};
    var i: usize = 0;
    var in_string = false;
    var s_char: u8 = '"';
    while (i < text.len) {
        const c = text[i];
        if (in_string) {
            if (c == '\\' and i + 1 < text.len) {
                out.append(allocator, c) catch {};
                out.append(allocator, text[i + 1]) catch {};
                i += 2;
                continue;
            }
            if (c == s_char) in_string = false;
            out.append(allocator, c) catch {};
            i += 1;
            continue;
        }
        if (c == '"' or c == '\'') {
            in_string = true;
            s_char = c;
            out.append(allocator, c) catch {};
            i += 1;
            continue;
        }
        if (c == '/' and i + 1 < text.len and text[i + 1] == '/') {
            while (i < text.len and text[i] != '\n') i += 1;
            continue;
        }
        out.append(allocator, c) catch {};
        i += 1;
    }
    return out.toOwnedSlice(allocator) catch allocator.alloc(u8, 0) catch "";
}

/// Split a `vercel:site` body (`name: "x", root: "y", routes: ["/a","/b"]`) into
/// (name, value) pairs at TOP-LEVEL commas only — strings, brackets, braces, and
/// parens are atomic, so an array-literal argument does not fragment. The brace
/// block arrives as a single `source` arg whose value is the whole body.
fn splitConfigPairs(allocator: std.mem.Allocator, text: []const u8) std.ArrayList(ConfigPair) {
    var out = std.ArrayList(ConfigPair){};
    var i: usize = 0;
    var start: usize = 0;
    var in_string = false;
    var s_char: u8 = '"';
    var bracket: usize = 0;
    var brace: usize = 0;
    var paren: usize = 0;
    while (i <= text.len) {
        const at_end = i == text.len;
        const c = if (at_end) ',' else text[i];
        if (in_string) {
            if (c == '\\' and !at_end) {
                i += 2;
                continue;
            }
            if (c == s_char) in_string = false;
            i += 1;
            continue;
        }
        if (c == '"' or c == '\'') {
            in_string = true;
            s_char = c;
            i += 1;
            continue;
        }
        switch (c) {
            '[' => bracket += 1,
            ']' => bracket -|= 1,
            '{' => brace += 1,
            '}' => brace -|= 1,
            '(' => paren += 1,
            ')' => paren -|= 1,
            else => {},
        }
        if ((c == ',' or at_end) and bracket == 0 and brace == 0 and paren == 0) {
            const slice = std.mem.trim(u8, text[start..i], " \t\r\n");
            if (slice.len > 0) {
                if (std.mem.indexOfScalar(u8, slice, ':')) |ci| {
                    const name = std.mem.trim(u8, slice[0..ci], " \t\r\n");
                    const value = std.mem.trim(u8, slice[ci + 1 ..], " \t\r\n");
                    out.append(allocator, .{ .name = name, .value = value }) catch {};
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return out;
}

/// Parse a string-array literal value — `["/a", "/b"]` or `[]` — into its elements.
/// An empty interior yields ZERO elements (not one empty string): `[]` must mean
/// "no declared routes", so it cannot leave a single `""` behind.
fn parseStringArray(allocator: std.mem.Allocator, value: []const u8) [][]const u8 {
    var out = std.ArrayList([]const u8){};
    const t = std.mem.trim(u8, value, " \t\r\n");
    if (t.len >= 2 and t[0] == '[' and t[t.len - 1] == ']') {
        const inner = t[1 .. t.len - 1];
        var i: usize = 0;
        var seg_start: usize = 0;
        var in_string = false;
        var s_char: u8 = '"';
        while (i <= inner.len) {
            const at_end = i == inner.len;
            const c = if (at_end) ',' else inner[i];
            if (in_string) {
                if (c == '\\' and !at_end) {
                    i += 2;
                    continue;
                }
                if (c == s_char) in_string = false;
                i += 1;
                continue;
            }
            if (c == '"' or c == '\'') {
                in_string = true;
                s_char = c;
                i += 1;
                continue;
            }
            if (c == ',' or at_end) {
                const elem = std.mem.trim(u8, inner[seg_start..i], " \t\r\n");
                if (elem.len > 0) out.append(allocator, stripQ(elem)) catch {};
                seg_start = i + 1;
            }
            i += 1;
        }
    }
    return out.toOwnedSlice(allocator) catch &.{};
}

fn readDeployConfig(allocator: std.mem.Allocator, program: *const @import("ast").Program) DeployConfig {
    const ast = @import("ast");
    var cfg = DeployConfig{};
    var routes = std.ArrayList([]const u8){};
    var dynamic = std.ArrayList([]const u8){};
    defer routes.deinit(allocator);
    defer dynamic.deinit(allocator);

    const flows = ast.allFlows(std.heap.page_allocator, program);
    defer std.heap.page_allocator.free(flows);
    for (flows) |flow| {
        if (flow.inv().path.module_qualifier) |mq| {
            if (!std.mem.eql(u8, mq, "vercel")) continue;
            if (flow.inv().path.segments.len != 1) continue;
            if (!std.mem.eql(u8, flow.inv().path.segments[0], "site")) continue;
            // The site is declared either as named args (`vercel:site(name: x, ...)`)
            // or, in the brace-block form, as ONE `source` arg whose value is the
            // whole `name: v, root: w, ...` body. Normalize both to a flat pair list.
            // (No free of the stripped body: cfg strings and route/dynamic entries
            // are slices into it, and this one-shot build command leaks its buffers
            // wholesale — matching that is safer than dangling pointers.)
            var pairs = std.ArrayList(ConfigPair){};
            defer pairs.deinit(allocator);
            for (flow.inv().args) |arg| {
                if (std.mem.eql(u8, arg.name, "source")) {
                    const body = stripComments(allocator, arg.value);
                    var nested = splitConfigPairs(allocator, body);
                    defer nested.deinit(allocator);
                    for (nested.items) |p| pairs.append(allocator, p) catch {};
                } else {
                    pairs.append(allocator, .{ .name = arg.name, .value = arg.value }) catch {};
                }
            }
            for (pairs.items) |arg| {
                if (std.mem.eql(u8, arg.name, "name")) {
                    cfg.name = stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "root")) {
                    cfg.root = stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "fallback")) {
                    cfg.fallback = if (std.mem.eql(u8, std.mem.trim(u8, arg.value, " \t\r\n"), "null")) null else stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "backend")) {
                    cfg.backend = if (std.mem.eql(u8, std.mem.trim(u8, arg.value, " \t\r\n"), "null")) null else stripQ(arg.value);
                } else if (std.mem.eql(u8, arg.name, "routes")) {
                    const parsed = parseStringArray(allocator, arg.value);
                    defer allocator.free(parsed);
                    for (parsed) |r| routes.append(allocator, r) catch {};
                } else if (std.mem.eql(u8, arg.name, "dynamic")) {
                    const parsed = parseStringArray(allocator, arg.value);
                    defer allocator.free(parsed);
                    for (parsed) |d| dynamic.append(allocator, d) catch {};
                } else if (std.mem.eql(u8, arg.name, "link")) {
                    cfg.link = if (std.mem.eql(u8, std.mem.trim(u8, arg.value, " \t\r\n"), "null")) null else stripQ(arg.value);
                }
            }
        }
    }
    cfg.routes = routes.toOwnedSlice(allocator) catch &.{};
    cfg.dynamic = dynamic.toOwnedSlice(allocator) catch &.{};
    return cfg;
}

/// Find a module's canonical path by (suffix of) its logical name.
fn modulePath(program: *const @import("ast").Program, want: []const u8) ?[]const u8 {
    for (program.items) |item| {
        if (item != .module_decl) continue;
        const m = item.module_decl;
        if (std.mem.eql(u8, m.logical_name, want) or std.mem.endsWith(u8, m.logical_name, want)) {
            if (std.mem.endsWith(u8, m.canonical_path, "/index.kz")) {
                if (std.mem.lastIndexOf(u8, m.canonical_path, "/")) |i| return m.canonical_path[0..i];
            }
            return m.canonical_path;
        }
    }
    return null;
}

fn moduleDir(program: *const @import("ast").Program) ?[]const u8 {
    return modulePath(program, "vercel");
}

fn wjoin(allocator: std.mem.Allocator, parts: []const []const u8) []const u8 {
    return std.fs.path.join(allocator, parts) catch "";
}

fn wread(allocator: std.mem.Allocator, path: []const u8) []const u8 {
    return std.fs.cwd().readFileAlloc(allocator, path, 1 << 22) catch "";
}

fn wwrite(path: []const u8, data: []const u8) bool {
    std.fs.cwd().makePath(std.fs.path.dirname(path) orelse ".") catch {};
    std.fs.cwd().writeFile(.{ .sub_path = path, .data = data }) catch return false;
    return true;
}

fn wrun(cmd: []const []const u8, cwd: ?[]const u8) bool {
    var child = std.process.Child.init(cmd, std.heap.page_allocator);
    child.cwd = cwd;
    const term = child.spawnAndWait() catch return false;
    return (term == .Exited and term.Exited == 0);
}


fn jsonList(allocator: std.mem.Allocator, items: []const []const u8) []const u8 {
    if (items.len == 0) return "null";
    var buf = std.ArrayList(u8){};
    defer buf.deinit(allocator);
    buf.appendSlice(allocator, "[") catch return "null";
    for (items, 0..) |it, i| {
        if (i > 0) buf.append(allocator, ',') catch return "null";
        buf.append(allocator, '"') catch return "null";
        buf.appendSlice(allocator, it) catch return "null";
        buf.append(allocator, '"') catch return "null";
    }
    buf.append(allocator, ']') catch return "null";
    return buf.toOwnedSlice(allocator) catch "null";
}

// ============================================================================
// BUILD — generate the reactor, compile it, stage the deploy dir. Shared by the
// `build` and `deploy` commands.
// ============================================================================
fn runBuild(a: std.mem.Allocator, program: *const @import("ast").Program) bool {
    const S = @import("std");
    std.debug.print("→ koru/vercel build\n", .{});
    const cfg = readDeployConfig(a, program);
    // cfg.{routes,dynamic} are arrays of pointers into AST-owned string memory;
    // only the pointer arrays themselves are allocator-owned. Free them here (the
    // sole consumer); the strings live as long as the program AST.
    defer a.free(cfg.routes);
    defer a.free(cfg.dynamic);
    const dir = moduleDir(program) orelse {
        std.debug.print("✗ could not locate the koru/vercel module directory\n", .{});
        return false;
    };
    const cwd_path = S.process.getCwdAlloc(a) catch return false;
    defer a.free(cwd_path);

    const root_abs = if (S.fs.path.isAbsolute(cfg.root))
        a.dupe(u8, cfg.root) catch ""
    else
        wjoin(a, &.{ cwd_path, cfg.root });
    defer a.free(root_abs);
    if (root_abs.len == 0) {
        S.debug.print("✗ static root not found: {s}\n", .{root_abs});
        return false;
    }
    var root_dir = S.fs.cwd().openDir(root_abs, .{}) catch {
        S.debug.print("✗ static root not found: {s}\n", .{root_abs});
        return false;
    };
    root_dir.close();

    const deploy_dir = wjoin(a, &.{ cwd_path, "deploy" });
    // Compiler scratch, nested UNDER the deploy dir — never `cwd/build`, because a
    // site's static root may itself be `cwd/build` (korulang_org), and compiling
    // into the embedded root would serve main.kz/a.out as pages.
    const build_dir = wjoin(a, &.{ deploy_dir, "build" });
    S.fs.cwd().makePath(build_dir) catch {};
    S.fs.cwd().makePath(deploy_dir) catch {};

    // ---- 1. Reactor entry from the committed template + the site surface ----
    const reactor_file = wjoin(a, &.{ dir, "reactor", "main.kz" });
    const reactor_src = wread(a, reactor_file);
    if (reactor_src.len == 0) {
        S.debug.print("✗ reactor template not found: {s}\n", .{reactor_file});
        return false;
    }
    const begin = "//=== SITE-CONFIG-BEGIN ===";
    const end = "//=== SITE-CONFIG-END ===";
    const s = S.mem.indexOf(u8, reactor_src, begin) orelse {
        S.debug.print("✗ reactor template missing SITE-CONFIG block\n", .{});
        return false;
    };
    const e = S.mem.indexOf(u8, reactor_src, end) orelse return false;
    const static_line = S.fmt.allocPrint(a, "~orisha:static(name: \"{s}\", root: \"{s}\")", .{ cfg.name, root_abs }) catch return false;
    const handler_line = S.fmt.allocPrint(a, "~orisha:handler = orisha:static-router(name: \"{s}\")", .{ cfg.name }) catch return false;
    const site_block = S.fmt.allocPrint(a, "{s}\n{s}\n{s}\n{s}\n", .{ begin, static_line, handler_line, end }) catch return false;
    const main_src = S.mem.concat(a, u8, &.{ reactor_src[0..s], site_block, reactor_src[e + end.len ..] }) catch return false;
    const main_file = wjoin(a, &.{ build_dir, "main.kz" });
    if (!wwrite(main_file, main_src)) return false;
    S.debug.print("  wrote reactor entry {s}\n", .{main_file});

    // ---- 2. koru.json with std/orisha/vercel paths for the reactor build ----
    const std_dir = modulePath(program, "std") orelse "";
    const orisha_dir = modulePath(program, "orisha") orelse "";
    const koru_json = S.fmt.allocPrint(a,
        \\{{ "name": "{s}", "paths": {{ "std": "{s}", "orisha": "{s}", "vercel": "{s}" }} }}
        \\
    , .{ cfg.name, std_dir, orisha_dir, dir }) catch return false;
    if (!wwrite(wjoin(a, &.{ build_dir, "koru.json" }), koru_json)) return false;

    // ---- 3. Compile the reactor ----
    S.debug.print("  compiling reactor (embeds {s})\n", .{root_abs});
    if (!wrun(&.{ "koruc", "build", "main.kz" }, build_dir)) {
        S.debug.print("✗ reactor compile failed\n", .{});
        return false;
    }
    const wasm = wjoin(a, &.{ build_dir, "a.out" });
    const wasm_out = wjoin(a, &.{ deploy_dir, "wasm", "handler.wasm" });
    S.fs.cwd().makePath(wjoin(a, &.{ deploy_dir, "wasm" })) catch {};
    S.fs.cwd().copyFile(wasm, S.fs.cwd(), wasm_out, .{}) catch {
        S.debug.print("✗ could not copy wasm into the deploy dir\n", .{});
        return false;
    };

    // ---- 4. Adapter from the scaffold, parameterized by the site surface ----
    const scaffold = wjoin(a, &.{ dir, "scaffold" });
    const serve_tpl = wread(a, wjoin(a, &.{ scaffold, "serve.mjs" }));
    if (serve_tpl.len == 0) {
        S.debug.print("✗ adapter scaffold missing\n", .{});
        return false;
    }
    const routes_json = jsonList(a, cfg.routes);
    const dynamic_json = jsonList(a, cfg.dynamic);
    const fallback_json = if (cfg.fallback) |f|
        (if (f.len > 0 and f[0] == '/') S.fmt.allocPrint(a, "\"{s}\"", .{f}) catch "null" else S.fmt.allocPrint(a, "\"/{s}\"", .{f}) catch "null")
    else
        "null";
    const backend_json = if (cfg.backend) |b| S.fmt.allocPrint(a, "\"{s}\"", .{b}) catch "null" else "null";
    var serve = S.mem.replaceOwned(u8, a, serve_tpl, "__CLIENT_ROUTES_JSON__", routes_json) catch serve_tpl;
    const d1 = serve;
    serve = S.mem.replaceOwned(u8, a, d1, "__FALLBACK_PATH__", fallback_json) catch d1;
    const d2 = serve;
    serve = S.mem.replaceOwned(u8, a, d2, "__DYNAMIC_JSON__", dynamic_json) catch d2;
    const d3 = serve;
    serve = S.mem.replaceOwned(u8, a, d3, "__BACKEND__", backend_json) catch d3;
    if (!wwrite(wjoin(a, &.{ deploy_dir, "api", "serve.mjs" }), serve)) return false;
    for (&[_][]const u8{ "vercel.json", "test-adapter.mjs", "package.json", ".vercelignore", ".gitignore" }) |name| {
        const src = wread(a, wjoin(a, &.{ scaffold, name }));
        if (src.len > 0) _ = wwrite(wjoin(a, &.{ deploy_dir, name }), src);
    }

    // ---- 5. Carry an existing Vercel project linkage so deploy pushes to the
    //         SAME project instead of minting a new one (mirrors legacy --link).
    if (cfg.link) |link_dir| {
        const link_abs = if (S.fs.path.isAbsolute(link_dir))
            a.dupe(u8, link_dir) catch ""
        else
            wjoin(a, &.{ cwd_path, link_dir });
        defer a.free(link_abs);
        const proj_file = wjoin(a, &.{ link_abs, ".vercel", "project.json" });
        const proj_json = wread(a, proj_file);
        if (proj_json.len == 0) {
            S.debug.print("✗ link dir has no .vercel/project.json: {s}\n", .{link_abs});
            return false;
        }
        if (!wwrite(wjoin(a, &.{ deploy_dir, ".vercel", "project.json" }), proj_json)) return false;
        std.debug.print("  linked to Vercel project: {s}\n", .{link_abs});
    }

    var kb: u64 = 0;
    if (S.fs.cwd().statFile(wasm)) |st| kb = @max(1, st.size / 1024) else |_| {}
    if (cfg.backend != null) {
        S.debug.print("✓ staged {s} (wasm {d} KB, dynamic + shell)\n", .{ deploy_dir, kb });
    } else if (cfg.routes.len > 0) {
        S.debug.print("✓ staged {s} (wasm {d} KB, declared shell routes)\n", .{ deploy_dir, kb });
    } else {
        S.debug.print("✓ staged {s} (wasm {d} KB, static 404-on-miss)\n", .{ deploy_dir, kb });
    }
    return true;
}

// ============================================================================
// COMMAND: build — generate the reactor, compile it, stage the deploy dir.
// ============================================================================
~proc build|zig {
    const S = @import("std");
    _ = runBuild(S.heap.page_allocator, program);
}
// ============================================================================
// COMMAND: dev — serve the staged deployment locally through the real adapter.
// ============================================================================
~proc dev|zig {
    const S = @import("std");
    const cwd_path = S.process.getCwdAlloc(S.heap.page_allocator) catch return;
    defer allocator.free(cwd_path);
    const adapter = wjoin(allocator, &.{ cwd_path, "deploy", "test-adapter.mjs" });
    if (S.fs.cwd().access(adapter, .{})) |_| {
        // adapter present — serve it
    } else |_| {
        std.debug.print("✗ no staged deploy dir — run `koruc <site> build` first\n", .{});
        return;
    }
    std.debug.print("→ serving {s} on http://localhost:3200\n", .{adapter});
    _ = wrun(&.{ "node", adapter }, cwd_path);
}

// ============================================================================
// COMMAND: deploy — build, then push to Vercel.
// ============================================================================
~proc deploy|zig {
    const S = @import("std");
    if (!runBuild(S.heap.page_allocator, program)) return;
    const cwd_path = S.process.getCwdAlloc(S.heap.page_allocator) catch return;
    defer allocator.free(cwd_path);
    const deploy_dir = wjoin(allocator, &.{ cwd_path, "deploy" });
    std.debug.print("→ vercel deploy --prod\n", .{});
    _ = wrun(&.{ "vercel", "deploy", "--prod", "--yes" }, deploy_dir);
}
