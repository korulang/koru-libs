// Breath runtime — owns State slot + init/tick. Appended when the program names Breath (C3).

~import std/compiler

~std/build:requires {
    const breath_mod = b.createModule(.{
        .root_source_file = .{ .cwd_relative = "${REL_TO_ROOT}/../koru-libs/signal/models/breath.zig" },
        .target = target,
        .optimize = optimize,
    });
    exe.root_module.addImport("signal_breath", breath_mod);
    exe.linkLibC();
}

~std/compiler:requires {
    const breath_mod = b.createModule(.{
        .root_source_file = .{ .cwd_relative = "${REL_TO_ROOT}/../koru-libs/signal/models/breath.zig" },
        .target = target,
        .optimize = optimize,
    });
    exe.root_module.addImport("signal_breath", breath_mod);
    exe.linkLibC();
}

const std = @import("std");
const breath = @import("signal_breath");

var slot: breath.State = .{};
var inited: bool = false;

~pub tor init {}
| ok
| err string

~proc init|zig {
    if (!inited) {
        _ = breath.init(&slot);
        inited = true;
    }
    return .{ .ok = .{} };
}

~pub tor tick { pass_rate: f64 }
| out { alarm: f64, dip_ticks: f64 }
| err string

~proc tick|zig {
    if (!inited) return .{ .err = "koru/signal:tick — koru/signal:init(Breath) required before tick" };
    slot.pass_rate = pass_rate;
    _ = breath.block(&slot);
    return .{ .out = .{ .alarm = slot.alarm, .dip_ticks = slot.dip_ticks } };
}
