// probe_oshun_bufsize — `bufsize="16k"` on an element sizes the scratch
// its own mixed values format into. The tx value here produces ~5000
// bytes — over the 4096 default — so the row exists only because the
// element's declared size carried through to the emitted ln.impl.
import std/store
import std/io
import std/fmt
import std/string
import oshun

[tree]std/store:new(spec, capacity: 64) {
    d: i64, kind: char[8], tx: char[5100], ord: i64, hid: i64,
}

oshun:component(seed, spec) {
    <panel>
        <text tx="bulk: {{ s:s }}" bufsize="16k"/>
    </panel>
}

seed(s: "")
|> std/store:preorder(spec, order: "ord")
    ! preorder { [row]e, [id]h } |> std/io:print.ln("row {{ e.ord:d }} {{ e.tx:s }} hid{{ e.hid:d }}")
