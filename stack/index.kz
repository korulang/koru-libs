// @korulang/stack — declarative service stacks for Koru
//
// A program declares its services once; `koruc app.kz stack manifest`
// materializes the graph into docker-compose YAML. The graph is compile-time
// data — cycles and dangling depends_on edges are refusals, not runtime
// surprises.
//
// DECLARATION:
//   import koru/stack
//
//   koru/stack:service(db) {
//       "image": "postgres:16",
//       "healthcheck": "pg_isready -U shop",
//       "env": { "POSTGRES_DB": "shop" }
//   }
//
//   [depends_on("db")]koru/stack:service(web) {
//       "image": "web:latest",
//       "port": "web_port"
//   }
//
//   // a minimal service is name + body:
//   koru/stack:service(cache) {
//       "image": "redis:7"
//   }
//
// EDGES: [depends_on("a", "b")] annotations on the service declaration —
// the same convention std/build:step uses. A dep that declares a
// healthcheck emits `condition: service_healthy`; without one it emits
// `service_started`.
//
// FLAG-ERASED VALUES: every string field is resolved through build:config
// first — a value that names a config key substitutes, anything else is
// literal. [build("x")] annotations gate whole declarations, so the graph's
// shape and its values both vary per --build flag and resolve before the
// manifest exists.
//
// COMMANDS:
//   koruc app.kz stack manifest   — emit compose.yaml (today)
//   koruc app.kz stack up|down    — pending (imperative materialization)

~import std/build
~import std/deps
~import std/compiler

// System dependency: Docker CLI must be installed
~std/deps:requires.system {
    "name": "docker",
    "check": "docker --version",
    "ready": "docker info",
    "brew": "docker",
    "apt": "docker.io",
    "dnf": "docker",
    "pacman": "docker",
    "apk": "docker"
}

~std/compiler:command.declare {
    "name": "stack",
    "description": "Materialize the declared service stack (manifest today; up/down pending)"
}

~[comptime|command]pub tor stack {
    program: *const Program,
    allocator: __koru_std.mem.Allocator,
    argv: []string,
}

const std = @import("std");

~proc stack|zig {
    const ann_parser = @import("annotation_parser");
    const emitter_helpers = @import("emitter_helpers");
    const RootEnv = @import("root").CompilerEnv;

    var subcommand: []const u8 = "manifest";
    if (argv.len > 0) subcommand = argv[0];

    if (!std.mem.eql(u8, subcommand, "manifest")) {
        if (std.mem.eql(u8, subcommand, "up") or std.mem.eql(u8, subcommand, "down")) {
            std.debug.print("stack {s}: not implemented yet — 'manifest' is the working materialization\n", .{subcommand});
            std.process.exit(1);
        }
        std.debug.print("Usage: koruc <file> stack manifest\n", .{});
        std.debug.print("       koruc <file> stack up|down (pending)\n", .{});
        std.process.exit(1);
    }

    // Inline copy of the build-flag matcher (same as koru/docker's) —
    // std/build:matchesFlags exists but cross-module import in command procs
    // has been unreliable; keep the local copy honest.
    const matchesBuildFlags = struct {
        fn check(annotations: []const []const u8) bool {
            for (annotations) |ann| {
                const maybe_call = ann_parser.parseCall(std.heap.page_allocator, ann) catch continue;
                if (maybe_call) |call| {
                    defer {
                        var mc = call;
                        mc.deinit(std.heap.page_allocator);
                    }
                    if (std.mem.eql(u8, call.name, "build")) {
                        for (call.args) |arg| {
                            var buf: [64]u8 = undefined;
                            const flag = std.fmt.bufPrint(&buf, "build={s}", .{arg}) catch continue;
                            if (RootEnv.hasFlagRuntime(flag)) return true;
                        }
                        return false;
                    }
                }
            }
            return true;
        }
    }.check;

    // ------------------------------------------------------------------
    // Declared build:config keys across ALL variants. getBuildConfig only
    // sees the active flag's registry, so a null there is ambiguous between
    // "literal" and "a key this build didn't define" — this set splits them.
    // ------------------------------------------------------------------
    var declared_config = std.StringHashMap(void).init(allocator);
    defer declared_config.deinit();

    // Service names the active --build flag gated out — kept so references
    // to them refuse as "gated out" rather than "undeclared".
    var gated_out = std.StringHashMap(void).init(allocator);
    defer gated_out.deinit();

    // The active --build flag name — selects service|X(db) variants and
    // names .env.<build>. No flag → only base declarations exist.
    const active_build: ?[]const u8 = blk: {
        for (RootEnv.flags) |f| {
            if (std.mem.startsWith(u8, f, "build=")) break :blk f["build=".len..];
        }
        break :blk null;
    };

    for (program.items) |item| {
        if (item != .flow) continue;
        const flow = item.flow;
        const mq = flow.inv().path.module_qualifier orelse continue;
        if (!std.mem.eql(u8, mq, "build") and !std.mem.endsWith(u8, mq, ".build")) continue;
        if (flow.inv().path.segments.len != 1) continue;
        if (!std.mem.eql(u8, flow.inv().path.segments[0], "config")) continue;
        for (flow.inv().args) |arg| {
            if (!std.mem.eql(u8, arg.name, "source")) continue;
            const wrapped = std.fmt.allocPrint(allocator, "{{{s}}}", .{arg.value}) catch return;
            defer allocator.free(wrapped);
            const parsed = std.json.parseFromSlice(std.json.Value, allocator, wrapped, .{}) catch continue;
            defer parsed.deinit();
            if (parsed.value != .object) continue;
            var kit = parsed.value.object.iterator();
            while (kit.next()) |entry| {
                declared_config.put(std.heap.page_allocator.dupe(u8, entry.key_ptr.*) catch return, {}) catch return;
            }
        }
    }

    // Resolve a string field through build:config — a value that names a
    // config key substitutes the flag-gated value; anything else is literal.
    // Naming a declared key the active build didn't define is a refusal, not
    // a passthrough — a literal "api_port" in the manifest ships as garbage.
    // The result is duped into page_allocator: Source-body strings die with
    // the parsed JSON tree, but the service list must outlive each parse.
    const resolve = struct {
        fn call(v: []const u8, declared: *const std.StringHashMap(void)) []const u8 {
            if (emitter_helpers.getBuildConfig(v)) |r| {
                return std.heap.page_allocator.dupe(u8, r) catch @panic("oom");
            }
            if (declared.contains(v)) {
                std.debug.print("stack: field value '{s}' names a build:config key the active build doesn't define — pass --build or declare it\n", .{v});
                std.process.exit(1);
            }
            return std.heap.page_allocator.dupe(u8, v) catch @panic("oom");
        }
    }.call;

    const dupe = struct {
        fn call(v: []const u8) []const u8 {
            return std.heap.page_allocator.dupe(u8, v) catch @panic("oom");
        }
    }.call;

    const EnvPair = struct { key: []const u8, value: []const u8 };
    const Service = struct {
        name: []const u8,
        image: []const u8,
        healthcheck: ?[]const u8 = null,
        ports: std.ArrayListUnmanaged([]const u8) = .{},
        env: std.ArrayListUnmanaged(EnvPair) = .{},
        deps: std.ArrayListUnmanaged([]const u8) = .{},
    };

    const Decl = struct { variant: ?[]const u8, svc: Service };
    var decls = std.ArrayListUnmanaged(Decl){};
    defer decls.deinit(allocator);

    var services = std.ArrayListUnmanaged(Service){};
    defer {
        for (services.items) |*s| {
            s.ports.deinit(allocator);
            s.env.deinit(allocator);
            s.deps.deinit(allocator);
        }
        services.deinit(allocator);
    }

    const stripQuotes = struct {
        fn call(v: []const u8) []const u8 {
            if (v.len >= 2 and v[0] == '"' and v[v.len - 1] == '"') {
                return v[1 .. v.len - 1];
            }
            return v;
        }
    }.call;

    // ------------------------------------------------------------------
    // Collect service declarations from the AST
    // ------------------------------------------------------------------
    for (program.items) |item| {
        if (item != .flow) continue;
        const flow = item.flow;
        const mq = flow.inv().path.module_qualifier orelse continue;
        const is_stack_module = std.mem.eql(u8, mq, "stack") or
            std.mem.endsWith(u8, mq, ".stack");
        if (!is_stack_module) continue;
        if (flow.inv().path.segments.len != 1) continue;
        if (!std.mem.eql(u8, flow.inv().path.segments[0], "service")) continue;
        // Annotations attach at TWO points depending on spelling: .k
        // head-declarations land them on flow.annotations, .kz invocations
        // on flow.inv().annotations. Gate on the union — but remember the
        // gated-out name so a {{ name.x }} reference can say WHY it's absent.
        if (!matchesBuildFlags(flow.annotations) or !matchesBuildFlags(flow.inv().annotations)) {
            for (flow.inv().args) |arg| {
                if (arg.name.len == 0 or std.mem.eql(u8, arg.name, "expr")) {
                    gated_out.put(dupe(stripQuotes(arg.value)), {}) catch return;
                }
            }
            continue;
        }

        var svc = Service{ .name = "", .image = "" };
        for (flow.inv().args) |arg| {
            if (arg.name.len == 0 or std.mem.eql(u8, arg.name, "expr")) {
                // Positional first arg is the name — the store:new(rows)
                // convention. Bare ident or quoted string both land here.
                if (svc.name.len != 0) {
                    std.debug.print("stack: service has two positional args — name goes first: service(web, image: …)\n", .{});
                    std.process.exit(1);
                }
                svc.name = stripQuotes(arg.value);
            } else if (std.mem.eql(u8, arg.name, "name")) {
                std.debug.print("stack: 'name:' is positional — spell it service({s}, …)\n", .{arg.value});
                std.process.exit(1);
            } else if (std.mem.eql(u8, arg.name, "image")) {
                std.debug.print("stack: 'image:' is a body field — spell it {{ \"image\": {s} }}\n", .{arg.value});
                std.process.exit(1);
            } else if (std.mem.eql(u8, arg.name, "source")) {
                // Body fields are JSON-ish: wrap the Source text in braces
                // and let std.json own the grammar.
                const wrapped = std.fmt.allocPrint(allocator, "{{{s}}}", .{arg.value}) catch {
                    std.debug.print("stack: out of memory\n", .{});
                    return;
                };
                defer allocator.free(wrapped);
                const parsed = std.json.parseFromSlice(std.json.Value, allocator, wrapped, .{}) catch {
                    std.debug.print("stack: service '{s}' body is not valid JSON fields\n", .{svc.name});
                    std.process.exit(1);
                };
                defer parsed.deinit();
                if (parsed.value != .object) continue;
                var it = parsed.value.object.iterator();
                while (it.next()) |entry| {
                    const key = entry.key_ptr.*;
                    const val = entry.value_ptr.*;
                    if (std.mem.eql(u8, key, "image")) {
                        if (val == .string) svc.image = dupe(val.string);
                    } else if (std.mem.eql(u8, key, "healthcheck")) {
                        if (val == .string) svc.healthcheck = dupe(val.string);
                    } else if (std.mem.eql(u8, key, "port")) {
                        if (val == .string) {
                            svc.ports.append(allocator, dupe(val.string)) catch return;
                        }
                    } else if (std.mem.eql(u8, key, "ports")) {
                        if (val == .array) {
                            for (val.array.items) |p| {
                                if (p == .string) {
                                    svc.ports.append(allocator, dupe(p.string)) catch return;
                                }
                            }
                        }
                    } else if (std.mem.eql(u8, key, "env")) {
                        if (val == .object) {
                            var eit = val.object.iterator();
                            while (eit.next()) |e| {
                                if (e.value_ptr.* == .string) {
                                    svc.env.append(allocator, .{
                                        .key = std.heap.page_allocator.dupe(u8, e.key_ptr.*) catch @panic("oom"),
                                        .value = dupe(e.value_ptr.*.string),
                                    }) catch return;
                                }
                            }
                        }
                    }
                }
            }
        }

        if (svc.name.len == 0) {
            std.debug.print("stack: a service declaration is missing its name — service(web) {{ \"image\": … }}\n", .{});
            std.process.exit(1);
        }
        if (svc.image.len == 0) {
            std.debug.print("stack: service '{s}' declares no \"image\" — the spec lives in the body\n", .{svc.name});
            std.process.exit(1);
        }

        // depends_on edges ride the declaration's annotations — again on
        // either attachment point, deduped.
        const ann_sets = [_][]const []const u8{ flow.annotations, flow.inv().annotations };
        for (ann_sets) |anns| {
            if (ann_parser.getCall(std.heap.page_allocator, anns, "depends_on") catch null) |call| {
                var mc = call;
                defer mc.deinit(std.heap.page_allocator);
                for (call.args) |dep| {
                    var seen = false;
                    for (svc.deps.items) |d| {
                        if (std.mem.eql(u8, d, dep)) seen = true;
                    }
                    if (!seen) {
                        svc.deps.append(allocator, std.heap.page_allocator.dupe(u8, dep) catch return) catch return;
                    }
                }
            }
        }

        decls.append(allocator, .{ .variant = flow.inv().variant, .svc = svc }) catch return;
    }

    // ------------------------------------------------------------------
    // Variant selection — service(db)|dev redefines the db slot under
    // --build=dev; the unmarked decl is the base for every other build.
    // Two decls sharing (name, variant) refuse. A name whose decls all
    // miss the active build is absent this build — refs to it refuse as
    // gated-out.
    // ------------------------------------------------------------------
    for (decls.items, 0..) |d, i| {
        for (decls.items[i + 1 ..]) |o| {
            const same_variant = (d.variant == null and o.variant == null) or
                (d.variant != null and o.variant != null and std.mem.eql(u8, d.variant.?, o.variant.?));
            if (std.mem.eql(u8, d.svc.name, o.svc.name) and same_variant) {
                std.debug.print("stack: '{s}' declared twice for the same variant\n", .{d.svc.name});
                std.process.exit(1);
            }
        }
    }
    for (decls.items) |*d| {
        const for_active = if (d.variant) |v|
            if (active_build) |b| std.mem.eql(u8, v, b) else false
        else
            true;
        if (!for_active) continue;
        // A variant decl of the same name beats the base under its build.
        if (d.variant == null and active_build != null) {
            var beaten = false;
            for (decls.items) |*o| {
                if (o.variant != null and std.mem.eql(u8, o.variant.?, active_build.?) and
                    std.mem.eql(u8, o.svc.name, d.svc.name)) beaten = true;
            }
            if (beaten) continue;
        }
        services.append(allocator, d.svc) catch return;
    }
    for (decls.items) |*d| {
        var found = false;
        for (services.items) |s| {
            if (std.mem.eql(u8, s.name, d.svc.name)) found = true;
        }
        if (!found) gated_out.put(d.svc.name, {}) catch return;
    }

    if (services.items.len == 0) {
        std.debug.print("stack: no services declared.\n", .{});
        std.debug.print("Use: koru/stack:service(db) {{ \"image\": \"postgres:16\" }}\n", .{});
        std.process.exit(1);
    }

    // `env`/`config` are interpolation roots — a service wearing those names
    // would shadow them in every sibling's fields.
    for (services.items) |s| {
        if (std.mem.eql(u8, s.name, "env") or std.mem.eql(u8, s.name, "config")) {
            std.debug.print("stack: service name '{s}' shadows an interpolation root — rename it\n", .{s.name});
            std.process.exit(1);
        }
    }

    // ------------------------------------------------------------------
    // Interpolation — Koru's Liquid spellings, three roots, strict misses:
    //   {{ env.X }}    .env, then .env.<build>, then process env (last wins)
    //   {{ config.X }} build:config for the active --build flag
    //   {{ svc.f }}    another declared service — the reference IS the edge
    //   {{ "X" | env_late }}  emits ${X} verbatim for compose at up-time
    // Two phases: A resolves env/config/bare names; B resolves {{ svc.f }}
    // against phase-A'd fields and unions each reference into depends_on.
    // {% %} logic tags are refused — service bodies substitute only.
    // ------------------------------------------------------------------
    var env_map = std.StringHashMap([]const u8).init(allocator);
    defer env_map.deinit();

    const loadEnvFile = struct {
        fn call(map: *std.StringHashMap([]const u8), path: []const u8) void {
            const text = std.fs.cwd().readFileAlloc(std.heap.page_allocator, path, 1 << 20) catch return;
            var lines = std.mem.splitScalar(u8, text, '\n');
            while (lines.next()) |line| {
                const t = std.mem.trim(u8, line, " \t\r");
                if (t.len == 0 or t[0] == '#') continue;
                const body = if (std.mem.startsWith(u8, t, "export ")) t[7..] else t;
                const eq = std.mem.indexOfScalar(u8, body, '=') orelse continue;
                const key = std.mem.trim(u8, body[0..eq], " \t");
                if (key.len == 0) continue;
                var v = std.mem.trim(u8, body[eq + 1 ..], " \t");
                if (v.len >= 2 and
                    ((v[0] == '"' and v[v.len - 1] == '"') or
                        (v[0] == '\'' and v[v.len - 1] == '\''))) v = v[1 .. v.len - 1];
                map.put(key, v) catch return;
            }
        }
    }.call;

    loadEnvFile(&env_map, ".env");
    if (active_build) |b| {
        const p = std.fmt.allocPrint(std.heap.page_allocator, ".env.{s}", .{b}) catch return;
        loadEnvFile(&env_map, p);
    }
    for (std.os.environ) |e| {
        const s = std.mem.span(e);
        const eq = std.mem.indexOfScalar(u8, s, '=') orelse continue;
        env_map.put(s[0..eq], s[eq + 1 ..]) catch return;
    }

    const Phase = enum { a, b };
    const Interp = struct {
        alloc: std.mem.Allocator,
        env_map: *const std.StringHashMap([]const u8),
        declared: *const std.StringHashMap(void),
        gated: *const std.StringHashMap(void),
        svcs: []const Service,

        fn find(svcs: []const Service, name: []const u8) ?usize {
            for (svcs, 0..) |s, i| {
                if (std.mem.eql(u8, s.name, name)) return i;
            }
            return null;
        }

        // {{ svc.field }} — the exposed surface: name/host (the compose DNS
        // name), port (container side of the first mapping), host_port (the
        // published side), image. `port` reads the CONTAINER port — that is
        // what a compose-network peer dials.
        fn serviceField(svc: *const Service, field: []const u8) ?[]const u8 {
            if (std.mem.eql(u8, field, "name") or std.mem.eql(u8, field, "host")) return svc.name;
            if (std.mem.eql(u8, field, "image")) return svc.image;
            if (std.mem.eql(u8, field, "port")) {
                if (svc.ports.items.len == 0) return null;
                const p = svc.ports.items[0];
                return if (std.mem.lastIndexOfScalar(u8, p, ':')) |c| p[c + 1 ..] else p;
            }
            if (std.mem.eql(u8, field, "host_port")) {
                if (svc.ports.items.len == 0) return null;
                const p = svc.ports.items[0];
                return if (std.mem.lastIndexOfScalar(u8, p, ':')) |c| p[0..c] else null;
            }
            return null;
        }

        fn addDep(alloc: std.mem.Allocator, owner: *Service, dep: []const u8) void {
            for (owner.deps.items) |d| {
                if (std.mem.eql(u8, d, dep)) return;
            }
            owner.deps.append(alloc, dupe(dep)) catch @panic("oom");
        }

        // Classify a {{ }} head: is its root an ACTIVE or gated-out service
        // name? Phase A leaves those tokens for phase B.
        fn isServiceRef(self: *const @This(), head: []const u8) bool {
            const dot = std.mem.indexOfScalar(u8, head, '.') orelse return false;
            const root = head[0..dot];
            return find(self.svcs, root) != null or self.gated.contains(root);
        }

        // Resolve one {{ expr }} to text. Every miss is a named refusal —
        // the render never emits an empty string for a bad reference.
        fn exprText(self: *const @This(), owner: *Service, expr: []const u8) []const u8 {
            var head = expr;
            var late = false;
            if (std.mem.indexOfScalar(u8, expr, '|')) |p| {
                head = std.mem.trim(u8, expr[0..p], " \t");
                const f = std.mem.trim(u8, expr[p + 1 ..], " \t");
                if (std.mem.eql(u8, f, "env_late")) {
                    late = true;
                } else {
                    std.debug.print("stack: '{s}' — unknown filter '{s}' (known: env_late)\n", .{ owner.name, f });
                    std.process.exit(1);
                }
            }
            const h = std.mem.trim(u8, head, " \t");
            if (h.len == 0) {
                std.debug.print("stack: '{s}' — empty interpolation '{{{{ }}}}'\n", .{owner.name});
                std.process.exit(1);
            }

            var value: []const u8 = undefined;
            if (h.len >= 2 and h[0] == '"' and h[h.len - 1] == '"') {
                value = h[1 .. h.len - 1];
            } else if (std.mem.indexOfScalar(u8, h, '.')) |dot| {
                const root = h[0..dot];
                const key = h[dot + 1 ..];
                if (std.mem.eql(u8, root, "env")) {
                    value = self.env_map.get(key) orelse {
                        std.debug.print("stack: '{s}' references unset env '{s}'\n", .{ owner.name, key });
                        std.process.exit(1);
                    };
                } else if (std.mem.eql(u8, root, "config")) {
                    value = emitter_helpers.getBuildConfig(key) orelse {
                        if (self.declared.contains(key)) {
                            std.debug.print("stack: '{s}' references config key '{s}' the active build doesn't define\n", .{ owner.name, key });
                        } else {
                            std.debug.print("stack: '{s}' references undeclared config key '{s}'\n", .{ owner.name, key });
                        }
                        std.process.exit(1);
                    };
                } else if (find(self.svcs, root)) |ti| {
                    if (std.mem.eql(u8, self.svcs[ti].name, owner.name)) {
                        std.debug.print("stack: '{s}' references itself\n", .{owner.name});
                        std.process.exit(1);
                    }
                    value = serviceField(&self.svcs[ti], key) orelse {
                        std.debug.print("stack: '{s}' references '{s}.{s}' — known fields: name, host, port, host_port, image\n", .{ owner.name, root, key });
                        std.process.exit(1);
                    };
                    addDep(self.alloc, owner, self.svcs[ti].name);
                } else if (self.gated.contains(root)) {
                    std.debug.print("stack: '{s}' references service '{s}', which the active build gates out\n", .{ owner.name, root });
                    std.process.exit(1);
                } else {
                    std.debug.print("stack: '{s}' has unresolved reference '{s}' — no such root or service\n", .{ owner.name, h });
                    std.process.exit(1);
                }
            } else {
                // Bare name: env map, then active config, then refuse.
                if (self.env_map.get(h)) |v| {
                    value = v;
                } else if (emitter_helpers.getBuildConfig(h)) |v| {
                    value = v;
                } else if (self.declared.contains(h)) {
                    std.debug.print("stack: '{s}' references config key '{s}' the active build doesn't define\n", .{ owner.name, h });
                    std.process.exit(1);
                } else {
                    std.debug.print("stack: '{s}' has unresolved name '{s}' — not in env or config\n", .{ owner.name, h });
                    std.process.exit(1);
                }
            }
            if (!late) return value;
            return std.fmt.allocPrint(std.heap.page_allocator, "${{{s}}}", .{value}) catch @panic("oom");
        }

        fn render(self: *const @This(), owner: *Service, raw: []const u8, phase: Phase) []const u8 {
            if (std.mem.indexOf(u8, raw, "{%") != null) {
                std.debug.print("stack: '{s}' uses {{%% %%}} logic tags — service bodies substitute values only\n", .{owner.name});
                std.process.exit(1);
            }
            var out = std.ArrayListUnmanaged(u8){};
            var pos: usize = 0;
            while (std.mem.indexOfPos(u8, raw, pos, "{{")) |t| {
                const end = std.mem.indexOfPos(u8, raw, t + 2, "}}") orelse {
                    std.debug.print("stack: '{s}' has an unterminated '{{{{'\n", .{owner.name});
                    std.process.exit(1);
                };
                const expr = std.mem.trim(u8, raw[t + 2 .. end], " \t");
                var head = expr;
                if (std.mem.indexOfScalar(u8, expr, '|')) |p| head = std.mem.trim(u8, expr[0..p], " \t");
                out.appendSlice(std.heap.page_allocator, raw[pos..t]) catch @panic("oom");
                if (phase == .a and self.isServiceRef(std.mem.trim(u8, head, " \t"))) {
                    out.appendSlice(std.heap.page_allocator, raw[t .. end + 2]) catch @panic("oom");
                } else {
                    out.appendSlice(std.heap.page_allocator, self.exprText(owner, expr)) catch @panic("oom");
                }
                pos = end + 2;
            }
            out.appendSlice(std.heap.page_allocator, raw[pos..]) catch @panic("oom");
            return out.items;
        }
    };

    var interp = Interp{
        .alloc = allocator,
        .env_map = &env_map,
        .declared = &declared_config,
        .gated = &gated_out,
        .svcs = services.items,
    };

    // Phase A: env/config/bare-name substitution on every field of every
    // service — service records read phase-A'd fields in phase B.
    for (services.items) |*s| {
        s.image = interp.render(s, s.image, .a);
        if (s.healthcheck) |*h| h.* = interp.render(s, h.*, .a);
        for (s.ports.items) |*p| p.* = interp.render(s, p.*, .a);
        for (s.env.items) |*e| e.value = interp.render(s, e.value, .a);
    }
    // Phase B: service references resolve; each {{ svc.f }} unions an edge
    // into the owner's depends_on.
    for (services.items) |*s| {
        s.image = interp.render(s, s.image, .b);
        if (s.healthcheck) |*h| h.* = interp.render(s, h.*, .b);
        for (s.ports.items) |*p| p.* = interp.render(s, p.*, .b);
        for (s.env.items) |*e| e.value = interp.render(s, e.value, .b);
    }
    // Legacy whole-string config names ("port": "api_port") still resolve.
    for (services.items) |*s| {
        s.image = resolve(s.image, &declared_config);
        if (s.healthcheck) |*h| h.* = resolve(h.*, &declared_config);
        for (s.ports.items) |*p| p.* = resolve(p.*, &declared_config);
        for (s.env.items) |*e| e.value = resolve(e.value, &declared_config);
    }

    // ------------------------------------------------------------------
    // Validate the graph: dangling refs and cycles are refusals
    // ------------------------------------------------------------------
    const findService = struct {
        fn call(svcs: []const Service, name: []const u8) ?usize {
            for (svcs, 0..) |s, i| {
                if (std.mem.eql(u8, s.name, name)) return i;
            }
            return null;
        }
    }.call;

    for (services.items) |*s| {
        for (s.deps.items) |dep| {
            if (findService(services.items, dep) == null) {
                std.debug.print("stack: '{s}' depends_on '{s}', but no service named '{s}' is declared\n", .{ s.name, dep, dep });
                std.process.exit(1);
            }
        }
    }

    // Kahn's algorithm over deps (service -> its dependencies). A service
    // emits once every dep it names has emitted; leftovers mean a cycle.
    const n = services.items.len;
    var remaining = allocator.alloc(usize, n) catch return;
    defer allocator.free(remaining);
    var emitted = allocator.alloc(bool, n) catch return;
    defer allocator.free(emitted);
    var order = std.ArrayListUnmanaged(usize){};
    defer order.deinit(allocator);

    for (services.items, 0..) |s, i| {
        remaining[i] = s.deps.items.len;
        emitted[i] = false;
    }

    while (order.items.len < n) {
        var progressed = false;
        for (services.items, 0..) |s, i| {
            if (emitted[i] or remaining[i] != 0) continue;
            emitted[i] = true;
            progressed = true;
            order.append(allocator, i) catch return;
            // Every service depending on s just lost a blocker
            for (services.items, 0..) |other, j| {
                if (emitted[j]) continue;
                for (other.deps.items) |dep| {
                    if (std.mem.eql(u8, dep, s.name)) {
                        remaining[j] -= 1;
                        break;
                    }
                }
            }
        }
        if (!progressed) {
            std.debug.print("stack: depends_on cycle involving:", .{});
            for (services.items, 0..) |s, i| {
                if (!emitted[i]) std.debug.print(" {s}", .{s.name});
            }
            std.debug.print("\n", .{});
            std.process.exit(1);
        }
    }

    // ------------------------------------------------------------------
    // Emit compose.yaml
    // ------------------------------------------------------------------
    var out = std.ArrayListUnmanaged(u8){};
    defer out.deinit(allocator);
    const w = out.writer(allocator);

    w.writeAll("# generated by koru/stack — do not edit\n") catch return;
    w.writeAll("services:\n") catch return;

    for (order.items) |i| {
        const s = services.items[i];
        w.print("  {s}:\n", .{s.name}) catch return;
        w.print("    image: {s}\n", .{s.image}) catch return;
        if (s.healthcheck) |hc| {
            w.writeAll("    healthcheck:\n") catch return;
            w.print("      test: [\"CMD-SHELL\", \"{s}\"]\n", .{hc}) catch return;
        }
        if (s.ports.items.len > 0) {
            w.writeAll("    ports:\n") catch return;
            for (s.ports.items) |p| {
                w.print("      - \"{s}\"\n", .{p}) catch return;
            }
        }
        if (s.env.items.len > 0) {
            w.writeAll("    environment:\n") catch return;
            for (s.env.items) |e| {
                w.print("      {s}: {s}\n", .{ e.key, e.value }) catch return;
            }
        }
        if (s.deps.items.len > 0) {
            w.writeAll("    depends_on:\n") catch return;
            for (s.deps.items) |dep| {
                const di = findService(services.items, dep).?;
                const cond = if (services.items[di].healthcheck != null)
                    "service_healthy"
                else
                    "service_started";
                w.print("      {s}:\n        condition: {s}\n", .{ dep, cond }) catch return;
            }
        }
    }

    const file = std.fs.cwd().createFile("compose.yaml", .{}) catch |err| {
        std.debug.print("stack: cannot write compose.yaml: {}\n", .{err});
        return;
    };
    defer file.close();
    file.writeAll(out.items) catch |err| {
        std.debug.print("stack: write failed: {}\n", .{err});
        return;
    };

    std.debug.print("stack: {d} service(s) → compose.yaml\n", .{services.items.len});
    for (order.items) |i| {
        std.debug.print("  {s}", .{services.items[i].name});
        if (services.items[i].deps.items.len > 0) {
            std.debug.print(" (waits on", .{});
            for (services.items[i].deps.items) |dep| {
                std.debug.print(" {s}", .{dep});
            }
            std.debug.print(")", .{});
        }
        std.debug.print("\n", .{});
    }
}

// ============================================================================
// Service Declaration (compile-time)
// ============================================================================
// Declare one service in the stack graph. Collected by `koruc <file> stack`.
// The optional Source body is JSON-ish fields: "healthcheck",
// "port"/"ports", "env" — a field-less service omits the block entirely.
// String values resolve through build:config first, then literal.
// Edges ride annotations: [depends_on("db")] — same convention as
// std/build:step. Flag-gate whole declarations with [build("dev")].
~[comptime|norun]pub tor service {
    expr: Expression,
    source: ?Source,
}

~proc service|zig {
    // Void event — collected during AST walking by the stack command
}
