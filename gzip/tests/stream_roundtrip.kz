~import libs/gzip
~import std/io

~pub tor stream-roundtrip { }
| decompressed string
| err string

~stream-roundtrip = libs/gzip:deflate.init(level: .best)
  |> libs/gzip:deflate.push(chunk: "The quick brown fox. ")
  |> libs/gzip:deflate.push(chunk: "The quick brown fox. ")
  |> libs/gzip:deflate.finish
  |> libs/gzip:deflate.release
  |> libs/gzip:decompress(allocator: std.heap.page_allocator)
| err e => err e
| error e => err e

~stream-roundtrip()
| decompressed orig |> std/io:print.ln(orig)
| err e |> std/io:print.ln(e)

const std = @import("std");
