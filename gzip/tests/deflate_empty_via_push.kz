~import libs/gzip
~import std/io

~pub tor empty-via-push { }
| decompressed string
| err string

~empty-via-push = libs/gzip:deflate.init(level: .fast)
  |> libs/gzip:deflate.push(chunk: "")
  |> libs/gzip:deflate.finish
  |> libs/gzip:deflate.release
  |> libs/gzip:decompress(allocator: std.heap.page_allocator)
| err e => err e
| error e => err e

~empty-via-push()
| decompressed orig |> std/io:print.ln(orig)
| err e |> std/io:print.ln(e)

const std = @import("std");
